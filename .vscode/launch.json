{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Tog (native window)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Tog.App/bin/Debug/net10.0/tog.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Tog.App",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
        },
        {
            "name": "Tog (browser, port 5178)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Tog.App/bin/Debug/net10.0/tog.dll",
            "args": ["--browser", "--port", "5178", "--verbose"],
            "cwd": "${workspaceFolder}/src/Tog.App",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "running at (http://\\S+)",
                "uriFormat": "%s"
            },
            "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
        }
    ]
}
