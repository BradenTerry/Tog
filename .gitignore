bin/
obj/
TestResults/
.vs/
.idea/
*.user
.DS_Store

# Reviews the dashboard writes into a worktree for an agent to read. They are
# feedback rather than work, and nothing clears them up afterwards.
.agents-dashboard/

# Worktrees `claude -w` creates inside the repository.
.claude/worktrees/

# Monaco, 24 MB of minified build output that tools/vendor-monaco.sh fetches on
# the first build. It is a dependency, not source.
src/AgentsDashboard.App/wwwroot/monaco/

# The Claude ACP bridge, a Node package tools/vendor-acp.sh installs on the
# first build. It is a dependency, not source.
src/AgentsDashboard.App/acp/

# Mermaid's browser build, which tools/vendor-mermaid.sh fetches on the first
# build for the Markdown preview. A dependency, not source.
src/AgentsDashboard.App/wwwroot/mermaid/

# VS Code's TextMate tokenizer and grammars, which tools/vendor-textmate.sh
# fetches on the first build for the editor's colouring. A dependency, not source.
src/AgentsDashboard.App/wwwroot/textmate/
