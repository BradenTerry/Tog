@* A run reduced to one line: the bar, the counters, and how far along it is. *@

<div class="stack" style="gap: 6px; flex: 1;">
    <div class="inline">
        <span class="chip @ChipClass">@Fmt.RunStateName(Run.State)</span>
        @if (Run.ProjectName is { Length: > 0 } project)
        {
            <span class="mono truncate">@project</span>
        }
        else
        {
            <span class="muted">building</span>
        }
        <span class="spacer faint nums">@Fmt.Duration(Run.Elapsed)</span>
    </div>

    <div class="progress" role="progressbar"
         aria-valuemin="0" aria-valuemax="@(Run.HasTotal ? Run.Total : Run.Completed)"
         aria-valuenow="@Run.Completed"
         aria-label="Test progress">
        @if (Run.Completed > 0)
        {
            <span class="pass" style="width: @(Percent(Run.Passed))%"></span>
            <span class="fail" style="width: @(Percent(Run.Failed))%"></span>
            <span class="skip" style="width: @(Percent(Run.Skipped))%"></span>
        }
    </div>

    <div class="counters faint">
        <span class="pass"><b>@Run.Passed</b> passed</span>
        <span class="fail"><b>@Run.Failed</b> failed</span>
        @if (Run.Skipped > 0)
        {
            <span class="skip"><b>@Run.Skipped</b> skipped</span>
        }
        <span class="spacer">@Progress</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TestRun Run { get; set; } = default!;

    private string ChipClass => Run.State switch
    {
        TestRunState.Failed => "danger",
        TestRunState.Passed => "active",
        TestRunState.Running => "accent",
        _ => "",
    };

    /// <summary>
    /// A percentage needs a denominator, and until the run reports its total
    /// there is not one. Before then the bar fills against what has completed so
    /// far, and the label says a count instead of a fraction.
    /// </summary>
    private int Percent(int part)
    {
        var total = Run.HasTotal ? Run.Total : Run.Completed;
        return total == 0 ? 0 : (int)Math.Round(100.0 * part / total);
    }

    private string Progress => Run.HasTotal
        ? $"{Run.Completed} of {Run.Total}"
        : Run.Completed > 0
            ? $"{Run.Completed} so far"
            : "no results yet";
}
