@inherits WorktreeViewBase

@{
    var worktree = Worktree;
    var report = Telemetry.Get(worktree.RepoRoot);
    var runs = Tracker.RunsFor(worktree.Path);
    var mtp = report.Projects.Any(p => p.Runner == TestRunnerKind.MicrosoftTestingPlatform);
    var tests = LatestTests(runs);
    var roots = Tree(tests);
    var rows = TestExplorer.Rows(roots, IsOpen);
    var picked = PickedNodes(roots);
    var failedCount = TestExplorer.Count(tests, OutcomeFilter.Failed);
    var busy = _starting || report.Projects.Count == 0;
}

<div class="tests-bar">
    <button class="primary" @onclick="() => RunAll(mtp)" disabled="@busy">
        @(_starting ? "Starting..." : "Run all")
    </button>
    <button @onclick="() => RunFailed(mtp, tests)" disabled="@(busy || failedCount == 0)"
            title="Run every test whose latest result is a failure">
        Run failed@(failedCount > 0 ? $" ({failedCount})" : "")
    </button>
    <button @onclick="() => RunPicked(mtp, picked)" disabled="@(busy || picked.Count == 0)"
            title="Cmd or Ctrl-click to pick more rows, Shift-click to pick a range">
        Run selected@(picked.Count > 0 ? $" ({picked.Count})" : "")
    </button>
    @if (report.Projects.Count > 0)
    {
        <span class="spacer faint truncate">
            @Fmt.Count(report.Projects.Count, "test project"),
            @(mtp ? "Microsoft.Testing.Platform" : "VSTest")
        </span>
    }
</div>

@if (_startedCommand is { Length: > 0 })
{
    <div class="tests-command mono faint truncate" title="@_startedCommand">@_startedCommand</div>
}

@if (report.Projects.Count == 0)
{
    <div class="banner info">
        No .NET test projects found in this repository, so there is nothing to follow here.
    </div>
}
else if (!report.TrxAlwaysOn)
{
    <div class="banner">
        <strong>Runs an agent starts are invisible.</strong>
        <p class="muted" style="margin: 4px 0 8px;">
            Neither runner writes a report unless it is asked to, and an agent typing
            <span class="mono">dotnet test</span> will not ask. One file at the repository root fixes
            that for every test project in it.
        </p>
        <div class="inline">
            <button class="primary" @onclick="Install" disabled="@_installing">
                @(_installing ? "Writing..." : "Enable test telemetry")
            </button>
            <button class="ghost" @onclick="() => _showSnippet = !_showSnippet">
                @(_showSnippet ? "Hide" : "Show what it writes")
            </button>
        </div>
        @if (_showSnippet)
        {
            <pre class="mono scroll-x" style="margin-top: 10px; background: var(--bg); padding: 10px; border-radius: 5px; border: 1px solid var(--border-soft);">@TelemetryInstaller.Snippet</pre>
            <p class="faint" style="margin-top: 6px;">Written to <span class="mono">@report.TargetsPath</span></p>
        }
    </div>
}
else if (!mtp)
{
    <div class="banner info">
        These projects run on VSTest, which writes its report once the run ends, so results
        arrive all at once rather than filling in as they happen. The run itself still shows
        as soon as it starts.
    </div>
}

@if (_message is { Length: > 0 })
{
    <div class="banner info">@_message</div>
}

@if (runs.Count == 0)
{
    <div class="empty">
        <h2>No runs yet</h2>
        <p>A run appears here as soon as one starts, whether you started it or an agent did.</p>
    </div>
}
else
{
    var latest = runs[0];
    <article class="card">
        <div class="card-head">
            <TestSummary Run="latest" />
        </div>
        @if (latest.State == TestRunState.Running && latest.TrxPath is null)
        {
            <div class="row faint">Restoring and building. Results appear once tests begin.</div>
        }
    </article>
}

@if (tests.Count > 0)
{
    <article class="card tests-explorer">
        <div class="tests-filter">
            <input type="text" class="tests-search" placeholder="Search tests by name"
                   aria-label="Search tests by name"
                   @bind="_search" @bind:event="oninput" @bind:after="SearchChanged" />
            <div class="segmented" role="group" aria-label="Filter by outcome">
                @foreach (var option in Options)
                {
                    var count = tests.Count(t => TestExplorer.Matches(t, option, _search));
                    <button class="@(_outcome == option ? "on" : "")" aria-pressed="@(_outcome == option)"
                            @onclick="() => SetOutcome(option)">
                        @OptionName(option) <span class="nums faint">@count</span>
                    </button>
                }
            </div>
            <button class="ghost small" @onclick="() => SetAllOpen(roots, true)" title="Expand all">Expand</button>
            <button class="ghost small" @onclick="() => SetAllOpen(roots, false)" title="Collapse all">Collapse</button>
        </div>

        @if (rows.Count == 0)
        {
            <div class="row faint">No tests match@(Filtering ? " the filter" : "").</div>
        }
        else
        {
            <div class="tests-tree" role="tree" aria-multiselectable="true">
                @foreach (var row in rows)
                {
                    var node = row.Node;
                    var isPicked = _picked.Contains(node.Id);
                    var open = !node.IsLeaf && IsOpen(node);
                    <div class="tree-row test-row has-actions @(isPicked ? "picked" : "")"
                         role="treeitem" tabindex="0"
                         aria-selected="@(isPicked ? "true" : "false")"
                         aria-expanded="@(node.IsLeaf ? null : open ? "true" : "false")"
                         aria-level="@(row.Depth + 1)"
                         style="padding-left: @(6 + row.Depth * 14)px"
                         title="@node.FullName"
                         @onclick="e => Click(rows, node, e)"
                         @ondblclick="() => Toggle(node)"
                         @onkeydown="e => Key(rows, node, e)">
                        <span class="twistie" aria-hidden="true" @onclick="() => Toggle(node)" @onclick:stopPropagation="true">
                            @if (!node.IsLeaf)
                            {
                                <svg class="chevron @(open ? "open" : "")" viewBox="0 0 16 16" width="14" height="14">
                                    <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                        </span>
                        <OutcomeIcon Outcome="node.Outcome" />
                        <span class="label @(node.IsLeaf ? "" : "test-group") @(node.Kind == TestNodeKind.Case ? "mono" : "")">@node.Label</span>
                        @if (node.IsLeaf)
                        {
                            <span class="n faint test-meta">@Duration(node.Test!.Result.Duration)</span>
                        }
                        else
                        {
                            <span class="test-meta">
                                @if (node.Failed > 0)
                                {
                                    <span class="n test-failed-count">@node.Failed failed</span>
                                }
                                <span class="n faint">@node.Tests.Count</span>
                            </span>
                        }
                        <button class="ghost small scm-action test-run" title="Run @node.Label" aria-label="Run @node.Label"
                                disabled="@busy"
                                @onclick="() => RunPicked(mtp, [node])" @onclick:stopPropagation="true">
                            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                                <path d="M4.5 3v10l8-5z" fill="currentColor" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }

        @{
            var detail = picked is [{ Test: { } only }] ? only : null;
            var failures = (picked.Count > 0 ? picked.SelectMany(n => n.Tests) : roots.SelectMany(n => n.Tests))
                .Where(t => t.Outcome == TestOutcome.Failed)
                .DistinctBy(t => t.Name)
                .ToList();
        }

        @if (detail is not null)
        {
            <div class="test-detail">
                <div class="inline">
                    <OutcomeIcon Outcome="detail.Outcome" />
                    <span class="mono test-detail-name">@detail.Name</span>
                </div>
                <div class="faint test-detail-facts">
                    @OutcomeName(detail.Outcome), @Duration(detail.Result.Duration)
                    @if (detail.ProjectName is { Length: > 0 } project)
                    {
                        <span> in <span class="mono">@project</span></span>
                    }
                </div>
                <FailureText Test="detail" Agent="Agent" Worktree="Worktree" />
            </div>
        }
        else if (failures.Count > 0)
        {
            <div class="test-failures-head faint">
                @Fmt.Count(failures.Count, "failure")@(picked.Count > 0 ? " in the selection" : "")
            </div>
            @foreach (var failure in failures.Take(MaxFailuresShown))
            {
                <div class="failure">
                    <div class="failure-name">@failure.Name</div>
                    <FailureText Test="failure" Agent="Agent" Worktree="Worktree" />
                </div>
            }
            @if (failures.Count > MaxFailuresShown)
            {
                <div class="row faint">
                    And @(failures.Count - MaxFailuresShown) more. Pick a test to see its failure.
                </div>
            }
        }
    </article>
}

@if (runs.Count > 1)
{
    <details class="tests-history">
        <summary class="faint">Earlier runs (@(runs.Count - 1))</summary>
        @foreach (var run in runs.Skip(1))
        {
            <article class="card">
                <div class="card-head">
                    <TestSummary Run="run" />
                </div>
            </article>
        }
    </details>
}

@code {
    private const int MaxFailuresShown = 20;

    private static readonly OutcomeFilter[] Options =
        [OutcomeFilter.All, OutcomeFilter.Failed, OutcomeFilter.Passed, OutcomeFilter.Skipped];

    private TelemetryCache Telemetry => Context.Get<TelemetryCache>();

    private TestRunTracker Tracker => Context.Get<TestRunTracker>();

    private TestRunner Runner => Context.Get<TestRunner>();

    private bool _starting;
    private bool _installing;
    private bool _showSnippet;
    private string? _message;
    private string? _startedCommand;

    private string? _search;
    private OutcomeFilter _outcome = OutcomeFilter.All;

    /// <summary>Rows picked, by node id. Kept across renders and filter changes, dropped with the worktree.</summary>
    private readonly HashSet<string> _picked = new(StringComparer.Ordinal);

    /// <summary>Where a Shift-click range starts: the last row clicked without Shift.</summary>
    private string? _anchor;

    /// <summary>Nodes the user opened or closed, overriding <see cref="OpenByDefault"/>.</summary>
    private readonly Dictionary<string, bool> _toggled = new(StringComparer.Ordinal);

    private string? _worktreePath;

    // The layout re-renders every second, and the tree only changes when a run
    // does, so both are kept until the runs or the filter move.
    private string? _testsKey;
    private IReadOnlyList<ExplorerTest> _tests = [];
    private (IReadOnlyList<ExplorerTest> Tests, OutcomeFilter Outcome, string? Search)? _treeKey;
    private IReadOnlyList<TestNode> _roots = [];

    private bool Filtering => _outcome != OutcomeFilter.All || !string.IsNullOrWhiteSpace(_search);

    protected override void OnParametersSet()
    {
        if (_worktreePath != Worktree.Path)
        {
            _worktreePath = Worktree.Path;
            _picked.Clear();
            _toggled.Clear();
            _anchor = null;
            _startedCommand = null;
            _message = null;
        }
    }

    private IReadOnlyList<ExplorerTest> LatestTests(IReadOnlyList<TestRun> runs)
    {
        var key = string.Join('\n', runs.Select(r => $"{r.Id}|{r.Completed}|{r.State}|{r.LastUpdatedAt.Ticks}"));
        if (key != _testsKey)
        {
            _testsKey = key;
            _tests = TestExplorer.Latest(runs);
        }

        return _tests;
    }

    private IReadOnlyList<TestNode> Tree(IReadOnlyList<ExplorerTest> tests)
    {
        var key = (tests, _outcome, _search);
        if (_treeKey is not { } k || !ReferenceEquals(k.Tests, tests) || k.Outcome != _outcome || k.Search != _search)
        {
            _treeKey = key;
            _roots = TestExplorer.Build(tests, _outcome, _search);
        }

        return _roots;
    }

    /// <summary>
    /// The picked rows that are still in the tree. A row the filter hides stays
    /// picked for when it comes back, but is not run while it cannot be seen.
    /// </summary>
    private List<TestNode> PickedNodes(IReadOnlyList<TestNode> roots) =>
        _picked.Count == 0 ? [] : [.. TestExplorer.All(roots).Where(n => _picked.Contains(n.Id))];

    private bool IsOpen(TestNode node) =>
        _toggled.TryGetValue(node.Id, out var open) ? open : OpenByDefault(node);

    /// <summary>
    /// Open while filtering, so every match is in sight; otherwise open down to
    /// the classes, and into a theory only when one of its cases failed.
    /// </summary>
    private bool OpenByDefault(TestNode node) =>
        Filtering || node.Kind != TestNodeKind.Method || node.Failed > 0;

    private void Toggle(TestNode node)
    {
        if (!node.IsLeaf)
        {
            _toggled[node.Id] = !IsOpen(node);
        }
    }

    private void SetAllOpen(IReadOnlyList<TestNode> roots, bool open)
    {
        foreach (var node in TestExplorer.All(roots).Where(n => !n.IsLeaf))
        {
            _toggled[node.Id] = open;
        }
    }

    private void SetOutcome(OutcomeFilter outcome)
    {
        _outcome = outcome;
        _toggled.Clear();
    }

    private void SearchChanged() => _toggled.Clear();

    /// <summary>
    /// A plain click picks the row alone. Cmd or Ctrl adds or removes it, and
    /// Shift picks every row from the anchor to this one as they are drawn, as
    /// in the file trees. Opening and closing is the chevron or a double click,
    /// so picking a namespace does not fold it away.
    /// </summary>
    private void Click(List<TestRow> rows, TestNode node, MouseEventArgs e) =>
        Pick(rows, node, e.ShiftKey, e.MetaKey || e.CtrlKey);

    private void Pick(List<TestRow> rows, TestNode node, bool range, bool adding)
    {
        if (range && _anchor is not null)
        {
            var ids = rows.Select(r => r.Node.Id).ToList();
            var from = ids.IndexOf(_anchor);
            var to = ids.IndexOf(node.Id);
            if (from >= 0 && to >= 0)
            {
                if (!adding)
                {
                    _picked.Clear();
                }

                _picked.UnionWith(ids.GetRange(Math.Min(from, to), Math.Abs(to - from) + 1));
                return;
            }
        }

        _anchor = node.Id;
        if (adding)
        {
            if (!_picked.Remove(node.Id))
            {
                _picked.Add(node.Id);
            }

            return;
        }

        _picked.Clear();
        _picked.Add(node.Id);
    }

    private void Key(List<TestRow> rows, TestNode node, KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                Pick(rows, node, e.ShiftKey, e.MetaKey || e.CtrlKey);
                break;
            case "ArrowRight" when !node.IsLeaf && !IsOpen(node):
            case "ArrowLeft" when !node.IsLeaf && IsOpen(node):
                Toggle(node);
                break;
            case "Escape":
                _picked.Clear();
                break;
        }
    }

    private Task RunAll(bool mtp) => Start(() => Runner.Start(Worktree.Path, mtp));

    private Task RunFailed(bool mtp, IReadOnlyList<ExplorerTest> tests) =>
        RunNodes(mtp, TestExplorer.Build(tests, OutcomeFilter.Failed, null), narrowed: true);

    /// <summary>
    /// With a filter on, a picked namespace runs only the tests of it that are on
    /// screen, not everything in it: what you see is what runs.
    /// </summary>
    private Task RunPicked(bool mtp, IReadOnlyList<TestNode> nodes) => RunNodes(mtp, nodes, Filtering);

    private Task RunNodes(bool mtp, IReadOnlyList<TestNode> nodes, bool narrowed)
    {
        var report = Telemetry.Get(Worktree.RepoRoot);
        var worktreePath = Worktree.Path;

        var runs = TestExplorer.FiltersFor(nodes, narrowed)
            .Select(f => (ProjectPath: ProjectPath(report, f.ProjectName, worktreePath), f.Filter))
            .ToList();

        return runs.Count == 0
            ? Task.CompletedTask
            : Start(() => Runner.StartSequence(worktreePath, mtp, runs));
    }

    /// <summary>
    /// Where a project lives in this worktree. The probe reads the repository
    /// root, so a project found there is re-rooted onto the worktree being run.
    /// A project the reports name but the probe did not find runs from the root.
    /// </summary>
    private static string? ProjectPath(TestTelemetryReport report, string projectName, string worktreePath)
    {
        var project = report.Projects.FirstOrDefault(p => string.Equals(p.Name, projectName, StringComparison.Ordinal));
        if (project is null)
        {
            return null;
        }

        var relative = Path.GetRelativePath(report.RepoRoot, project.ProjectPath);
        return relative.StartsWith("..", StringComparison.Ordinal) || Path.IsPathRooted(relative)
            ? project.ProjectPath
            : Path.Combine(worktreePath, relative);
    }

    private async Task Start(Func<StartedTestRun> start)
    {
        _starting = true;
        _message = null;
        StateHasChanged();

        var started = await Task.Run(start);

        _starting = false;
        _startedCommand = started.Command;
        _message = started.Started
            ? null
            : $"Could not start the run. Tried: {started.Command}";
    }

    private async Task Install()
    {
        _installing = true;
        StateHasChanged();

        var repoRoot = Worktree.RepoRoot;
        var report = Telemetry.Get(repoRoot);

        try
        {
            if (TelemetryInstaller.NeedsManualEdit(report))
            {
                _message = $"{report.TargetsPath} exists but has no closing Project tag, "
                           + "so it was left alone. Add the snippet by hand.";
                _showSnippet = true;
            }
            else
            {
                var install = await Task.Run(() => TelemetryInstaller.Install(report));
                _message = install.Created
                    ? $"Wrote {install.Path}. Runs from now on will show up here."
                    : $"Added the block to {install.Path}. Runs from now on will show up here.";
            }
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            _message = $"Could not write {report.TargetsPath}: {e.Message}";
        }

        Telemetry.Invalidate(repoRoot);
        _installing = false;
    }

    private static string OptionName(OutcomeFilter option) => option switch
    {
        OutcomeFilter.Failed => "Failed",
        OutcomeFilter.Passed => "Passed",
        OutcomeFilter.Skipped => "Skipped",
        _ => "All",
    };

    private static string OutcomeName(TestOutcome outcome) => outcome switch
    {
        TestOutcome.Passed => "Passed",
        TestOutcome.Failed => "Failed",
        TestOutcome.Skipped or TestOutcome.NotExecuted => "Skipped",
        _ => "No result",
    };

    private static string Duration(TimeSpan span) =>
        span.TotalSeconds < 1 ? $"{(int)span.TotalMilliseconds} ms" : Fmt.Duration(span);
}
