<Project Sdk="Microsoft.NET.Sdk">

  <!--
    C# navigation in the editor, from Roslyn in-process: hover, go to
    definition, references, callers, and colouring by symbol. An extension
    rather than part of the app because most repositories are not C#, and
    Roslyn and MSBuild are the heaviest things the app would otherwise carry.
    Link this folder in Settings, Extensions, or pass it with extension.
  -->
  <PropertyGroup>
    <RootNamespace>AgentsDashboard.Extensions.CSharpCode</RootNamespace>
    <!-- Writes the .deps.json the app's loader resolves Roslyn from. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <OutputPath>bin/dashboard/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Roslyn's satellite resource assemblies, a dozen languages of them, are
         never read by a dashboard that only asks it for symbols. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against the API, never ship it. See the DotnetTests project. -->
    <ProjectReference Include="..\..\src\AgentsDashboard.Extensions\AgentsDashboard.Extensions.csproj"
                      Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <!-- Microsoft.CodeAnalysis.Workspaces.MSBuild drags Microsoft.Build.Framework
         in transitively. MSBuild's assemblies have to come from the SDK that
         MSBuildLocator points the process at: a local copy resolves first, the
         locator's resolver never fires, and loading a solution fails with a type
         mismatch. That is what MSBL001 guards. Compile-only and non-flowing keeps
         it out of the output. The test project repeats this. -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentsDashboard.Extensions.CSharpCode.Tests" />
  </ItemGroup>

</Project>
