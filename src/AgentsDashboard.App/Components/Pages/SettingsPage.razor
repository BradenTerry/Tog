@page "/settings"
@inherits StateComponent
@inject SettingsStore Store
@inject MonitorService Monitor
@inject AgentHost Host
@inject FolderPicker Folders

<PageTitle>Settings - Agents Dashboard</PageTitle>

<div class="page">
    <div class="page-head"><h1>Settings</h1></div>
    <p class="page-sub">
        The repositories you add here are the ones New agent offers to start in.
    </p>

    <div class="card">
        <div class="card-head"><h2>Repositories</h2></div>

        @if (_settings.RepoRoots.Count == 0)
        {
            <div class="row faint">None yet. Add one below, or pick one Claude is already running in.</div>
        }

        @foreach (var root in ByName(_settings.RepoRoots, r => State.Repo(r)?.Name ?? Fmt.Leaf(r)))
        {
            var known = State.Repo(root);
            <div class="row">
                <div class="stack" style="flex: 1; min-width: 0;">
                    <strong>@(known?.Name ?? Fmt.Leaf(root))</strong>
                    <span class="mono faint truncate">@root</span>
                </div>
                @if (known is not null)
                {
                    <span class="chip">@Fmt.Count(known.Worktrees.Count, "worktree")</span>
                }
                else if (!Directory.Exists(root))
                {
                    <span class="chip danger" title="There is no directory at this path any more">missing</span>
                }
                <button class="ghost small" @onclick="() => Remove(root)">Remove</button>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-head"><h2>Add a repository</h2></div>
        <div class="card-body">
            <div class="inline">
                @* An explicit value plus oninput rather than @@bind: two-way binding
                   will not push a value the component itself cleared back into the
                   DOM, so the field would keep the path after it was added. *@
                <input type="text" placeholder="/Users/you/code/your-repo"
                       aria-label="Repository path"
                       value="@_newRoot"
                       @oninput="e => _newRoot = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="OnAddKey" />
                @if (Folders.Available)
                {
                    <button class="primary" @onclick="Browse" disabled="@_picking">Choose folder...</button>
                    <button @onclick="Add" disabled="@string.IsNullOrWhiteSpace(_newRoot)">Add</button>
                }
                else
                {
                    <button class="primary" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(_newRoot)">Add</button>
                }
            </div>
            @if (_error is { Length: > 0 })
            {
                <p class="faint" style="margin: 8px 0 0; color: var(--danger);">@_error</p>
            }
        </div>
    </div>

    @if (Discovered.Count > 0)
    {
        <div class="card">
            <div class="card-head"><h2>Running elsewhere</h2></div>
            <div class="row faint">
                Claude sessions are running in these, but they are not in your list. Add one to start
                new agents in it.
            </div>
            @foreach (var repo in ByName(Discovered, r => r.Name))
            {
                <div class="row">
                    <div class="stack" style="flex: 1; min-width: 0;">
                        <strong>@repo.Name</strong>
                        <span class="mono faint truncate">@repo.Root</span>
                    </div>
                    <button class="small" @onclick="() => AddRoot(repo.Root)">Add</button>
                    <button class="ghost small" @onclick="() => Hide(repo.Root)">Hide</button>
                </div>
            }
        </div>
    }

    @if (_settings.HiddenRoots.Count > 0)
    {
        <div class="card">
            <div class="card-head"><h2>Hidden</h2></div>
            @foreach (var root in ByName(_settings.HiddenRoots, r => r))
            {
                <div class="row">
                    <span class="mono truncate" style="flex: 1;">@root</span>
                    <button class="ghost small" @onclick="() => Unhide(root)">Show again</button>
                </div>
            }
        </div>
    }

    <div class="card">
        <div class="card-head"><h2>Preferences</h2></div>

        <div class="row">
            <div class="stack" style="flex: 1;">
                <strong>Notify when an agent starts waiting</strong>
                <span class="faint">
                    One notification per time an agent blocks, never repeated while it stays there,
                    and nothing for agents that were already blocked when the app opened.
                </span>
            </div>
            <input type="checkbox" checked="@_settings.NotifyOnWaiting"
                   @onchange="e => Set(_settings with { NotifyOnWaiting = (bool)e.Value! })"
                   aria-label="Notify when an agent starts waiting" />
        </div>

        <div class="row">
            <div class="stack" style="flex: 1;">
                <strong>Default model</strong>
                <span class="faint">
                    Preselected in every start form. Left to the agent, the model your own Claude
                    settings already choose keeps applying.
                </span>
            </div>
            <select value="@_settings.DefaultModel"
                    @onchange="e => Set(_settings with { DefaultModel = Blank(e.Value) })"
                    aria-label="Default model">
                <option value="">Leave to the agent</option>
                @foreach (var model in StartChoices.For("model", Host.KnownOptions))
                {
                    <option value="@model.Value">@model.Name</option>
                }
            </select>
        </div>

        <div class="row">
            <div class="stack" style="flex: 1;">
                <strong>Default effort</strong>
                <span class="faint">How hard a new agent thinks before it answers.</span>
            </div>
            <select value="@_settings.DefaultEffort"
                    @onchange="e => Set(_settings with { DefaultEffort = Blank(e.Value) })"
                    aria-label="Default effort">
                <option value="">Leave to the agent</option>
                @foreach (var effort in StartChoices.For("effort", Host.KnownOptions))
                {
                    <option value="@effort.Value">@effort.Name</option>
                }
            </select>
        </div>

        <div class="row">
            <div class="stack" style="flex: 1;">
                <strong>Default permission mode</strong>
                <span class="faint">What a new agent may do without asking you first.</span>
            </div>
            <select value="@_settings.DefaultPermissionMode"
                    @onchange="e => Set(_settings with { DefaultPermissionMode = Blank(e.Value) })"
                    aria-label="Default permission mode">
                <option value="">Leave to the agent</option>
                @foreach (var mode in StartChoices.For("mode", Host.KnownOptions))
                {
                    <option value="@mode.Value">@mode.Name</option>
                }
            </select>
        </div>
    </div>

    <ExtensionsCard />

    @if (Monitor.LastError is { Length: > 0 } error)
    {
        <div class="banner danger">
            <strong>The last refresh failed.</strong>
            <p class="mono muted" style="margin: 5px 0 0;">@error</p>
        </div>
    }
</div>

@code {
    private Settings _settings = new();
    private string _newRoot = "";
    private string? _error;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _settings = Store.Load();
    }

    private bool _picking;

    /// <summary>
    /// Opens the system folder chooser and adds what comes back, the same as
    /// typing the path and pressing Add. Cancelling leaves the field alone.
    /// </summary>
    private async Task Browse()
    {
        _picking = true;
        try
        {
            var start = Directory.Exists(_newRoot.Trim()) ? _newRoot.Trim() : null;
            if (await Folders.PickAsync("Choose a repository", start) is { } chosen)
            {
                _newRoot = chosen;
                Add();
            }
        }
        finally
        {
            _picking = false;
        }
    }

    private void OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Add();
        }
    }

    private void Add()
    {
        var root = _newRoot.Trim();
        _error = null;

        if (root.Length == 0)
        {
            return;
        }

        if (!Directory.Exists(root))
        {
            _error = "There is no directory at that path.";
            return;
        }

        if (!Directory.Exists(Path.Combine(root, ".git")) && !File.Exists(Path.Combine(root, ".git")))
        {
            // Not fatal: discovery resolves any directory inside a repo up to its
            // root. Worth saying so rather than silently accepting nothing.
            _error = "That is not a repository root, but it will be resolved to one if it is inside a repository.";
        }

        AddRoot(root);
        _newRoot = "";
    }

    private void AddRoot(string root) => Set(_settings with
    {
        RepoRoots = [.. _settings.RepoRoots.Where(r => r != root), root],
        HiddenRoots = _settings.HiddenRoots.Where(r => r != root).ToArray(),
    });

    /// <summary>
    /// Takes a repository off the list. It is not hidden: while Claude runs in
    /// it, it still shows up under Running elsewhere.
    /// </summary>
    private void Remove(string root) =>
        Set(_settings with { RepoRoots = _settings.RepoRoots.Where(r => r != root).ToArray() });

    /// <summary>
    /// A list in name order. The settings file keeps repositories in the order they
    /// were added, which says nothing to someone looking for one.
    /// </summary>
    private static IEnumerable<T> ByName<T>(IEnumerable<T> items, Func<T, string> name) =>
        items.OrderBy(name, StringComparer.OrdinalIgnoreCase);

    /// <summary>Repositories the monitor found through live sessions that are not in the list.</summary>
    private IReadOnlyList<RepoView> Discovered =>
        Snapshot.Repos.Where(r => !_settings.RepoRoots.Contains(r.Root, StringComparer.Ordinal)).ToList();

    private void Hide(string root) => Set(_settings with
    {
        HiddenRoots = [.. _settings.HiddenRoots.Where(r => r != root), root],
        RepoRoots = _settings.RepoRoots.Where(r => r != root).ToArray(),
    });

    private void Unhide(string root) =>
        Set(_settings with { HiddenRoots = _settings.HiddenRoots.Where(r => r != root).ToArray() });

    /// <summary>
    /// A blank choice means "say nothing", which is not the same as a value: it
    /// leaves the agent's own default in place rather than pinning one here.
    /// </summary>
    private static string? Blank(object? value) =>
        value?.ToString() is { Length: > 0 } chosen ? chosen : null;

    private void Set(Settings next)
    {
        _settings = next;
        Store.Save(next);

        // The repo list is read on the monitor's slow timer. Waiting up to twenty
        // seconds to see a repository you just added would read as broken.
        Monitor.InvalidateWorktrees();
    }
}
