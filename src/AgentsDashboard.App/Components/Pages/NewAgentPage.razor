@page "/new"
@inherits StateComponent
@inject AgentDirectory Directory
@inject NavigationManager Nav

<PageTitle>New agent - Agents Dashboard</PageTitle>

<div class="page">
    <div class="page-head"><h1>New agent</h1></div>
    <p class="page-sub">
        Pick one of your repositories and whether it works in a fresh worktree or an existing one.
        Repositories are set up in <a href="settings">Settings</a>.
    </p>

    @if (_result is { Ok: false } failed)
    {
        <div class="banner danger" style="margin-bottom: 14px;">@failed.Message</div>
    }

    <div class="card">
        <div class="card-body">
            <StartAgentForm OnStarted="r => _result = r" OnStartedAgent="Open" />
        </div>
    </div>
</div>

@code {
    private CliResult? _result;

    /// <summary>
    /// Opens the agent just started.
    /// </summary>
    /// <remarks>
    /// The CLI answers with its job id, but the agent view is addressed by
    /// session id, which only the CLI's list knows. With no match yet the list
    /// is the next best place to land: the agent turns up there on its own.
    /// </remarks>
    private async Task Open(string id)
    {
        await Directory.RefreshAsync();
        var started = Directory.Targets(Snapshot.Value).FirstOrDefault(t => t.JobId == id);
        Nav.NavigateTo(started is null ? "" : Urls.Chat(started.SessionId));
    }
}
