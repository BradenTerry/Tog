@page "/new"
@inherits StateComponent
@inject NavigationManager Nav

<PageTitle>New agent - Agents Dashboard</PageTitle>

<div class="page">
    <div class="page-head"><h1>New agent</h1></div>
    <p class="page-sub">
        Pick one of your repositories and whether it works in a fresh worktree or an existing one.
        Repositories are set up in <a href="settings">Settings</a>.
    </p>

    @if (_result is { Ok: false } failed)
    {
        <div class="banner danger" style="margin-bottom: 14px;">@failed.Message</div>
    }

    <div class="card">
        <div class="card-body">
            <StartAgentForm OnStarted="r => _result = r" OnStartedAgent="Open" />
        </div>
    </div>
</div>

@code {
    private HostResult? _result;

    /// <summary>Opens the agent just started, or resumed, in the agent view.</summary>
    private void Open(string sessionId) => Nav.NavigateTo(Urls.Chat(sessionId));
}
