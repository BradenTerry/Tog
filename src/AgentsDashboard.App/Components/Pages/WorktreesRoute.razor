@page "/worktrees"
@inherits StateComponent
@inject Workbench Bench
@inject AgentDirectory Directory
@inject NavigationManager Nav

@* An address for the Worktrees tab, as /settings is for Settings: it opens the
   tab over the agent that was on screen and goes back to it. *@

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            var worktree = Bench.SessionId is { } id
                ? Directory.Targets(Snapshot.Value).FirstOrDefault(t => t.SessionId == id)?.WorktreePath
                : null;

            Bench.OpenWorktrees(worktree);
            Nav.NavigateTo(Urls.Chat(Bench.SessionId), replace: true);
        }
    }
}
