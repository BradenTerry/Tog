@page "/worktree/{Path}"
@page "/worktree/{Path}/{Tab}"
@inherits StateComponent

<PageTitle>@(View?.Worktree.Name ?? "Worktree") - Agents Dashboard</PageTitle>

<div class="page">
    @if (View is null)
    {
        <div class="empty">
            <h1>Worktree not found</h1>
            <p class="mono">@Decoded</p>
            <p>It may have been removed, or its repository is no longer being watched.</p>
            <a class="btn" href="">Back to overview</a>
        </div>
    }
    else
    {
        <div class="page-head">
            <h1>@View.Worktree.Name</h1>
            @if (View.Worktree.Branch is { Length: > 0 } branch)
            {
                <span class="chip mono">@branch</span>
            }
            else if (View.Worktree.Detached)
            {
                <span class="chip">detached</span>
            }
            @if (View.Worktree.IsPrimary)
            {
                <span class="chip">primary</span>
            }
        </div>
        <div class="page-sub mono faint truncate" title="@Decoded">@Decoded</div>

        <nav class="tabs">
            <a class="tab @Active("agents")" href="@Urls.Worktree(Decoded, "agents")">
                Agents<span class="count">@View.Agents.Count</span>
            </a>
            <a class="tab @Active("changes")" href="@Urls.Worktree(Decoded, "changes")">
                Changes
                @if (ChangeCount > 0)
                {
                    <span class="count">@ChangeCount</span>
                }
            </a>
            <a class="tab @Active("files")" href="@Urls.Worktree(Decoded, "files")">
                Files
            </a>
            <a class="tab @Active("tests")" href="@Urls.Worktree(Decoded, "tests")">
                Tests
                @if (FailingTests > 0)
                {
                    <span class="count" style="color: var(--danger);">@FailingTests</span>
                }
            </a>
        </nav>

        @switch (Current)
        {
            case "changes":
                <ChangesTab WorktreePath="@Decoded" View="View" @key="Decoded" />
                break;

            case "files":
                <FilesTab WorktreePath="@Decoded" @key="Decoded" />
                break;

            case "tests":
                <TestsTab View="View" Now="Now" @key="Decoded" />
                break;

            default:
                <AgentsTab View="View" Now="Now" />
                break;
        }
    }
</div>

@code {
    [Parameter]
    public string Path { get; set; } = "";

    [Parameter]
    public string? Tab { get; set; }

    private string Decoded => Uri.UnescapeDataString(Path);

    private string Current => Tab is "changes" or "files" or "tests" ? Tab : "agents";

    private WorktreeView? View => State.Worktree(Decoded);

    private DateTimeOffset Now => Snapshot.Value.TakenAt;

    private int ChangeCount =>
        View?.Status is { } s ? s.Changed + s.Staged + s.Untracked : 0;

    private int FailingTests => View?.LatestRun?.Failed ?? 0;

    private string Active(string tab) => Current == tab ? "active" : "";
}
