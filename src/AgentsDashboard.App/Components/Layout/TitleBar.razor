@inherits StateComponent
@inject Workbench Bench
@inject AgentDirectory Directory
@inject NavigationManager Nav

@* Across the top: who is waiting on you, and the three buttons that fold the
   panels away. Where the agent works is in the status bar along the bottom. Each button is a picture of the
   window with its panel filled in while that panel shows. *@

<header class="titlebar">
    @* A name, not a link: going to the root would drop the agent in view. *@
    <span class="brand" title="Agents Dashboard">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">Agents</span>
    </span>

    <span class="spacer"></span>

    @if (Snapshot.Waiting.Count > 0)
    {
        <span class="chip waiting" title="@Fmt.Count(Snapshot.Waiting.Count, "agent") waiting on you">@Snapshot.Waiting.Count waiting</span>
    }

    <div class="layout-toggles" role="group" aria-label="Panels">
        @LayoutButton((PanelSide.Left, "Left panel", "M2.5 3.5h4v9h-4z", "M6.5 2.5v11"))
        @LayoutButton((PanelSide.Bottom, "Bottom panel", "M2.5 9.5h11v3h-11z", "M1.5 9.5h13"))
        @LayoutButton((PanelSide.Right, "Right panel", "M9.5 3.5h4v9h-4z", "M9.5 2.5v11"))
    </div>

    <button type="button" class="icon-btn @(InFront(EditorDoc.WorktreesKey) ? "active" : "")" @onclick="() => Open(EditorDoc.WorktreesKey)"
            title="Worktrees: every worktree, what it takes on disk, and cleaning up" aria-label="Worktrees">
        <WorktreesGlyph Size="16" />
    </button>

    <button type="button" class="icon-btn @(InFront(EditorDoc.SettingsKey) ? "active" : "")" @onclick="() => Open(EditorDoc.SettingsKey)" title="Settings" aria-label="Settings">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
    </button>
</header>

@code {
    private ChatTarget? Agent =>
        Bench.SessionId is { } id ? Directory.Targets(Snapshot.Value).FirstOrDefault(t => t.SessionId == id) : null;

    private bool InFront(string key) => Bench.Editors(Agent?.WorktreePath ?? "").ActiveKey == key;

    /// <summary>
    /// Settings and Worktrees open as tabs beside the agent's files. From a page
    /// that has no editor, New agent's address for one, it goes back to the agent
    /// first.
    /// </summary>
    private void Open(string key)
    {
        if (key == EditorDoc.WorktreesKey)
        {
            Bench.OpenWorktrees(Agent?.WorktreePath);
        }
        else
        {
            Bench.OpenSettings(Agent?.WorktreePath);
        }

        var page = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        if (page.Length > 0 && !page.StartsWith("chat", StringComparison.Ordinal))
        {
            Nav.NavigateTo(Urls.Chat(Bench.SessionId));
        }
    }

    private RenderFragment LayoutButton((PanelSide Side, string Name, string Fill, string Edge) button) => __builder =>
    {
        var open = Bench.Panel(button.Side).Open;
        <button type="button" class="layout-btn @(open ? "on" : "")" @onclick="() => Bench.Toggle(button.Side)"
                title="@(open ? "Hide" : "Show") the @button.Name.ToLowerInvariant()"
                aria-label="@button.Name" aria-pressed="@(open ? "true" : "false")">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" />
                <path class="fill" d="@button.Fill" fill="currentColor" stroke="none" />
                <path d="@button.Edge" />
            </svg>
        </button>
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Bench.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Bench.Changed -= OnChanged;
            Nav.LocationChanged -= OnLocationChanged;
        }

        base.Dispose(disposing);
    }
}
