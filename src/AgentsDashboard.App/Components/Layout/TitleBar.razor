@inherits StateComponent
@inject Workbench Bench
@inject NavigationManager Nav
@inject AgentDirectory Directory

@* Across the top: the repository, worktree and branch whose files are open, a
   newer build when one is waiting, the agents counted by state, and the three
   buttons that fold the panels away. The full directory and the worktree are in
   the status bar along the bottom. Each button is a picture of the window with
   its panel filled in while that panel shows. *@

<header class="titlebar">
    @* A name, not a link: going to the root would drop the agent in view. *@
    <span class="brand" title="Agents Dashboard">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">Agents</span>
    </span>

    @* The repository and worktree whose files are open, which is the agent's
       until one is picked here. A click lists every worktree of every repo. *@
    @{
        var worktree = Bench.WorktreeInView(Snapshot.Value);
        var place = worktree is null ? null : Workbench.Find(Snapshot.Value, worktree);
        var agent = Agent;
    }
    @if (place is { } p)
    {
        var info = p.Worktree.Worktree;
        <button type="button" class="where @(Bench.Pinned ? "pinned" : "")" @onclick="OpenPicker"
                aria-haspopup="menu" aria-expanded="@(_picker is not null ? "true" : "false")"
                title="@(Bench.Pinned ? info.Path + "\nPicked by hand: stays when you switch agents." : info.Path)">
            <span class="where-item">@p.Repo.Name</span>
            @if (info.Name != p.Repo.Name)
            {
                <span class="where-sep">/</span>
                <span class="where-item">@info.Name</span>
            }
            @if (info.Branch is { Length: > 0 } branch)
            {
                <span class="where-branch mono" title="Branch">
                    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                        <path d="M5 3v10M5 13a1.5 1.5 0 1 0 0-.01M5 3a1.5 1.5 0 1 0 0 .01M11 5a1.5 1.5 0 1 0 0-.01M11 6.5c0 3-6 2-6 5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    </svg>
                    <span class="truncate">@branch</span>
                </span>
            }
            else if (info.Detached)
            {
                <span class="where-branch" title="No branch is checked out: commits made here belong to no branch">detached HEAD</span>
            }
            @if (Bench.Pinned)
            {
                <svg class="where-pin" viewBox="0 0 16 16" width="12" height="12" aria-label="Pinned">
                    <path d="M6 2h4l-.5 4 2.5 2.5v1H4v-1L6.5 6zM8 9.5V14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round" />
                </svg>
            }
            <svg class="where-caret" viewBox="0 0 16 16" width="10" height="10" aria-hidden="true">
                <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    }
    else if (Snapshot.Repos.Count > 0)
    {
        <button type="button" class="where" @onclick="OpenPicker" aria-haspopup="menu"
                title="@(agent is null ? "Open a worktree's files" : $"{agent.Cwd}\nNot a git worktree. Pick one to open its files.")">
            <span class="where-item @(agent is null ? "faint" : "")">@(agent is null ? "Open a worktree" : Path.GetFileName(agent.Cwd.TrimEnd('/')))</span>
            <svg class="where-caret" viewBox="0 0 16 16" width="10" height="10" aria-hidden="true">
                <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    }

    @if (_picker is { } at)
    {
        <ContextMenu X="at.X" Y="at.Y" OnClose="() => _picker = null">
            @if (agent is not null || Bench.Pinned)
            {
                <button type="button" class="context-item" role="menuitemradio" aria-checked="@(Bench.Pinned ? "false" : "true")"
                        @onclick="Follow">
                    <span class="context-check">@(Bench.Pinned ? "" : "\u2713")</span>
                    Follow the agent
                    <span class="faint">@(agent?.Where ?? "none picked")</span>
                </button>
            }
            @foreach (var repo in Snapshot.Repos.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
            {
                <hr class="context-sep" />
                <div class="context-label">@repo.Name</div>
                @foreach (var w in repo.Worktrees.Where(w => !w.Worktree.Prunable)
                              .OrderByDescending(w => w.Worktree.IsPrimary)
                              .ThenBy(w => w.Worktree.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var current = Bench.Pinned && w.Worktree.Path == worktree;
                    <button type="button" class="context-item" role="menuitemradio" aria-checked="@(current ? "true" : "false")"
                            title="@w.Worktree.Path" @onclick="() => Pin(w)">
                        <span class="context-check">@(current ? "\u2713" : "")</span>
                        @w.Worktree.Name
                        <span class="faint mono">@(w.Worktree.Branch ?? (w.Worktree.Detached ? "detached" : ""))</span>
                    </button>
                }
            }
        </ContextMenu>
    }

    <span class="spacer"></span>

    <UpdateButton />

    @* How many agents are in each state, the waiting ones first. A click on a
       count lists those agents, and picking one opens its conversation. Only the
       agents this app hosts are counted, since those are the ones it can open. *@
    @{
        var groups = Groups(Directory.Targets(Snapshot.Value));
    }
    @if (groups.Count > 0)
    {
        <div class="agent-counts" role="group" aria-label="Agents by state">
            @foreach (var group in groups)
            {
                var open = _counts is { } c && c.Group == group.Name;
                <button type="button" class="agent-count @(open ? "open" : "")" @onclick="e => OpenCounts(group.Name, e)"
                        title="@Fmt.Count(group.Agents.Count, "agent") @group.Name.ToLowerInvariant()"
                        aria-haspopup="menu" aria-expanded="@(open ? "true" : "false")">
                    <span class="dot @group.Dot" aria-hidden="true"></span>
                    <span class="nums">@group.Agents.Count</span>
                    <span class="agent-count-word">@group.Name.ToLowerInvariant()</span>
                </button>
            }
        </div>
    }

    @if (_counts is { } menu && groups.FirstOrDefault(g => g.Name == menu.Group) is { } shown)
    {
        <ContextMenu X="menu.X" Y="menu.Y" OnClose="() => _counts = null">
            <div class="context-label">@shown.Name</div>
            @foreach (var target in shown.Agents)
            {
                var current = target.SessionId == Bench.SessionId;
                <button type="button" class="context-item agent-count-item" role="menuitemradio" aria-checked="@(current ? "true" : "false")"
                        title="@($"{target.Label} ({target.Where}, {AgentDirectory.StateWord(target)})")" @onclick="() => GoTo(target)">
                    <span class="context-check">@(current ? "\u2713" : "")</span>
                    <span class="dot @AgentDirectory.DotClass(target.State)" aria-hidden="true"></span>
                    <span class="truncate">@target.Label</span>
                    <span class="faint">@target.Where</span>
                </button>
            }
        </ContextMenu>
    }

    <div class="layout-toggles" role="group" aria-label="Panels">
        @LayoutButton((PanelSide.Left, "Left panel", "M2.5 3.5h4v9h-4z", "M6.5 2.5v11"))
        @LayoutButton((PanelSide.Bottom, "Bottom panel", "M2.5 9.5h11v3h-11z", "M1.5 9.5h13"))
        @LayoutButton((PanelSide.Right, "Right panel", "M9.5 3.5h4v9h-4z", "M9.5 2.5v11"))
    </div>

    <button type="button" class="icon-btn @(InFront(EditorDoc.WorktreesKey) ? "active" : "")" @onclick="() => Open(EditorDoc.WorktreesKey)"
            title="Worktrees: every worktree, what it takes on disk, and cleaning up" aria-label="Worktrees">
        <WorktreesGlyph Size="16" />
    </button>

    <button type="button" class="icon-btn @(InFront(EditorDoc.SettingsKey) ? "active" : "")" @onclick="() => Open(EditorDoc.SettingsKey)" title="Settings" aria-label="Settings">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
    </button>
</header>

@code {
    private ChatTarget? Agent => Bench.Agent(Snapshot.Value);

    /// <summary>Where the worktree picker is open, under the pointer; null while it is shut.</summary>
    private (double X, double Y)? _picker;

    private void OpenPicker(MouseEventArgs e) => _picker = _picker is null ? (e.ClientX, e.ClientY) : null;

    private void Pin(WorktreeView worktree)
    {
        _picker = null;
        Bench.PinWorktree(worktree.Worktree.Path, worktree.RepoRoot);
        BackToEditor();
    }

    private void Follow()
    {
        _picker = null;
        Bench.FollowAgent();
        BackToEditor();
    }

    /// <summary>Which count's list is open, and under what point; null while it is shut.</summary>
    private (string Group, double X, double Y)? _counts;

    private sealed record AgentGroup(string Name, string Dot, IReadOnlyList<ChatTarget> Agents);

    /// <summary>
    /// The agents by state, the ones needing you first. Failed goes in with
    /// stopped: either way a message is what brings it back.
    /// </summary>
    private static List<AgentGroup> Groups(IReadOnlyList<ChatTarget> targets)
    {
        AgentGroup Group(string name, string dot, params ChatState[] states) =>
            new(name, dot, targets.Where(t => states.Contains(t.State)).ToList());

        return new[]
            {
                Group("Waiting", "waiting", ChatState.Waiting),
                Group("Working", "active", ChatState.Active),
                Group("Idle", "", ChatState.Idle),
                Group("Stopped", "stopped", ChatState.Parked, ChatState.Failed),
            }
            .Where(g => g.Agents.Count > 0)
            .ToList();
    }

    private void OpenCounts(string group, MouseEventArgs e) =>
        _counts = _counts?.Group == group ? null : (group, e.ClientX, e.ClientY);

    private void GoTo(ChatTarget target)
    {
        _counts = null;
        Nav.NavigateTo(Urls.Chat(target.SessionId));
    }

    private bool InFront(string key) => Bench.Editors(Bench.WorktreeInView(Snapshot.Value) ?? "").ActiveKey == key;

    /// <summary>
    /// Settings and Worktrees open as tabs beside the agent's files. From a page
    /// that has no editor, New agent's address for one, it goes back to the agent
    /// first.
    /// </summary>
    private void Open(string key)
    {
        if (key == EditorDoc.WorktreesKey)
        {
            Bench.OpenWorktrees(Bench.WorktreeInView(Snapshot.Value));
        }
        else
        {
            Bench.OpenSettings(Bench.WorktreeInView(Snapshot.Value));
        }

        BackToEditor();
    }

    /// <summary>From a page that has no editor, New agent's address for one, goes back to the agent's.</summary>
    private void BackToEditor()
    {
        var page = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        if (page.Length > 0 && !page.StartsWith("chat", StringComparison.Ordinal))
        {
            Nav.NavigateTo(Urls.Chat(Bench.SessionId));
        }
    }

    private RenderFragment LayoutButton((PanelSide Side, string Name, string Fill, string Edge) button) => __builder =>
    {
        var open = Bench.Panel(button.Side).Open;
        <button type="button" class="layout-btn @(open ? "on" : "")" @onclick="() => Bench.Toggle(button.Side)"
                title="@(open ? "Hide" : "Show") the @button.Name.ToLowerInvariant()"
                aria-label="@button.Name" aria-pressed="@(open ? "true" : "false")">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" />
                <path class="fill" d="@button.Fill" fill="currentColor" stroke="none" />
                <path d="@button.Edge" />
            </svg>
        </button>
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Bench.Changed += OnChanged;
        Directory.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Bench.Changed -= OnChanged;
            Directory.Changed -= OnChanged;
            Nav.LocationChanged -= OnLocationChanged;
        }

        base.Dispose(disposing);
    }
}
