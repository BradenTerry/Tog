@inherits StateComponent
@inject NavigationManager Nav
@inject AgentDirectory Directory
@inject IJSRuntime Js

@* The whole left side is the list of agents, like a messaging app's list of
   conversations: starting one at the top, settings tucked away at the bottom. *@

<nav class="sidebar @(_collapsed ? "collapsed" : "")" aria-label="Agents">
    <div class="sidebar-head">
        <a class="icon-btn only-collapsed" href="new" title="New agent" aria-label="New agent">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </a>
        <h1>Agents</h1>
        @if (Snapshot.Waiting.Count > 0)
        {
            <span class="chip waiting" title="@Fmt.Count(Snapshot.Waiting.Count, "agent") waiting on you">@Snapshot.Waiting.Count waiting</span>
        }
        <a class="btn small primary spacer @(IsAt("new") ? "active" : "")" href="new">New agent</a>
    </div>

    <div class="chat-list-items">
        @if (Targets.Count == 0)
        {
            <p class="faint chat-list-empty">
                No agents yet. Start one with New agent.
            </p>
        }

        @foreach (var target in Targets)
        {
            <a class="chat-item @(target.SessionId == Selected ? "active" : "")" href="@Urls.Chat(target.SessionId)"
               title="@(_collapsed ? $"{target.Label} ({target.Where}, {AgentDirectory.StateWord(target)})" : null)">
                <span class="dot @AgentDirectory.DotClass(target.State)" aria-hidden="true"></span>
                <span class="chat-item-body">
                    <span class="chat-item-top">
                        <span class="chat-item-name @(target.LabelIsPrompt ? "untitled" : "")"
                              title="@(target.LabelIsPrompt ? "Your prompt. The agent names the conversation when its first turn ends." : null)">@target.Label</span>
                        @* A running clock for an agent that is doing something, or
                           waiting; a fixed time for one that has stopped, since a
                           ticking clock beside it reads as though it were still going. *@
                        <span class="chat-item-time">
                            @(target.State is ChatState.Parked or ChatState.Failed
                                ? Fmt.At(target.Since, Snapshot.Value.TakenAt)
                                : Fmt.Duration(Snapshot.Value.TakenAt - target.Since))
                        </span>
                    </span>
                    <span class="chat-item-where">@target.Where</span>
                    @if (target.BackgroundCount > 0 && target.State is not (ChatState.Parked or ChatState.Failed))
                    {
                        <span class="chat-item-bg">@target.BackgroundCount running in background</span>
                    }
                    @if (target.WaitingFor is { Length: > 0 } question)
                    {
                        <span class="chat-item-snippet waiting">@AgentSession.Shorten(question, 80)</span>
                    }
                    else if (target.LastReply is { Length: > 0 } reply)
                    {
                        <span class="chat-item-snippet">@AgentSession.Shorten(reply, 80)</span>
                    }
                    else if (target.State is ChatState.Parked or ChatState.Failed)
                    {
                        <span class="chat-item-snippet">@AgentDirectory.StateWord(target)</span>
                    }
                </span>
            </a>
        }
    </div>

    <div class="sidebar-foot">
        <a class="icon-btn @(IsAt("settings") ? "active" : "")" href="settings" title="Settings" aria-label="Settings">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
        </a>
        <span class="faint">@Fmt.Count(Targets.Count, "agent")</span>
        <button class="icon-btn spacer" @onclick="Toggle"
                title="@(_collapsed ? "Expand the agent list" : "Collapse the agent list")"
                aria-label="@(_collapsed ? "Expand the agent list" : "Collapse the agent list")"
                aria-expanded="@((!_collapsed).ToString().ToLowerInvariant())">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="@(_collapsed ? "M9 6l6 6-6 6" : "M15 6l-6 6 6 6")" />
            </svg>
        </button>
    </div>

    @* Dragged in app.js: drag to resize, arrow keys to nudge, double-click to reset. *@
    <div class="sidebar-resize" role="separator" aria-orientation="vertical" aria-label="Resize the agent list"
         tabindex="0" title="Drag to resize. Double-click to reset."></div>
</nav>

@code {
    private IReadOnlyList<ChatTarget> Targets => Directory.Targets(Snapshot.Value);

    private string Relative => Nav.ToBaseRelativePath(Nav.Uri);

    /// <summary>Folded down to a strip of status dots. Remembered in the browser: it is where you like the panel, not a setting.</summary>
    private bool _collapsed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            if (await Js.InvokeAsync<string?>("agentsDashboard.getPref", "sidebar") == "collapsed")
            {
                _collapsed = true;
                StateHasChanged();
            }
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    private async Task Toggle()
    {
        _collapsed = !_collapsed;
        try
        {
            await Js.InvokeVoidAsync("agentsDashboard.setPref", "sidebar", _collapsed ? "collapsed" : "expanded");
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    /// <summary>The session the agent view is open on, read from the URL.</summary>
    private string? Selected
    {
        get
        {
            var path = Relative.Split('?', '#')[0];
            if (!path.StartsWith("chat/", StringComparison.Ordinal))
            {
                return null;
            }

            var segment = path["chat/".Length..].Split('/')[0];
            return segment.Length == 0 ? null : Uri.UnescapeDataString(segment);
        }
    }

    private bool IsAt(string page) => Relative.Split('?', '#')[0] == page;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Nav.LocationChanged += OnLocationChanged;
        Directory.Changed += OnDirectoryChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnDirectoryChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Nav.LocationChanged -= OnLocationChanged;
            Directory.Changed -= OnDirectoryChanged;
        }

        base.Dispose(disposing);
    }
}
