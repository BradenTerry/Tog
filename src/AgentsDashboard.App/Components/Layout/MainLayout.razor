@inherits LayoutComponentBase
@implements IDisposable
@inject Workbench Bench
@inject DashboardState State
@inject MonitorService Monitor
@inject IJSRuntime Js
@inject AgentsDashboard.Core.Platform.OpenRequests Requests
@inject Shortcuts Keys
@inject NavigationManager Nav

@* The window, laid out like VS Code: files on the left, source control on the
   right, the editor in the middle with the conversation under it. The agents
   are listed from the title bar. The page is what the editor
   shows: an agent's documents, or Settings. The borders between the parts are
   dragged in app.js; their sizes are CSS variables it sets on the root. *@

<ExtensionStyles />

<div class="wb-shell">
    <TitleBar />

    <div class="workbench @(Bench.Left.Open ? "" : "no-left") @(Bench.Right.Open ? "" : "no-right") @(Bench.Bottom.Open ? "" : "no-bottom")">
        <aside class="wb-side wb-left" aria-hidden="@(!Bench.Left.Open ? "true" : null)">
            <WorkbenchPanel Side="PanelSide.Left" />
        </aside>
        <div class="sash sash-v" data-sash="left" role="separator" aria-orientation="vertical"
             aria-label="Resize the left panel" tabindex="0" title="Drag to resize. Double-click to reset."></div>

        <div class="wb-center">
            <main class="main">
                @Body
            </main>
            <div class="sash sash-h" data-sash="bottom" role="separator" aria-orientation="horizontal"
                 aria-label="Resize the bottom panel" tabindex="0" title="Drag to resize. Double-click to reset."></div>
            <section class="wb-bottom" aria-hidden="@(!Bench.Bottom.Open ? "true" : null)">
                <WorkbenchPanel Side="PanelSide.Bottom" />
            </section>
        </div>

        <div class="sash sash-v" data-sash="right" role="separator" aria-orientation="vertical"
             aria-label="Resize the right panel" tabindex="0" title="Drag to resize. Double-click to reset."></div>
        <aside class="wb-side wb-right" aria-hidden="@(!Bench.Right.Open ? "true" : null)">
            <WorkbenchPanel Side="PanelSide.Right" />
        </aside>
    </div>

    <StatusBar />
</div>

<NewAgentDialog />
<QuickOpen />
<ExtensionRequestDialog />

@code {
    private const string LayoutPref = "layout";

    private IDisposable? _openRequests;
    private IDisposable? _statusWatch;
    private WorktreeChanges? _fileWatch;
    private string? _watchedPath;
    private DotNetObjectReference<MainLayout>? _self;

    protected override void OnInitialized()
    {
        Bench.Changed += OnBenchChanged;
        Bench.LayoutChanged += OnLayoutChanged;
        State.Changed += OnSnapshot;
        Keys.Changed += OnKeysChanged;

        // Opens among the tabs of whatever this window is looking at, which is
        // where the person who asked is looking too.
        _openRequests = Requests.Subscribe(r => _ = InvokeAsync(() => Bench.OpenExternal(CurrentWorktree, r.Path, r.Line)));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            if (await Js.InvokeAsync<string?>("agentsDashboard.getPref", LayoutPref) is { } saved)
            {
                Restore(saved);
            }

            _self = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("agentsDashboard.watchNavigation", _self);
            await Js.InvokeVoidAsync("agentsKeys.watch", _self, Keys.Map.ByChord());
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    /// <summary>
    /// The panels as they were left: one "side:open:tab" triple per panel. How you
    /// like the window, so it is kept per machine like the panel sizes.
    /// </summary>
    private void Restore(string saved)
    {
        foreach (var part in saved.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            var fields = part.Split(':', 3);
            if (fields.Length == 3 && Enum.TryParse<PanelSide>(fields[0], out var side))
            {
                Bench.Restore(side, fields[1] == "1", fields[2]);
            }
        }
    }

    /// <summary>The mouse's back button, with the caret line of the file on screen. The keys come through <see cref="RunCommand"/>.</summary>
    [JSInvokable]
    public void Back(int? line) => Bench.GoBack(CurrentWorktree, line);

    /// <summary>The mouse's forward button.</summary>
    [JSInvokable]
    public void Forward(int? line) => Bench.GoForward(CurrentWorktree, line);

    private string CurrentWorktree => Bench.WorktreeInView(State.Snapshot) ?? "";

    /// <summary>
    /// A keyboard shortcut, from app.js's listener, by command id. The line is
    /// the caret's in the file on screen, which going back and forward keep.
    /// </summary>
    [JSInvokable]
    public void RunCommand(string id, int? line)
    {
        switch (id)
        {
            case Commands.QuickOpen:
                Bench.ShowQuickOpen();
                break;
            case Commands.GoToLine:
                Bench.ShowQuickOpen(":");
                break;
            case Commands.NavigateBack:
                Bench.GoBack(CurrentWorktree, line);
                break;
            case Commands.NavigateForward:
                Bench.GoForward(CurrentWorktree, line);
                break;
            case Commands.ToggleLeft:
                Bench.Toggle(PanelSide.Left);
                break;
            case Commands.ToggleRight:
                Bench.Toggle(PanelSide.Right);
                break;
            case Commands.ToggleBottom:
                Bench.Toggle(PanelSide.Bottom);
                break;
            case Commands.OpenSettings:
                Bench.OpenSettings(Bench.WorktreeInView(State.Snapshot));
                BackToEditor();
                break;
            case Commands.OpenKeybindings:
                Bench.OpenSettings(Bench.WorktreeInView(State.Snapshot), "keys");
                BackToEditor();
                break;
            case Commands.SelectAgent:
                Bench.ToggleAgentPicker();
                break;
            case Commands.NewAgent:
                Bench.OpenNewAgent();
                break;
        }
    }

    /// <summary>Settings opens among the editor's tabs, so from a page with no editor it goes back to the agent's.</summary>
    private void BackToEditor()
    {
        var page = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        if (page.Length > 0 && !page.StartsWith("chat", StringComparison.Ordinal))
        {
            Nav.NavigateTo(Urls.Chat(Bench.SessionId));
        }
    }

    private void OnKeysChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            await Js.InvokeVoidAsync("agentsKeys.setBindings", Keys.Map.ByChord());
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
        }
    });

    private void OnLayoutChanged() => _ = SaveLayout();

    private async Task SaveLayout()
    {
        var value = string.Join(';', Enum.GetValues<PanelSide>().Select(side =>
        {
            var panel = Bench.Panel(side);
            return $"{side}:{(panel.Open ? "1" : "0")}:{panel.Tab}";
        }));

        try
        {
            await Js.InvokeVoidAsync("agentsDashboard.setPref", LayoutPref, value);
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    private void OnBenchChanged() => _ = InvokeAsync(() =>
    {
        WatchWorktree();
        StateHasChanged();
    });

    private void OnSnapshot() => _ = InvokeAsync(WatchWorktree);

    /// <summary>
    /// Asks the monitor to keep git status for the worktree of the agent in view,
    /// which is the only status anything shows, and watches its files so the diff
    /// and the editor follow the agent's edits. Re-checked on every snapshot
    /// because an agent's worktree is only known once it is placed.
    /// </summary>
    private void WatchWorktree()
    {
        var path = Bench.WorktreeInView(State.Snapshot);

        if (path == _watchedPath)
        {
            return;
        }

        _statusWatch?.Dispose();
        _statusWatch = path is null ? null : Monitor.Watch(path);
        _fileWatch?.Dispose();
        _fileWatch = path is null
            ? null
            : new WorktreeChanges(path, changed => _ = InvokeAsync(() => Bench.NotifyFilesChanged(path, changed)));
        _watchedPath = path;
    }

    public void Dispose()
    {
        Bench.Changed -= OnBenchChanged;
        Bench.LayoutChanged -= OnLayoutChanged;
        State.Changed -= OnSnapshot;
        Keys.Changed -= OnKeysChanged;
        _openRequests?.Dispose();
        _statusWatch?.Dispose();
        _fileWatch?.Dispose();
        _self?.Dispose();
    }
}
