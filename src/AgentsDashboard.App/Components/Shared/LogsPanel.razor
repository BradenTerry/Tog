@inject ClaudeCli Cli
@inject AgentsDashboard.Core.Platform.IClipboard Clipboard
@implements IDisposable

@* `claude logs` serves the tail of a session's terminal output, not a stream, so
   this is a panel with a refresh button rather than a live tail. Watching a
   scrollback is what `claude attach` is for, and that line is one click away. *@

<div class="stack" style="gap: 8px;">
    <div class="inline">
        <button class="ghost small" @onclick="Load" disabled="@_busy">
            @(_busy ? "Reading..." : "Refresh")
        </button>
        <button class="ghost small" @onclick="CopyAttach">
            @(_copied ? "Copied" : "Copy attach command")
        </button>
        <span class="faint spacer mono">@ClaudeCommands.AttachCommand(JobId)</span>
    </div>

    @if (_failed)
    {
        <div class="stack" style="gap: 2px;">
            <span class="faint">Logs are only available while the session is running.</span>
            <span class="faint" style="color: var(--danger);">@_output</span>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(_output))
    {
        <span class="faint">@(_busy ? "Reading..." : "Nothing in the log yet.")</span>
    }
    else
    {
        <pre class="logs">@_output</pre>
    }
</div>

@code {
    /// <summary>The short id the CLI's own commands take.</summary>
    [Parameter, EditorRequired]
    public string JobId { get; set; } = default!;

    private string _output = "";
    private bool _failed;
    private bool _busy;
    private CancellationTokenSource? _work;

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        _work?.Cancel();
        _work?.Dispose();
        _work = new CancellationTokenSource();

        _busy = true;
        _copied = false;
        StateHasChanged();

        CliResult result;
        try
        {
            result = await Cli.LogsAsync(JobId, _work.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception e) when (e is IOException or InvalidOperationException)
        {
            result = CliResult.Failed(e.Message);
        }

        _busy = false;
        _failed = !result.Ok;

        // The log is the raw stream Claude drew its screen with: cursor moves in
        // place of spaces, spinners redrawn in place, escape characters that show
        // as boxes. Replayed, it reads the way the terminal did.
        _output = TerminalReplay.Render(result.Message);
        StateHasChanged();
    }

    private bool _copied;
    private CancellationTokenSource? _copyReset;

    /// <summary>
    /// Copies the attach line and says so for a moment.
    /// </summary>
    /// <remarks>
    /// The wait is cancelled and restarted on every press, so two presses in a
    /// row do not leave the first one's timer to clear the second one's label.
    /// </remarks>
    private async Task CopyAttach()
    {
        _copied = Clipboard.TryCopy(ClaudeCommands.AttachCommand(JobId));
        StateHasChanged();

        if (!_copied)
        {
            return;
        }

        _copyReset?.Cancel();
        _copyReset?.Dispose();
        _copyReset = new CancellationTokenSource();
        var token = _copyReset.Token;

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2), token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _copied = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _work?.Cancel();
        _work?.Dispose();
        _copyReset?.Cancel();
        _copyReset?.Dispose();
    }
}
