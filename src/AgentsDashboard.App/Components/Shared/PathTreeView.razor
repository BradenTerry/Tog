@using Microsoft.AspNetCore.Components.Web.Virtualization

@* A path tree, drawn as the flat list of rows it shows: directories that are
   open contribute their children, folded ones do not. Only the rows in view are
   drawn. A worktree can have thousands of files, every row is a button, and in
   Blazor Server every button is a handler registered over the circuit, so an
   open tree drawn whole is slow to answer a click.
   The file row is supplied by the caller, because what belongs on it differs:
   a diff shows its additions and deletions, a file browser shows the name. *@

@typeparam TValue

<Virtualize Items="Rows" ItemSize="RowHeight" OverscanCount="40" Context="row">
    @{
        var node = row.Node;
    }
    @if (node.IsFile)
    {
        <button type="button"
                class="tree-row file @(Selected == node.Path ? "selected" : "")"
                style="@Indent(row.Depth)"
                title="@node.Path"
                @onclick="() => OnSelect.InvokeAsync(node.Path)">
            @FileRow(node)
        </button>
    }
    else
    {
        var open = !Collapsed.Contains(node.Path);
        <button type="button"
                class="tree-row dir"
                style="@Indent(row.Depth)"
                aria-expanded="@open.ToString().ToLowerInvariant()"
                @onclick="() => OnToggle.InvokeAsync(node.Path)">
            <span class="caret @(open ? "open" : "")" aria-hidden="true"></span>
            <span class="label">@node.Name</span>
            <span class="n faint">@node.FileCount</span>
        </button>
    }
</Virtualize>

@code {
    /// <summary>The row height in pixels, which `.tree-row` pins so the list can be windowed.</summary>
    private const float RowHeight = 24;

    [Parameter, EditorRequired]
    public PathTreeNode<TValue> Node { get; set; } = default!;

    /// <summary>Paths of the directories the user has folded shut.</summary>
    [Parameter, EditorRequired]
    public HashSet<string> Collapsed { get; set; } = default!;

    /// <summary>The file currently in view, if any.</summary>
    [Parameter]
    public string? Selected { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<PathTreeNode<TValue>> FileRow { get; set; } = default!;

    [Parameter]
    public EventCallback<string> OnToggle { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    private readonly record struct Row(PathTreeNode<TValue> Node, int Depth);

    /// <summary>
    /// The rows the tree shows, in order. Rebuilt on each render: a fold changes
    /// which rows there are, and walking even a large tree is far cheaper than
    /// drawing it.
    /// </summary>
    private List<Row> Rows
    {
        get
        {
            var rows = new List<Row>();
            Walk(Node, 0, rows);
            return rows;
        }
    }

    private void Walk(PathTreeNode<TValue> node, int depth, List<Row> rows)
    {
        foreach (var child in node.Children)
        {
            rows.Add(new Row(child, depth));
            if (!child.IsFile && !Collapsed.Contains(child.Path))
            {
                Walk(child, depth + 1, rows);
            }
        }
    }

    /// <summary>
    /// Indentation is inline because it is data, not style: the depth is only
    /// known while rendering, and a class per level would be a class per possible
    /// directory depth.
    /// </summary>
    private static string Indent(int depth) => $"padding-left: {8 + depth * 13}px;";
}
