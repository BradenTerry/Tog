@using Microsoft.AspNetCore.Components.Web.Virtualization

@* A path tree, drawn as the flat list of rows it shows: directories that are
   open contribute their children, folded ones do not. Only the rows in view are
   drawn. A worktree can have thousands of files, every row is a button, and in
   Blazor Server every button is a handler registered over the circuit, so an
   open tree drawn whole is slow to answer a click.
   The file row is supplied by the caller, because what belongs on it differs:
   a diff shows its additions and deletions, a file browser shows the name. *@

@typeparam TValue

<Virtualize Items="Rows" ItemSize="RowHeight" OverscanCount="40" Context="row">
    @{
        var node = row.Node;
        var open = !node.IsFile && IsOpen(node.Path);
        var rowClass = node.IsFile ? $"tree-row file {(Selected == node.Path ? "selected" : "")}" : "tree-row dir";
    }
    @if (Actions is null)
    {
        <button type="button"
                class="@rowClass"
                style="@Indent(row.Depth)"
                title="@(node.IsFile ? node.Path : null)"
                aria-expanded="@(node.IsFile ? null : open.ToString().ToLowerInvariant())"
                @onclick="() => Activate(node)"
                @ondblclick="() => Keep(node)">
            @RowContent((node, open))
        </button>
    }
    else
    {
        @* With actions the row is a plain container: the actions are buttons,
           and a button cannot sit inside another. *@
        <div class="@rowClass has-actions" style="@Indent(row.Depth)">
            <button type="button"
                    class="tree-hit"
                    title="@(node.IsFile ? node.Path : null)"
                    aria-expanded="@(node.IsFile ? null : open.ToString().ToLowerInvariant())"
                    @onclick="() => Activate(node)"
                    @ondblclick="() => Keep(node)">
                @RowContent((node, open))
            </button>
            <span class="tree-actions">@Actions(node)</span>
        </div>
    }
</Virtualize>

@code {
    /// <summary>The row height in pixels, which `.tree-row` pins so the list can be windowed.</summary>
    private const float RowHeight = 24;

    [Parameter, EditorRequired]
    public PathTreeNode<TValue> Node { get; set; } = default!;

    /// <summary>
    /// Paths of the directories the user has toggled away from the default:
    /// folded shut, or opened when <see cref="FoldedByDefault"/> is set.
    /// </summary>
    [Parameter, EditorRequired]
    public HashSet<string> Collapsed { get; set; } = default!;

    /// <summary>
    /// Every folder starts shut, as VS Code's Source Control view has them, and
    /// <see cref="Collapsed"/> holds the ones opened. Inverted rather than
    /// seeded with every folder, so a folder that first appears later (a file
    /// staged into a new part of the tree) starts shut as well.
    /// </summary>
    [Parameter]
    public bool FoldedByDefault { get; set; }

    private bool IsOpen(string path) => Collapsed.Contains(path) == FoldedByDefault;

    /// <summary>The file currently in view, if any.</summary>
    [Parameter]
    public string? Selected { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<PathTreeNode<TValue>> FileRow { get; set; } = default!;

    /// <summary>
    /// Buttons drawn at the end of a row, file or folder, such as staging it.
    /// Left null, each row is one button.
    /// </summary>
    [Parameter]
    public RenderFragment<PathTreeNode<TValue>>? Actions { get; set; }

    [Parameter]
    public EventCallback<string> OnToggle { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    /// <summary>A double click on a file, which opens it to stay rather than as a preview.</summary>
    [Parameter]
    public EventCallback<string> OnKeep { get; set; }

    private Task Keep(PathTreeNode<TValue> node) =>
        node.IsFile && OnKeep.HasDelegate ? OnKeep.InvokeAsync(node.Path) : Task.CompletedTask;

    private Task Activate(PathTreeNode<TValue> node) =>
        node.IsFile ? OnSelect.InvokeAsync(node.Path) : OnToggle.InvokeAsync(node.Path);

    private RenderFragment RowContent((PathTreeNode<TValue> Node, bool Open) row) => __builder =>
    {
        var node = row.Node;
        if (node.IsFile)
        {
            @* The empty twistie keeps a file's icon under its folder's icon. *@
            <span class="twistie" aria-hidden="true"></span>
            <FileGlyph Path="@node.Path" />
            @FileRow(node)
        }
        else
        {
            <span class="twistie" aria-hidden="true">
                <svg class="chevron @(row.Open ? "open" : "")" viewBox="0 0 16 16" width="14" height="14">
                    <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
            <span class="file-icon fi-folder" aria-hidden="true">
                @if (row.Open)
                {
                    <svg viewBox="0 0 16 16" width="15" height="15">
                        <path d="M1.5 3.5h4.5l1.5 1.5h6v2H4L1.5 12.5z" fill="currentColor" opacity="0.55" />
                        <path d="M1.5 12.5 4 7h11l-2.5 5.5z" fill="currentColor" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 16 16" width="15" height="15">
                        <path d="M1.5 3.5h4.5l1.5 1.5h7v7.5h-13z" fill="currentColor" />
                    </svg>
                }
            </span>
            <span class="label">@node.Name</span>
            <span class="n faint">@node.FileCount</span>
        }
    };

    private readonly record struct Row(PathTreeNode<TValue> Node, int Depth);

    /// <summary>
    /// The rows the tree shows, in order. Rebuilt on each render: a fold changes
    /// which rows there are, and walking even a large tree is far cheaper than
    /// drawing it.
    /// </summary>
    private List<Row> Rows
    {
        get
        {
            var rows = new List<Row>();
            Walk(Node, 0, rows);
            return rows;
        }
    }

    private void Walk(PathTreeNode<TValue> node, int depth, List<Row> rows)
    {
        foreach (var child in node.Children)
        {
            rows.Add(new Row(child, depth));
            if (!child.IsFile && IsOpen(child.Path))
            {
                Walk(child, depth + 1, rows);
            }
        }
    }

    /// <summary>
    /// Indentation is inline because it is data, not style: the depth is only
    /// known while rendering, and a class per level would be a class per possible
    /// directory depth.
    /// </summary>
    private static string Indent(int depth) => $"padding-left: {8 + depth * 13}px;";
}
