@using AgentsDashboard.Core.Code
@inject WorktreeFiles Files
@inject CodeIntelligence Code
@inject DiffReader Diffs
@inject WorktreeViews Views
@inject IJSRuntime Js
@implements IDisposable

<div class="inline" style="margin-bottom: 12px;">
    <input type="text" style="max-width: 300px;" placeholder="Filter by path"
           aria-label="Filter files by path"
           value="@_filter"
           @oninput="e => SetFilter(e.Value?.ToString() ?? string.Empty)" />
    <button class="ghost" @onclick="Load" disabled="@_loading">@(_loading ? "Loading..." : "Refresh")</button>
    @if (_files.Count > 0)
    {
        <span class="spacer faint">
            @Fmt.Count(Shown.Count, "file")@(Shown.Count == _files.Count ? "" : $" of {_files.Count}")
        </span>
    }
</div>

@if (_loading && _files.Count == 0)
{
    <div class="empty"><p>Listing the worktree...</p></div>
}
else if (_files.Count == 0)
{
    <div class="empty">
        <h2>No files</h2>
        <p>Git reports nothing tracked or untracked here.</p>
    </div>
}
else
{
    <div class="diff-layout">
        <aside class="card filelist" aria-label="Files in this worktree" @ref="_list">
            <div class="filelist-head">
                <span class="faint">@Fmt.Count(Shown.Count, "file")</span>
                <button class="ghost small spacer" @onclick="ToggleAll">
                    @(AnyOpen ? "Collapse all" : "Expand all")
                </button>
            </div>

            @if (Shown.Count == 0)
            {
                <div class="row faint">Nothing matches that filter.</div>
            }
            else
            {
                <PathTreeView TValue="WorktreeFile"
                              Node="Tree"
                              Collapsed="@(_filter.Length == 0 ? _collapsed : NoneCollapsed)"
                              Selected="@_selected"
                              OnToggle="ToggleDirectory"
                              OnSelect="Select">
                    <FileRow Context="node">
                        <span class="kind @(node.Value!.Tracked ? "" : "added")"
                              title="@(node.Value.Tracked ? "Tracked" : "Untracked")">
                            @(node.Value.Tracked ? "" : "N")
                        </span>
                        <span class="label">@node.Name</span>
                    </FileRow>
                </PathTreeView>
            }
        </aside>

        <div>
            @if (_pending is { } pending)
            {
                <div class="banner">
                    <div class="inline">
                        <span>Discard unsaved changes to <span class="mono">@_file?.Path</span>?</span>
                        <span class="spacer"></span>
                        <button class="small" @onclick="() => Open(pending, _pendingLine)">Discard</button>
                        <button class="ghost small" @onclick="KeepEditing">Keep editing</button>
                    </div>
                </div>
            }

            @if (_outside is { } outside)
            {
                <div class="banner">
                    <div class="inline">
                        <span>That definition is outside this worktree: <span class="mono">@outside</span></span>
                        <span class="spacer"></span>
                        <a class="btn small" href="@EditorLinks.VsCode(outside, _outsideLine)">Open in VS Code</a>
                        <button class="ghost small" @onclick="() => _outside = null">Dismiss</button>
                    </div>
                </div>
            }

            @if (_conflict)
            {
                <div class="banner">
                    <div class="inline">
                        <span>The file changed on disk since you opened it.</span>
                        <span class="spacer"></span>
                        <button class="small" @onclick="Reload">Reload from disk</button>
                        <button class="small" @onclick="Overwrite">Overwrite</button>
                    </div>
                </div>
            }
            else if (_failure is { Length: > 0 } failure)
            {
                <div class="banner danger">@failure</div>
            }

            @if (_file is null)
            {
                <div class="empty">
                    <h2>Pick a file</h2>
                    <p>Everything git tracks here, plus anything new that is not ignored.</p>
                </div>
            }
            else
            {
                <article class="card editor-card">
                    <div class="card-head diff-file-head">
                        <span class="mono truncate" title="@_file.Path">@_file.Path</span>
                        @if (_unsaved)
                        {
                            <span class="chip waiting">unsaved</span>
                        }
                        @if (IsCSharp)
                        {
                            <span class="chip @CodeChipKind" title="@(CodeStatus.Message ?? CodeChip)">@CodeChip</span>
                            <button class="ghost small" @onclick="ReloadCode">Reload</button>
                        }
                        <span class="spacer"></span>
                        @if (_file.Editable)
                        {
                            <button class="primary small" disabled="@(!_unsaved || _saving)" @onclick="Save">
                                @(_saving ? "Saving..." : "Save")
                            </button>
                        }
                        <a class="btn small" href="@VsCodeLink" title="Open this file in VS Code">Open in VS Code</a>
                        <span class="faint nums">@Status</span>
                    </div>

                    @if (_file.Error is { Length: > 0 } error)
                    {
                        <div class="row faint">@error</div>
                    }
                    else if (_file.IsBinary)
                    {
                        <div class="row faint">Binary file, not shown.</div>
                    }
                    else if (_file.Truncated)
                    {
                        <div class="row faint">
                            Large file: showing the first part of it. It is too big to edit here.
                        </div>
                        <div class="diff-lines file-lines">
                            @foreach (var (line, index) in _file.Text.Split('\n').Select((l, i) => (l, i)))
                            {
                                <div class="diff-line">
                                    <span class="ln-static">@(index + 1)</span>
                                    <span class="code">@line</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <CodeEditor @ref="_editor"
                                    Path="@_file.Path"
                                    AbsolutePath="@(WorktreeFiles.Resolve(WorktreePath, _file.Path) ?? "")"
                                    WorktreePath="@WorktreePath"
                                    Text="@_file.Text"
                                    Stamp="@_stamp"
                                    Line="@_line"
                                    Marks="@_marks"
                                    OnSave="Save"
                                    OnDirtyChanged="SetUnsaved"
                                    OnNavigate="Navigate"
                                    OnReferences="ShowReferences"
                                    OnCallHierarchy="ShowCallHierarchy"
                                    OnTextChanged="PushText" />

                        <div class="row faint editor-hint">
                            Ctrl+S or Cmd+S saves.@(IsCSharp ? " F12 goes to a definition, Shift+F12 finds references, Shift+Alt+H shows callers." : "")
                        </div>
                    }
                </article>

                @if (_hierarchy is not null || _references is not null)
                {
                    <CodePanel Title="@_panelTitle"
                               Locations="@(_references ?? [])"
                               Hierarchy="@_hierarchy"
                               OnPick="Pick"
                               OnClose="ClosePanel" />
                }
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string WorktreePath { get; set; } = "";

    /// <summary>A file to open on arrival, from <c>?file=</c> on the URL.</summary>
    [Parameter]
    public string? InitialFile { get; set; }

    /// <summary>The line to reveal in it, from <c>?line=</c>.</summary>
    [Parameter]
    public int? InitialLine { get; set; }

    private IReadOnlyList<WorktreeFile> _files = [];

    /// <summary>
    /// Folded directories. The set is the remembered one for this worktree, so
    /// folding and unfolding here is what the next visit to the tab finds.
    /// </summary>
    private HashSet<string> _collapsed = new(StringComparer.Ordinal);

    /// <summary>
    /// A filtered tree is small enough to read whole, and folds left in place
    /// would hide the very matches searched for. It is shown unfolded without
    /// touching the remembered folds, so clearing the filter puts them back.
    /// </summary>
    private static readonly HashSet<string> NoneCollapsed = [];

    private RememberedView _view = new();
    private ElementReference _list;

    /// <summary>Lines changed against the Changes tab's base, for the editor's gutter.</summary>
    private IReadOnlyList<ChangeMark> _marks = [];

    /// <summary>
    /// Set when a link opened the file with no line in it. The first change is
    /// the likeliest thing it meant, so the editor lands there once the marks
    /// are known.
    /// </summary>
    private bool _landOnChange;
    private string _filter = "";
    private string? _selected;

    private TextFile? _file;
    private string _stamp = "";
    private int? _line;

    /// <summary>True while the editor holds changes that are not on disk.</summary>
    private bool _unsaved;
    private bool _saving;
    private bool _conflict;
    private string? _failure;
    private DateTimeOffset? _savedAt;
    private Timer? _savedFor;

    /// <summary>A file the user picked while the open one had unsaved changes.</summary>
    private string? _pending;

    /// <summary>The line to reveal in <see cref="_pending"/> once it is opened.</summary>
    private int? _pendingLine;

    /// <summary>A definition that landed outside the worktree, which has no tab to open in.</summary>
    private string? _outside;
    private int? _outsideLine;

    private IReadOnlyList<CodeLocation>? _references;
    private CallHierarchy? _hierarchy;
    private string _panelTitle = "";

    private CodeEditor? _editor;

    /// <summary>
    /// The last link acted on, so a re-render does not reopen it. The line is
    /// part of it: a second link into the same file at another line still moves.
    /// </summary>
    private (string File, int? Line)? _applied;

    private bool _loading;
    private CancellationTokenSource? _load;

    private PathTreeNode<WorktreeFile>? _treeCache;
    private IReadOnlyList<WorktreeFile>? _treeCacheFor;

    /// <summary>
    /// Set by anything that changes what this tab shows. The worktree page
    /// re-renders every second because the monitor publishes that often, and
    /// nothing here depends on the snapshot.
    /// </summary>
    private bool _render = true;

    protected override bool ShouldRender()
    {
        if (!_render)
        {
            return false;
        }

        _render = false;
        return true;
    }

    private void Touch() => _render = true;

    private IReadOnlyList<WorktreeFile> Shown => _filter.Length == 0
        ? _files
        : _files.Where(f => f.Path.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    private PathTreeNode<WorktreeFile> Tree
    {
        get
        {
            var shown = Shown;
            if (!ReferenceEquals(_treeCacheFor, shown))
            {
                _treeCacheFor = shown;
                _treeCache = WorktreeFiles.Tree(shown);
            }

            return _treeCache!;
        }
    }

    private string VsCodeLink =>
        WorktreeFiles.Resolve(WorktreePath, _file?.Path ?? "") is { } full
            ? EditorLinks.VsCode(full, null)
            : "";

    /// <summary>
    /// What the header says about the file on the right. A save is worth
    /// confirming for a few seconds, after which the counts are more useful.
    /// </summary>
    private string Status
    {
        get
        {
            if (_savedAt is not null)
            {
                return "Saved just now";
            }

            if (_file is null || _file.Error is not null || _file.IsBinary)
            {
                return _file is null ? "" : Fmt.Bytes(_file.Bytes);
            }

            return $"{Fmt.Count(LineCount, "line")}, {Fmt.Bytes(_file.Bytes)}";
        }
    }

    private int LineCount
    {
        get
        {
            if (_file is null || _file.Text.Length == 0)
            {
                return 0;
            }

            var lines = _file.Text.Split('\n').Length;

            // A trailing newline produces one empty element that is not a line.
            return _file.Text.EndsWith('\n') ? lines - 1 : lines;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Listing is a git call, and prerendering throws its result away.
        if (RendererInfo.IsInteractive)
        {
            Code.StatusChanged += OnCodeStatusChanged;
            Views.BaseChanged += OnBaseChanged;

            _view = Views.For(WorktreePath);
            if (_view.Collapsed is { } remembered)
            {
                _collapsed = remembered;
            }

            await Load();

            // Coming back to the tab reopens what was open, unless a link is
            // about to open something else.
            if (_file is null && InitialFile is null && _view.OpenFile is { } open)
            {
                Open(open, null);
            }
        }
    }

    protected override void OnParametersSet()
    {
        // The tab stays built while you are on another one, and the link that
        // opened a file is gone from the URL by the time you come back. Forgetting
        // it then means following the same link again still moves the editor.
        if (InitialFile is null)
        {
            _applied = null;
        }

        if (!RendererInfo.IsInteractive
            || InitialFile is not { Length: > 0 } file
            || _applied == (file, InitialLine))
        {
            return;
        }

        // A deep link is an instruction, not a selection, so it opens the file
        // whether or not the listing has it: ReadText reports a missing file
        // better than an empty pane would.
        _applied = (file, InitialLine);
        Open(file, InitialLine);
        _landOnChange = InitialLine is null;
        Reveal(file);
    }

    private async Task Load()
    {
        if (_load is not null)
        {
            await _load.CancelAsync();
            _load.Dispose();
        }

        _load = new CancellationTokenSource();
        var token = _load.Token;

        _loading = true;
        Touch();
        StateHasChanged();

        try
        {
            var files = await Files.ListAsync(WorktreePath, token);
            if (!token.IsCancellationRequested)
            {
                _files = files;
                _treeCacheFor = null;

                // The first time the tree is drawn for this worktree, everything
                // starts folded: a repository opened all the way down is a wall.
                if (_view.Collapsed is null)
                {
                    _collapsed.UnionWith(AllDirectories(Tree));
                    _view.Collapsed = _collapsed;
                    if (_file is not null)
                    {
                        Reveal(_file.Path);
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _loading = false;
                Touch();
            }
        }
    }

    private void SetFilter(string value)
    {
        Touch();
        _filter = value;
    }

    /// <summary>Unfolds the directories a file sits in, so the tree shows what is open.</summary>
    private void Reveal(string path)
    {
        var at = path.LastIndexOf('/');
        while (at > 0)
        {
            _collapsed.Remove(path[..at]);
            at = path.LastIndexOf('/', at - 1);
        }
    }

    /// <summary>
    /// Picking a file in the tree. Unsaved work is never thrown away on a click,
    /// and a JS confirm() would block the circuit for as long as the dialog is up,
    /// so the question is asked inline instead.
    /// </summary>
    private void Select(string path)
    {
        Touch();
        if (_unsaved && !string.Equals(path, _file?.Path, StringComparison.Ordinal))
        {
            _pending = path;
            return;
        }

        Open(path, null);
    }

    private void KeepEditing()
    {
        Touch();
        _pending = null;
        _pendingLine = null;
    }

    private void Open(string path, int? line)
    {
        Touch();
        _pending = null;
        _pendingLine = null;
        _selected = path;
        _line = line;
        _unsaved = false;
        _conflict = false;
        _failure = null;
        ClearSaved();

        _file = Files.ReadText(WorktreePath, path);
        _stamp = _file.Stamp;
        _view.OpenFile = path;
        _marks = [];
        _landOnChange = false;

        StartLoadingCode();
        _ = ReadMarks();
    }

    /// <summary>
    /// Reads which lines of the open file differ from the Changes tab's base.
    /// </summary>
    /// <remarks>
    /// Against the file on disk, so it runs whenever the disk and the editor come
    /// back into step: on opening, saving and reloading. An answer for a file that
    /// has since been swapped out is dropped.
    /// </remarks>
    private async Task ReadMarks()
    {
        if (_file is not { } file || file.IsBinary || file.Error is not null)
        {
            return;
        }

        var marks = ChangeMarks.From(
            await Diffs.ReadFileAsync(WorktreePath, file.Path, _view.Base, _view.CustomRef));

        if (_file?.Path != file.Path)
        {
            return;
        }

        _marks = marks;
        if (_landOnChange)
        {
            _landOnChange = false;
            if (ChangeMarks.First(marks) is { } first)
            {
                _line = first;
            }
        }

        Touch();
        StateHasChanged();
    }

    private void OnBaseChanged(string worktreePath)
    {
        if (string.Equals(worktreePath, WorktreePath, StringComparison.Ordinal))
        {
            _ = InvokeAsync(ReadMarks);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The tree scrolls on its own, and where it was scrolled to is part of
        // where you were. The element only exists once the listing has arrived.
        if (_list.Id is null)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("agentsDashboard.keepScroll", _list, "files:" + WorktreePath);
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    private void SetUnsaved(bool unsaved)
    {
        Touch();
        _unsaved = unsaved;
    }

    /// <summary>Ctrl+S, which arrives with the text already attached.</summary>
    private void Save(string text) => Write(text, force: false);

    /// <summary>
    /// The Save button, which does not have the text: the editor holds it in the
    /// browser. Fetching it costs the one round trip the shortcut takes anyway,
    /// and is cheaper than shipping every keystroke up to keep a server copy.
    /// </summary>
    private async Task Save()
    {
        if (await Current() is { } text)
        {
            Write(text, force: false);
        }
    }

    private async Task Overwrite()
    {
        if (await Current() is { } text)
        {
            Write(text, force: true);
        }
    }

    private async Task<string?> Current() =>
        _editor is null ? null : await _editor.GetTextAsync();

    private void Write(string text, bool force)
    {
        if (_file is null)
        {
            return;
        }

        Touch();
        _saving = true;
        _failure = null;

        var result = Files.Write(
            WorktreePath,
            _file.Path,
            text,
            _stamp,
            _file.Eol,
            _file.HasBom,
            force);

        _saving = false;

        if (result.Ok)
        {
            _stamp = result.Stamp ?? _stamp;
            _unsaved = false;
            _conflict = false;

            // The editor is already showing this text, so the record of it here is
            // updated rather than pushed back down: a new Text with the same stamp
            // would not move the editor anyway, and a new stamp would reset the
            // undo stack under the user's hands.
            _file = _file with { Text = text, Stamp = _stamp, Bytes = System.Text.Encoding.UTF8.GetByteCount(text) };

            // The solution was holding the buffer as it was typed. What is on disk
            // now is the same text, but reading it back is what the rest of the
            // solution's view of this file is rebuilt from.
            Code.RefreshDocumentFromDisk(WorktreePath, _file.Path);
            MarkSaved();
            _ = ReadMarks();
            return;
        }

        _conflict = result.Conflict;
        _failure = result.Conflict ? null : result.Message;
    }

    private void Reload()
    {
        if (_file is null)
        {
            return;
        }

        // The conflict means someone else wrote the file, so the solution is
        // holding text that no longer exists anywhere.
        Code.RefreshDocumentFromDisk(WorktreePath, _file.Path);
        Open(_file.Path, null);
    }

    private void MarkSaved()
    {
        _savedAt = DateTimeOffset.UtcNow;
        _savedFor?.Dispose();

        // Five seconds is long enough to read and short enough that the counts,
        // which are what the header is for the rest of the time, come back.
        _savedFor = new Timer(
            _ => InvokeAsync(() =>
            {
                _savedAt = null;
                Touch();
                StateHasChanged();
            }),
            null,
            TimeSpan.FromSeconds(5),
            Timeout.InfiniteTimeSpan);
    }

    private void ClearSaved()
    {
        _savedAt = null;
        _savedFor?.Dispose();
        _savedFor = null;
    }

    private void ToggleDirectory(string path)
    {
        Touch();
        if (!_collapsed.Add(path))
        {
            _collapsed.Remove(path);
        }
    }

    private bool AnyOpen => AllDirectories(Tree).Any(d => !_collapsed.Contains(d));

    private void ToggleAll()
    {
        Touch();
        if (AnyOpen)
        {
            foreach (var dir in AllDirectories(Tree))
            {
                _collapsed.Add(dir);
            }
        }
        else
        {
            _collapsed.Clear();
        }
    }

    private static IEnumerable<string> AllDirectories<T>(PathTreeNode<T> node) =>
        node.Children
            .Where(c => !c.IsFile)
            .SelectMany(c => new[] { c.Path }.Concat(AllDirectories(c)));

    // ---------- code intelligence ----------

    private CancellationTokenSource? _codeLoad;

    private bool IsCSharp => _file?.Path.EndsWith(".cs", StringComparison.OrdinalIgnoreCase) ?? false;

    private LoadStatus CodeStatus => Code.Status(WorktreePath);

    private string CodeChip => CodeStatus switch
    {
        { State: LoadState.Loading } s => $"Roslyn: {s.Message ?? "loading"}",
        { State: LoadState.Ready } s => $"Roslyn: ready, {Fmt.Count(s.Projects, "project")}",
        { State: LoadState.Failed } => "Roslyn: failed",
        _ => "Roslyn: not loaded",
    };

    private string CodeChipKind => CodeStatus.State switch
    {
        LoadState.Loading => "waiting",
        LoadState.Ready => "accent",
        LoadState.Failed => "danger",
        _ => "",
    };

    /// <summary>
    /// Opening a C# file is what starts the solution load, and it is deliberately
    /// not awaited: MSBuild takes seconds, and the file itself is on screen from
    /// the moment it is read. The chip is how the wait is shown.
    /// </summary>
    private void StartLoadingCode()
    {
        if (!IsCSharp || !RendererInfo.IsInteractive)
        {
            return;
        }

        _codeLoad ??= new CancellationTokenSource();
        _ = Code.EnsureLoadedAsync(WorktreePath, _codeLoad.Token);
    }

    private void OnCodeStatusChanged(string worktreePath)
    {
        if (!string.Equals(worktreePath, WorktreePath, StringComparison.Ordinal)
            && !string.Equals(Path.GetFullPath(worktreePath), Path.GetFullPath(WorktreePath), StringComparison.Ordinal))
        {
            return;
        }

        // The event comes off whichever thread the load is on, and the chip is
        // rendered on the circuit's.
        _ = InvokeAsync(() =>
        {
            Touch();
            StateHasChanged();
        });
    }

    private void ReloadCode()
    {
        Touch();
        _codeLoad ??= new CancellationTokenSource();
        _ = Code.ReloadAsync(WorktreePath, _codeLoad.Token);
    }

    /// <summary>The buffer after a pause in typing, so references answer for it.</summary>
    private void PushText(string text)
    {
        if (_file is not null && IsCSharp)
        {
            Code.UpdateDocument(WorktreePath, _file.Path, text);
        }
    }

    /// <summary>
    /// A definition Monaco could not open itself. It arrives absolute, because
    /// that is the only form a Monaco URI has, and everything here works in
    /// worktree-relative paths.
    /// </summary>
    private void Navigate((string AbsolutePath, int Line, int Column) target)
    {
        Touch();

        if (Relative(target.AbsolutePath) is not { } relative)
        {
            // A source-linked dependency, or a project referenced from outside the
            // worktree. There is no tab for it, so VS Code is the way out.
            _outside = target.AbsolutePath;
            _outsideLine = target.Line;
            return;
        }

        _outside = null;
        OpenAt(relative, target.Line);
    }

    private void ShowReferences(IReadOnlyList<CodeLocation> locations)
    {
        Touch();
        _hierarchy = null;
        _references = locations;
        _panelTitle = "References";
    }

    private void ShowCallHierarchy(CallHierarchy? hierarchy)
    {
        Touch();
        _references = null;
        _hierarchy = hierarchy;
        _panelTitle = "Call hierarchy";
    }

    /// <summary>A row in the panel. The panel stays up, so a list can be walked.</summary>
    private void Pick(CodeLocation location)
    {
        Touch();
        OpenAt(location.Path, location.Line);
    }

    private void ClosePanel()
    {
        Touch();
        _references = null;
        _hierarchy = null;
    }

    /// <summary>
    /// Opening at a line, asking first when the editor holds unsaved work. The
    /// same file is revealed rather than reopened: rereading it would throw the
    /// edit away to move the caret.
    /// </summary>
    private void OpenAt(string path, int line)
    {
        if (string.Equals(path, _file?.Path, StringComparison.Ordinal))
        {
            // Already open: moving the caret is a parameter change, and rereading
            // the file to do it would throw away whatever is being edited.
            _line = line;
            return;
        }

        if (_unsaved)
        {
            _pending = path;
            _pendingLine = line;
            return;
        }

        Open(path, line);
    }

    /// <summary>The worktree-relative form of an absolute path, or null when it is outside.</summary>
    private string? Relative(string absolutePath)
    {
        var root = Path.GetFullPath(WorktreePath).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
        var full = Path.GetFullPath(absolutePath);

        return full.StartsWith(root, StringComparison.Ordinal)
            ? full[root.Length..].Replace(Path.DirectorySeparatorChar, '/')
            : null;
    }

    public void Dispose()
    {
        Code.StatusChanged -= OnCodeStatusChanged;
        Views.BaseChanged -= OnBaseChanged;
        _codeLoad?.Cancel();
        _codeLoad?.Dispose();
        _load?.Cancel();
        _load?.Dispose();
        _savedFor?.Dispose();
    }
}
