@using AgentsDashboard.Core.Extensions
@inject ExtensionHost Extensions
@implements IDisposable

@* Every extension found, what it is, and whether it runs. An extension is code
   running inside the dashboard, as you, so turning one on is always a click
   here, made with its folder and a fingerprint of its code in front of you. *@

<div class="card">
    <div class="card-head">
        <h2>Extensions</h2>
        <button class="ghost small spacer" @onclick="Rescan">Look again</button>
    </div>

    @if (Extensions.Entries.Count == 0)
    {
        <div class="row faint">
            None found. Link a folder below, or put a built extension in
            <span class="mono">@Paths.ExtensionsDir</span>.
        </div>
    }

    @foreach (var entry in Extensions.Entries)
    {
        var found = entry.Found;
        var manifest = found.Manifest;
        <div class="row ext-row">
            <div class="stack" style="flex: 1; min-width: 0;">
                <div class="inline">
                    <strong>@(manifest?.Name ?? found.Id)</strong>
                    @if (manifest is not null)
                    {
                        <span class="faint">@manifest.Version</span>
                    }
                    <span class="chip" title="@SourceTip(found.Source)">@SourceName(found.Source)</span>
                    <span class="chip @StatusClass(entry.Status)">@StatusName(entry.Status)</span>
                </div>
                @if (manifest?.Description is { Length: > 0 } description)
                {
                    <span class="muted">@description</span>
                }
                <span class="mono faint truncate" title="@found.Directory">@found.Directory</span>
                @if (entry.Message is { Length: > 0 } message)
                {
                    <span class="faint" style="color: @(entry.Status == ExtensionStatus.Disabled ? "inherit" : "var(--danger)");">@message</span>
                }
                @if (entry.Status == ExtensionStatus.Loaded && entry.Views.Count > 0)
                {
                    <span class="faint">Adds @string.Join(", ", entry.Views.Select(v => v.Title)).</span>
                }

                @if (_confirming == found.Id && manifest is not null)
                {
                    <div class="banner" style="margin-top: 8px;">
                        <strong>Run @manifest.Name?</strong>
                        <p class="muted" style="margin: 4px 0 6px;">
                            It runs inside the dashboard with your permissions: it can read and write
                            your files and start programs. Enable only code you wrote or trust.
                        </p>
                        <p class="faint" style="margin: 0 0 8px;">
                            @if (manifest.Author is { Length: > 0 } author)
                            {
                                <span>By @author. </span>
                            }
                            <span>Code fingerprint </span><span class="mono">@(ExtensionCatalog.Hash(found)?[..16] ?? "missing")</span>
                        </p>
                        <div class="inline">
                            <button class="primary small" @onclick="() => Enable(found.Id)">Enable</button>
                            <button class="ghost small" @onclick="() => _confirming = null">Cancel</button>
                        </div>
                    </div>
                }
            </div>

            <div class="inline" style="align-self: flex-start;">
                @switch (entry.Status)
                {
                    case ExtensionStatus.Loaded:
                        <button class="ghost small" @onclick="() => Extensions.Reload(found.Id)">Reload</button>
                        @if (found.Source != ExtensionSource.CommandLine)
                        {
                            <button class="ghost small" @onclick="() => Extensions.Disable(found.Id)">Disable</button>
                        }
                        break;
                    case ExtensionStatus.Failed:
                        <button class="ghost small" @onclick="() => Extensions.Reload(found.Id)">Retry</button>
                        @if (found.Source != ExtensionSource.CommandLine)
                        {
                            <button class="ghost small" @onclick="() => Extensions.Disable(found.Id)">Disable</button>
                        }
                        break;
                    case ExtensionStatus.Disabled or ExtensionStatus.NeedsConsent when manifest is not null:
                        <button class="small" @onclick="() => AskOrEnable(found)">Enable</button>
                        break;
                }
                @if (found.Source == ExtensionSource.Linked)
                {
                    <button class="ghost small" @onclick="() => Extensions.Unlink(found.Directory)">Unlink</button>
                }
            </div>
        </div>
    }

    <div class="card-body">
        <div class="inline">
            <input type="text" placeholder="/path/to/your-extension"
                   aria-label="Extension folder to link"
                   value="@_linkPath"
                   @oninput="e => _linkPath = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnLinkKey" />
            <button @onclick="Link" disabled="@string.IsNullOrWhiteSpace(_linkPath)">Link folder</button>
        </div>
        <p class="faint" style="margin: 8px 0 0;">
            A folder with an <span class="mono">extension.json</span>, usually the project you are
            writing. It reloads every time you build it. Extensions compile against
            <span class="mono">@Paths.SdkDir</span>.
        </p>
        @if (_linkError is { Length: > 0 })
        {
            <p class="faint" style="margin: 8px 0 0; color: var(--danger);">@_linkError</p>
        }
    </div>
</div>

@code {
    [Inject]
    private AgentsDashboard.Core.Repos.AppPaths Paths { get; set; } = default!;

    private string _linkPath = "";
    private string? _linkError;
    private string? _confirming;

    protected override void OnInitialized() => Extensions.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// A folder you linked is code you are writing, so it is turned on as it is.
    /// An installed copy is asked about first.
    /// </summary>
    private void AskOrEnable(FoundExtension found)
    {
        if (found.IsDev)
        {
            Enable(found.Id);
        }
        else
        {
            _confirming = found.Id;
        }
    }

    private void Enable(string id)
    {
        _confirming = null;
        Extensions.Enable(id);
    }

    private void Rescan() => Extensions.Rescan();

    private void OnLinkKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Link();
        }
    }

    private void Link()
    {
        _linkError = Extensions.Link(_linkPath);
        if (_linkError is null)
        {
            _linkPath = "";
        }
    }

    private static string SourceName(ExtensionSource source) => source switch
    {
        ExtensionSource.Installed => "installed",
        ExtensionSource.Linked => "dev",
        _ => "this run",
    };

    private static string SourceTip(ExtensionSource source) => source switch
    {
        ExtensionSource.Installed => "A copy in the dashboard's extensions folder",
        ExtensionSource.Linked => "A folder you linked. Reloaded on every build.",
        _ => "Passed with --extension for this run only",
    };

    private static string StatusName(ExtensionStatus status) => status switch
    {
        ExtensionStatus.Loaded => "on",
        ExtensionStatus.NeedsConsent => "changed",
        ExtensionStatus.Failed => "failed",
        ExtensionStatus.Invalid => "invalid",
        _ => "off",
    };

    private static string StatusClass(ExtensionStatus status) => status switch
    {
        ExtensionStatus.Loaded => "active",
        ExtensionStatus.Failed or ExtensionStatus.Invalid => "danger",
        ExtensionStatus.NeedsConsent => "accent",
        _ => "",
    };

    public void Dispose() => Extensions.Changed -= OnChanged;
}
