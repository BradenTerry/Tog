@using AgentsDashboard.Core.Extensions
@inject ExtensionHost Extensions
@inject FolderPicker Folders
@inject ExtensionSkill Skill
@implements IDisposable

@* Every extension found, what it is, and whether it runs. An extension is code
   running inside the dashboard, as you, so turning one on is always a click
   here, made with its folder and a fingerprint of its code in front of you. *@

<div class="card">
    <div class="card-head">
        <h2>Extensions</h2>
        <button class="ghost small spacer" @onclick="Rescan">Look again</button>
    </div>

    @if (Extensions.Entries.Count == 0)
    {
        <div class="row faint">
            <span>
                None found. Add its folder below, or put a built extension in
                <span class="mono">@Paths.ExtensionsDir</span>.
            </span>
        </div>
    }

    @foreach (var entry in Extensions.Entries)
    {
        var found = entry.Found;
        var manifest = found.Manifest;
        <div class="row ext-row">
            <div class="stack" style="flex: 1; min-width: 0;">
                <div class="inline">
                    <strong>@(manifest?.Name ?? found.Id)</strong>
                    @if (manifest is not null)
                    {
                        <span class="faint">@manifest.Version</span>
                    }
                    <span class="chip" title="@SourceTip(found.Source)">@SourceName(found.Source)</span>
                    <span class="chip @StatusClass(entry.Status)">@StatusName(entry.Status)</span>
                </div>
                @if (manifest?.Description is { Length: > 0 } description)
                {
                    <span class="muted">@description</span>
                }
                <span class="mono faint truncate" title="@found.Directory">@found.Directory</span>
                @if (entry.Message is { Length: > 0 } message)
                {
                    <span class="faint" style="color: @(entry.Status == ExtensionStatus.Disabled ? "inherit" : "var(--danger)");">@message</span>
                }
                @if (entry.Status == ExtensionStatus.Loaded && entry.Views.Count > 0)
                {
                    <span class="faint">Adds @string.Join(", ", entry.Views.Select(v => v.Title)).</span>
                }

                @if (_confirming == found.Id && manifest is not null)
                {
                    <div class="banner" style="margin-top: 8px;">
                        <strong>Run @manifest.Name?</strong>
                        <p class="muted" style="margin: 4px 0 6px;">
                            It runs inside the dashboard with your permissions: it can read and write
                            your files and start programs. Enable only code you wrote or trust.
                        </p>
                        <p class="faint" style="margin: 0 0 8px;">
                            @if (manifest.Author is { Length: > 0 } author)
                            {
                                <span>By @author. </span>
                            }
                            <span>Code fingerprint </span><span class="mono">@(ExtensionCatalog.Hash(found)?[..16] ?? "missing")</span>
                        </p>
                        <div class="inline">
                            <button class="primary small" @onclick="() => Enable(found.Id)">Enable</button>
                            <button class="ghost small" @onclick="() => _confirming = null">Cancel</button>
                        </div>
                    </div>
                }
            </div>

            <div class="inline" style="align-self: flex-start;">
                @switch (entry.Status)
                {
                    case ExtensionStatus.Loaded:
                        <button class="ghost small" @onclick="() => OffWindow(() => Extensions.Reload(found.Id))">Reload</button>
                        @if (found.Source != ExtensionSource.CommandLine)
                        {
                            <button class="ghost small" @onclick="() => OffWindow(() => Extensions.Disable(found.Id))">Disable</button>
                        }
                        break;
                    case ExtensionStatus.Failed:
                        <button class="ghost small" @onclick="() => OffWindow(() => Extensions.Reload(found.Id))">Retry</button>
                        @if (found.Source != ExtensionSource.CommandLine)
                        {
                            <button class="ghost small" @onclick="() => OffWindow(() => Extensions.Disable(found.Id))">Disable</button>
                        }
                        break;
                    case ExtensionStatus.Disabled or ExtensionStatus.NeedsConsent when manifest is not null:
                        <button class="small" @onclick="() => AskOrEnable(found)">Enable</button>
                        break;
                }
                @if (found.Source == ExtensionSource.Linked)
                {
                    <button class="ghost small" @onclick="() => OffWindow(() => Extensions.Unlink(found.Directory))">Unlink</button>
                }
            </div>
        </div>
    }

    <div class="card-head"><h2>Extension folders</h2></div>
    @foreach (var path in Extensions.Paths)
    {
        <div class="row">
            <span class="mono truncate" style="flex: 1; min-width: 0;" title="@path.Display">@path.Display</span>
            <button class="ghost small" @onclick="() => OffWindow(() => Extensions.Remove(path))">Remove</button>
        </div>
    }
    <div class="card-body">
        <div class="inline">
            <input type="text" placeholder="/path/to/your-extension or /path/to/extensions/*"
                   aria-label="Extension folder to add"
                   value="@_path"
                   @oninput="e => _path = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnPathKey" />
            @if (Folders.Available)
            {
                <button class="primary" @onclick="Browse" disabled="@_picking">Choose folder...</button>
                <button @onclick="Add" disabled="@string.IsNullOrWhiteSpace(_path)">Add</button>
            }
            else
            {
                <button class="primary" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(_path)">Add</button>
            }
        </div>
        <p class="faint" style="margin: 8px 0 0;">
            A folder with an <span class="mono">extension.json</span>, usually the project you are
            writing. End it with <span class="mono">/*</span> to include every extension directly
            inside it, including ones you add later. Each reloads every time you build it. Only add
            code you trust. Extensions compile against <span class="mono">@Paths.SdkDir</span>.
        </p>
        @if (_error is { Length: > 0 })
        {
            <p class="faint" style="margin: 8px 0 0; color: var(--danger);">@_error</p>
        }
    </div>

    @* The skill is the one thing the app writes into an agent's config folder,
       and only from this button. Agents the dashboard runs do not need it: its
       MCP server hands them the same guide. *@
    <div class="card-head"><h2>Write one with an agent</h2></div>
    @foreach (var (target, state) in _skills)
    {
        <div class="row">
            <div class="stack" style="flex: 1; min-width: 0;">
                <div class="inline">
                    <strong>@target.AgentName skill</strong>
                    @if (target.Available)
                    {
                        <span class="chip @(state == SkillState.Current ? "active" : state == SkillState.Outdated ? "accent" : "")">@SkillStateName(state)</span>
                    }
                </div>
                @if (target.Available)
                {
                    <span class="mono faint truncate" title="@Skill.FileFor(target)">@Skill.FileFor(target)</span>
                }
                else
                {
                    <span class="faint">@target.AgentName is not set up on this machine (no <span class="mono">@target.SkillsDir</span>).</span>
                }
            </div>
            @if (target.Available)
            {
                <div class="inline" style="align-self: flex-start;">
                    @switch (state)
                    {
                        case SkillState.Missing:
                            <button class="small" @onclick="() => InstallSkill(target)">Add skill</button>
                            break;
                        case SkillState.Outdated:
                            <button class="small" @onclick="() => InstallSkill(target)">Update</button>
                            <button class="ghost small" @onclick="() => RemoveSkill(target)">Remove</button>
                            break;
                        default:
                            <button class="ghost small" @onclick="() => RemoveSkill(target)">Remove</button>
                            break;
                    }
                </div>
            }
        </div>
    }
    <div class="card-body">
        <p class="faint" style="margin: 0;">
            Ask an agent to make an extension and it scaffolds one from the dashboard's template, builds
            it and asks you here to turn it on. Agents started in the dashboard already know how; the
            skill teaches ones you start in a terminal too. It names this machine's SDK and template,
            so update it after the dashboard updates.
        </p>
        @if (_skillError is { Length: > 0 })
        {
            <p class="faint" style="margin: 8px 0 0; color: var(--danger);">@_skillError</p>
        }
    </div>
</div>

@code {
    [Inject]
    private AgentsDashboard.Core.Repos.AppPaths Paths { get; set; } = default!;

    private string _path = "";
    private string? _error;
    private string? _confirming;
    private bool _picking;
    private IReadOnlyList<(SkillTarget Target, SkillState State)> _skills = [];
    private string? _skillError;

    protected override void OnInitialized()
    {
        Extensions.Changed += OnChanged;
        ReadSkills();
    }

    /// <summary>Read once and after each button, not per render: it reads files.</summary>
    private void ReadSkills() => _skills = [.. Skill.Targets.Select(t => (t, t.Available ? Skill.State(t) : SkillState.Missing))];

    private void InstallSkill(SkillTarget target)
    {
        _skillError = Skill.Install(target);
        ReadSkills();
    }

    private void RemoveSkill(SkillTarget target)
    {
        _skillError = Skill.Remove(target);
        ReadSkills();
    }

    private static string SkillStateName(SkillState state) => state switch
    {
        SkillState.Current => "added",
        SkillState.Outdated => "out of date",
        _ => "not added",
    };

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// A folder you linked is code you are writing, so it is turned on as it is.
    /// An installed copy is asked about first.
    /// </summary>
    private async Task AskOrEnable(FoundExtension found)
    {
        if (found.IsDev)
        {
            await Enable(found.Id);
        }
        else
        {
            _confirming = found.Id;
        }
    }

    private Task Enable(string id)
    {
        _confirming = null;
        return OffWindow(() => Extensions.Enable(id));
    }

    private Task Rescan() => OffWindow(Extensions.Rescan);

    /// <summary>
    /// Runs a host action on the pool. Loading an extension copies its files,
    /// loads its assemblies and runs its Configure, all extension-sized work
    /// that on this window's thread freezes the window until it is done.
    /// </summary>
    private static Task OffWindow(Action action) => Task.Run(action);

    private async Task OnPathKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Add();
        }
    }

    private async Task Add()
    {
        var path = _path;
        _error = await Task.Run(() => Extensions.Add(path));
        if (_error is null)
        {
            _path = "";
        }
    }

    /// <summary>
    /// Adds the folder the system chooser returns. A folder that is not an
    /// extension but holds some is taken to mean all of them, since that is
    /// the only thing picking it could mean.
    /// </summary>
    private async Task Browse()
    {
        _picking = true;
        try
        {
            var typed = ExtensionCatalog.SplitWildcard(_path).Folder;
            var start = Directory.Exists(typed) ? typed : null;
            if (await Folders.PickAsync("Choose an extension, or a folder of them", start) is not { } chosen)
            {
                return;
            }

            _path = !File.Exists(Path.Combine(chosen, ExtensionManifests.FileName)) && ExtensionCatalog.InFolder(chosen).Any()
                ? Path.Combine(chosen, "*")
                : chosen;
        }
        finally
        {
            _picking = false;
        }

        await Add();
    }

    private static string SourceName(ExtensionSource source) => source switch
    {
        ExtensionSource.Installed => "installed",
        ExtensionSource.InFolder => "folder",
        ExtensionSource.Linked => "dev",
        _ => "this run",
    };

    private static string SourceTip(ExtensionSource source) => source switch
    {
        ExtensionSource.Installed => "A copy in the dashboard's extensions folder",
        ExtensionSource.Linked => "A folder you linked. Reloaded on every build.",
        ExtensionSource.InFolder => "In one of your extension folders. Reloaded on every build.",
        _ => "Passed with --extension for this run only",
    };

    private static string StatusName(ExtensionStatus status) => status switch
    {
        ExtensionStatus.Loaded => "on",
        ExtensionStatus.NeedsConsent => "changed",
        ExtensionStatus.Failed => "failed",
        ExtensionStatus.Invalid => "invalid",
        _ => "off",
    };

    private static string StatusClass(ExtensionStatus status) => status switch
    {
        ExtensionStatus.Loaded => "active",
        ExtensionStatus.Failed or ExtensionStatus.Invalid => "danger",
        ExtensionStatus.NeedsConsent => "accent",
        _ => "",
    };

    public void Dispose() => Extensions.Changed -= OnChanged;
}
