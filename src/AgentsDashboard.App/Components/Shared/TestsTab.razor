@inject TelemetryCache Telemetry
@inject TestRunner Runner
@inject DashboardState State

@{
    var report = Telemetry.Get(View.RepoRoot);
    var mtp = report.Projects.Any(p => p.Runner == TestRunnerKind.MicrosoftTestingPlatform);
}

<div class="inline" style="margin-bottom: 12px;">
    <button class="primary" @onclick="() => Run(mtp)" disabled="@(_starting || report.Projects.Count == 0)">
        @(_starting ? "Starting..." : "Run tests")
    </button>
    @if (report.Projects.Count > 0)
    {
        <span class="faint">
            @Fmt.Count(report.Projects.Count, "test project"),
            @(mtp ? "Microsoft.Testing.Platform" : "VSTest")
        </span>
    }
    @if (_startedCommand is { Length: > 0 })
    {
        <span class="mono faint truncate">@_startedCommand</span>
    }
</div>

@if (report.Projects.Count == 0)
{
    <div class="banner info">
        No .NET test projects found in this repository, so there is nothing to follow here.
    </div>
}
else if (!report.TrxAlwaysOn)
{
    <div class="banner">
        <strong>Runs an agent starts are invisible.</strong>
        <p class="muted" style="margin: 4px 0 8px;">
            Neither runner writes a report unless it is asked to, and an agent typing
            <span class="mono">dotnet test</span> will not ask. One file at the repository root fixes
            that for every test project in it.
        </p>
        <div class="inline">
            <button class="primary" @onclick="Install" disabled="@_installing">
                @(_installing ? "Writing..." : "Enable test telemetry")
            </button>
            <button class="ghost" @onclick="() => _showSnippet = !_showSnippet">
                @(_showSnippet ? "Hide" : "Show what it writes")
            </button>
        </div>
        @if (_showSnippet)
        {
            <pre class="mono scroll-x" style="margin-top: 10px; background: var(--bg); padding: 10px; border-radius: 5px; border: 1px solid var(--border-soft);">@TelemetryInstaller.Snippet</pre>
            <p class="faint" style="margin-top: 6px;">Written to <span class="mono">@report.TargetsPath</span></p>
        }
    </div>
}
else if (!mtp)
{
    <div class="banner info">
        These projects run on VSTest, which writes its report once the run ends, so results
        arrive all at once rather than filling in as they happen. The run itself still shows
        as soon as it starts.
    </div>
}

@if (_message is { Length: > 0 })
{
    <div class="banner info">@_message</div>
}

@if (View.TestRuns.Count == 0)
{
    <div class="empty">
        <h2>No runs yet</h2>
        <p>A run appears here as soon as one starts, whether you started it or an agent did.</p>
    </div>
}

@foreach (var run in View.TestRuns)
{
    <article class="card">
        <div class="card-head">
            <TestSummary Run="run" />
        </div>

        @if (run.State == TestRunState.Running && run.TrxPath is null)
        {
            <div class="row faint">Restoring and building. Results appear once tests begin.</div>
        }

        @foreach (var failure in run.Failures)
        {
            <div class="failure">
                <div class="failure-name">@failure.Name</div>
                @if (failure.Message is { Length: > 0 } message)
                {
                    <pre>@message</pre>
                }
                @if (failure.StackTrace is { Length: > 0 } stack)
                {
                    <pre class="faint">@stack</pre>
                }
            </div>
        }

        @if (run.State != TestRunState.Running && run.Failed == 0 && run.Completed > 0)
        {
            <div class="row">
                <span class="chip active">all @run.Completed passed</span>
                <span class="spacer faint">finished @Fmt.Ago(run.CompletedAt ?? run.LastUpdatedAt, Now)</span>
            </div>
        }
    </article>
}

@code {
    [Parameter, EditorRequired]
    public WorktreeView View { get; set; } = default!;

    [Parameter, EditorRequired]
    public DateTimeOffset Now { get; set; }

    private bool _starting;
    private bool _installing;
    private bool _showSnippet;
    private string? _message;
    private string? _startedCommand;

    private async Task Run(bool mtp)
    {
        _starting = true;
        _message = null;
        StateHasChanged();

        var started = await Task.Run(() => Runner.Start(View.Worktree.Path, mtp));

        _starting = false;
        _startedCommand = started.Command;
        _message = started.Started
            ? null
            : $"Could not start the run. Tried: {started.Command}";
    }

    private async Task Install()
    {
        _installing = true;
        StateHasChanged();

        var report = Telemetry.Get(View.RepoRoot);

        try
        {
            if (TelemetryInstaller.NeedsManualEdit(report))
            {
                _message = $"{report.TargetsPath} exists but has no closing Project tag, "
                           + "so it was left alone. Add the snippet by hand.";
                _showSnippet = true;
            }
            else
            {
                var install = await Task.Run(() => TelemetryInstaller.Install(report));
                _message = install.Created
                    ? $"Wrote {install.Path}. Runs from now on will show up here."
                    : $"Added the block to {install.Path}. Runs from now on will show up here.";
            }
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            _message = $"Could not write {report.TargetsPath}: {e.Message}";
        }

        Telemetry.Invalidate(View.RepoRoot);
        _installing = false;
    }
}
