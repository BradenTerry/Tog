@inject ClaudeCli Cli
@inject MonitorService Monitor
@inject AgentsDashboard.Core.Platform.IClipboard Clipboard
@implements IDisposable

@* Every session working in this worktree, plus the ones parked here. *@

<div class="card" style="margin-bottom: 14px;">
    <div class="card-head"><h2>Start an agent here</h2></div>
    <div class="card-body">
        @* The same form as the Fleet page, with the worktree fixed to this one. *@
        <StartAgentForm WorktreePath="@View.Worktree.Path" OnStarted="OnStarted" />
    </div>
</div>

@if (_message is { Length: > 0 })
{
    <div class="banner @(_failed ? "danger" : "info")">
        @_message
        <button class="ghost small spacer" @onclick="() => { _message = null; Touch(); }">Dismiss</button>
    </div>
}

@if (View.Agents.Count == 0 && Parked.Count == 0)
{
    <div class="empty">
        <h2>No agents here</h2>
        <p>Nothing is running in this worktree, and nothing is parked.</p>
    </div>
}

@foreach (var agent in View.Agents.OrderBy(Rank).ThenBy(a => a.StartedAt))
{
    <article class="card">
        <div class="row">
            <AgentRow Agent="agent" Now="Now" />
        </div>

        @if (agent.LastReply is { Length: > 0 } reply)
        {
            <div class="row">
                <div class="stack" style="flex: 1;">
                    <span class="faint">Last said</span>
                    <div class="reply">
                        <FileLinks Text="@reply" WorktreePath="@View.Worktree.Path" />
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <a class="btn small primary" href="@Urls.Chat(agent.SessionId)">Chat</a>
            @if (agent.IsBackground && agent.JobId is { Length: > 0 } job)
            {
                <button class="ghost small" @onclick="() => Stop(job)" disabled="@_busy">Stop</button>
                <button class="ghost small" @onclick="() => ToggleLogs(job)" disabled="@_busy">Logs</button>
                <button class="ghost small" @onclick="() => CopyAttach(job)">
                    @(_copied == job ? "Copied" : "Copy attach command")
                </button>
                <span class="faint spacer mono">@job</span>
            }
            else
            {
                <span class="faint">
                    Started outside the dashboard, so it belongs to its own terminal. The chat
                    shows its conversation and copies your messages for you to paste there.
                </span>
            }
        </div>

        @if (agent.JobId is { Length: > 0 } logJob && _logsFor == logJob)
        {
            <div class="row" style="display: block;">
                <div class="inline" style="margin-bottom: 6px;">
                    <button class="ghost small" @onclick="() => LoadLogs(logJob)" disabled="@_logsBusy">
                        @(_logsBusy ? "Reading..." : "Refresh")
                    </button>
                    <span class="faint mono spacer">claude logs @logJob</span>
                </div>
                @if (_logsFailed)
                {
                    <p class="faint" style="margin: 0;">Logs are only available while the session is running.</p>
                    <p class="mono faint" style="margin: 4px 0 0;">@_logs</p>
                }
                else
                {
                    <pre class="logs">@_logs</pre>
                }
            </div>
        }

    </article>
}

@if (Parked.Count > 0)
{
    <div class="card">
        <div class="card-head">
            <h2>Parked here</h2>
            <span class="faint">Stopped background agents. Their conversations are kept.</span>
            <button class="ghost small spacer" @onclick="LoadParked" disabled="@_busy">Refresh</button>
        </div>

        @foreach (var parked in Parked)
        {
            <div class="row">
                <div class="stack" style="flex: 1;">
                    <div class="inline">
                        <span class="truncate">@(parked.Name ?? parked.Id)</span>
                        @if (parked.IsFailed)
                        {
                            <span class="chip danger">failed</span>
                        }
                    </div>
                    <div class="inline">
                        <span class="faint mono">@parked.Id</span>
                        @if (parked.StartedAt is { } startedAt)
                        {
                            <span class="faint mono">since @Fmt.Duration(Now - startedAt)</span>
                        }
                    </div>
                </div>
                <a class="btn small" href="@Urls.Chat(parked.SessionId)">Chat</a>
                @if (parked.IsFailed)
                {
                    <button class="ghost small" @onclick="() => Respawn(parked.Id)" disabled="@_busy">Respawn</button>
                }
                <button class="ghost small" @onclick="() => Remove(parked.Id)" disabled="@_busy">Remove</button>
            </div>

        }
    </div>
}

@if (View.Agents.Any(a => a.Skills.Count > 0))
{
    <div class="card">
        <div class="card-head"><h2>Skills used</h2></div>
        @foreach (var agent in View.Agents.Where(a => a.Skills.Count > 0))
        {
            <div class="row">
                <div class="stack">
                    <span class="truncate">@agent.Label</span>
                    <div class="inline" style="margin-top: 3px;">
                        @foreach (var skill in agent.Skills)
                        {
                            <span class="chip mono">@skill</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public WorktreeView View { get; set; } = default!;

    [Parameter, EditorRequired]
    public DateTimeOffset Now { get; set; }

    private string? _message;
    private bool _failed;
    private bool _busy;
    private bool _disposed;
    /// <summary>Every background agent the CLI knows about, running or not.</summary>
    private IReadOnlyList<BackgroundAgent> _known = [];
    /// <summary>The job whose logs panel is open, or null when none is.</summary>
    private string? _logsFor;
    private string _logs = "";
    private bool _logsFailed;
    private bool _logsBusy;
    /// <summary>The job whose attach command was just copied, for the brief confirmation.</summary>
    private string? _copied;
    private CancellationTokenSource? _work;

    /// <summary>
    /// Redraws after work that finished off an event handler.
    /// </summary>
    /// <remarks>
    /// Unlike the diff, this tab renders a handful of rows and wants every
    /// snapshot: an agent's status and its last words are the whole point of it.
    /// So there is no ShouldRender here, and nothing to guard against.
    /// </remarks>
    private void Touch() => StateHasChanged();

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadParked();
        }
    }

    /// <summary>Waiting first, then active: the agent that needs you outranks the one that does not.</summary>
    private static int Rank(AgentSession agent) => agent.Status switch
    {
        AgentStatus.Waiting => 0,
        AgentStatus.Active => 1,
        _ => 2,
    };

    /// <summary>
    /// The background agents in this worktree that are not running.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The session registry only lists live processes, so a stopped agent is
    /// invisible to everything else in the dashboard. The CLI is the only thing
    /// that remembers them, and forgetting an agent you parked would make parking
    /// one a mistake.
    /// </para>
    /// <para>
    /// Derived on each render rather than filtered once when the list was
    /// fetched, because whether an agent is running is live state: an agent
    /// started a moment ago is in the CLI's list before it reaches the registry,
    /// and would otherwise sit in both lists until something refetched.
    /// </para>
    /// </remarks>
    private IReadOnlyList<BackgroundAgent> Parked
    {
        get
        {
            var live = View.Agents.Select(a => a.SessionId).ToHashSet(StringComparer.Ordinal);
            return _known
                .Where(a => !live.Contains(a.SessionId))
                .Where(a => IsUnder(a.Cwd, View.Worktree.Path))
                .ToList();
        }
    }

    private async Task LoadParked()
    {
        _work?.Cancel();
        _work?.Dispose();
        _work = new CancellationTokenSource();

        try
        {
            _known = await Cli.ListAsync(includeStopped: true, _work.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        Touch();
    }

    private static bool IsUnder(string path, string root) =>
        string.Equals(path, root, StringComparison.Ordinal)
        || path.StartsWith(root + "/", StringComparison.Ordinal)
        || path.StartsWith(root + Path.DirectorySeparatorChar, StringComparison.Ordinal);

    /// <summary>
    /// Reports what the start form did, then re-reads the parked list.
    /// </summary>
    /// <remarks>
    /// The form runs the CLI itself, so this is the tail of <see cref="Act"/>
    /// rather than another call: a start changes what is parked here, and waiting
    /// for the next poll to notice would read as nothing having happened.
    /// </remarks>
    private async Task OnStarted(CliResult result)
    {
        _failed = !result.Ok;
        _message = result.Message;
        Monitor.InvalidateWorktrees();
        await LoadParked();
    }

    private async Task Stop(string jobId) =>
        await Act(async () => await Cli.StopAsync(jobId));

    private async Task Respawn(string jobId) =>
        await Act(async () => await Cli.RespawnAsync(jobId));

    private async Task ToggleLogs(string jobId)
    {
        if (_logsFor == jobId)
        {
            _logsFor = null;
            _logs = "";
            Touch();
            return;
        }

        _logsFor = jobId;
        await LoadLogs(jobId);
    }

    /// <summary>
    /// Reads a session's recent output.
    /// </summary>
    /// <remarks>
    /// On a button rather than a tail: the CLI only serves the scrollback it
    /// already has, and polling a process every second to watch it is what
    /// <c>claude attach</c> is for. A failure here is ordinary rather than
    /// exceptional, so the CLI's own words are kept and shown.
    /// </remarks>
    private async Task LoadLogs(string jobId)
    {
        _logsBusy = true;
        Touch();

        CliResult result;
        try
        {
            result = await Cli.LogsAsync(jobId);
        }
        catch (Exception e) when (e is IOException or InvalidOperationException)
        {
            result = CliResult.Failed(e.Message);
        }

        _logsBusy = false;
        _logsFailed = !result.Ok;
        _logs = result.Message;
        Touch();
    }

    /// <summary>
    /// Puts the attach line on the clipboard.
    /// </summary>
    /// <remarks>
    /// Copied rather than run: attach is interactive and wants a terminal, which
    /// the dashboard does not have.
    /// </remarks>
    private async Task CopyAttach(string jobId)
    {
        if (!Clipboard.TryCopy(ClaudeCommands.AttachCommand(jobId)))
        {
            _failed = true;
            _message = "There is no clipboard tool on this machine to copy with.";
            Touch();
            return;
        }

        _copied = jobId;
        Touch();

        await Task.Delay(TimeSpan.FromSeconds(2));

        if (!_disposed && _copied == jobId)
        {
            _copied = null;
            Touch();
        }
    }

    private async Task Remove(string jobId) =>
        await Act(async () => await Cli.RemoveAsync(jobId));

    /// <summary>
    /// Runs one CLI action, then re-reads what changed.
    /// </summary>
    /// <remarks>
    /// Every action here starts or stops a process, so the registry and the parked
    /// list are both out of date the moment it returns. Refreshing both is what
    /// keeps the tab from showing a stale answer until the next poll.
    /// </remarks>
    private async Task Act(Func<Task<CliResult>> action)
    {
        _busy = true;
        _message = null;
        Touch();
        StateHasChanged();

        CliResult result;
        try
        {
            result = await action();
        }
        catch (Exception e) when (e is IOException or InvalidOperationException)
        {
            result = CliResult.Failed(e.Message);
        }

        _busy = false;
        _failed = !result.Ok;
        _message = result.Message;

        Monitor.InvalidateWorktrees();
        await LoadParked();
    }

    public void Dispose()
    {
        _disposed = true;
        _work?.Cancel();
        _work?.Dispose();
    }
}
