@using AgentsDashboard.App.Extensions
@using AgentsDashboard.Extensions
@inject ExtensionDialogs Dialogs
@implements IDisposable

@* The dialog an extension asked for with IDialogs, in the app's own frame, so
   every extension's dialogs look and behave alike and say who is asking. It
   is placed before the app's own prompts in the layout, which share the
   backdrop's layer, so an agent's request to add an extension or a secret
   request always lands on top of it. Clicking the backdrop does nothing: a
   form half filled in is not thrown away by a stray click. *@

@if (Dialogs.Front is ({ } open, var waiting))
{
    <div class="modal-backdrop" @key="open">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="ext-dialog-title" tabindex="-1"
             @ref="_dialogRef" @onkeydown="e => OnKey(e, open)">
            <header class="modal-head">
                <h2 id="ext-dialog-title">@open.Title</h2>
                <span class="chip" title="Asked by this extension">@open.Context.Info.Name</span>
                @if (waiting > 0)
                {
                    <span class="faint">@waiting more waiting</span>
                }
                <span class="spacer"></span>
                <button class="ghost small" aria-label="Close" title="Close (Escape)" @onclick="open.Cancel">Close</button>
            </header>

            <CascadingValue Value="open.Context" IsFixed="true">
                <CascadingValue Value="(DialogReference)open" IsFixed="true">
                    <ErrorBoundary @ref="_boundary">
                        <ChildContent>
                            <DynamicComponent Type="open.Component" Parameters="Parameters(open)" />
                        </ChildContent>
                        <ErrorContent Context="error">
                            <div class="banner danger">
                                <strong>This dialog failed.</strong>
                                <p class="mono muted" style="margin: 5px 0 8px;">@error.Message</p>
                                <button class="small" @onclick="() => _boundary?.Recover()">Retry</button>
                            </div>
                        </ErrorContent>
                    </ErrorBoundary>
                </CascadingValue>
            </CascadingValue>
        </div>
    </div>
}

@code {
    private ElementReference _dialogRef;
    private ErrorBoundary? _boundary;
    private ExtensionDialogs.Open? _focused;

    protected override void OnInitialized() => Dialogs.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    // A copy, since DynamicComponent keeps what it is handed.
    private static Dictionary<string, object?> Parameters(ExtensionDialogs.Open open) => new(open.Parameters);

    private void OnKey(KeyboardEventArgs e, ExtensionDialogs.Open open)
    {
        if (e.Key == "Escape")
        {
            open.Cancel();
        }
    }

    /// <remarks>
    /// Focus goes to the frame once per dialog, so Escape works before anything
    /// is clicked. A component that wants an input focused does it itself after
    /// its own first render, which comes after this. A failed focus is
    /// swallowed: a throw here ends the circuit.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var current = Dialogs.Front.Current;
        if (current is null || ReferenceEquals(current, _focused))
        {
            _focused = current;
            return;
        }

        _focused = current;
        try
        {
            await _dialogRef.FocusAsync();
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    public void Dispose() => Dialogs.Changed -= OnChanged;
}
