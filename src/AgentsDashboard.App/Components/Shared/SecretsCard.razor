@using AgentsDashboard.Core.Secrets
@using AgentsDashboard.Core.Presentation
@inject SecretBroker Secrets
@inject ExtensionHost Extensions
@inject AgentsDashboard.Core.Platform.IClock Clock
@implements IDisposable

@* Every secret by name, who may use it, and when they last did. The values
   stay in the OS store: nothing here shows one, and a value typed here goes
   straight into the store. *@

<div class="card">
    <div class="card-head">
        <h2>Secrets</h2>
        <span class="faint spacer">Kept in @Secrets.Vault.Description</span>
    </div>

    @if (!Secrets.Vault.Available)
    {
        <div class="row">
            <div class="banner danger" style="flex: 1;">
                There is no secret store on this machine the dashboard can use. On Linux, install
                <span class="mono">secret-tool</span> (libsecret) and a Secret Service such as GNOME Keyring.
            </div>
        </div>
    }

    @if (Secrets.Secrets.Count == 0)
    {
        <div class="row faint">
            <span>None yet. Add one below, or enter it when an extension first asks for it.</span>
        </div>
    }

    @foreach (var secret in Secrets.Secrets.OrderBy(s => s.Name, StringComparer.Ordinal))
    {
        var name = secret.Name;
        <div class="row ext-row">
            <div class="stack" style="flex: 1; min-width: 0;">
                <div class="inline">
                    <strong class="mono">@name</strong>
                    <span class="faint">added @Fmt.When(secret.Added, Clock.Now)</span>
                </div>
                @if (secret.Grants.Count == 0)
                {
                    <span class="faint">No extension has asked for it.</span>
                }
                @foreach (var grant in secret.Grants.OrderBy(g => g.ExtensionId, StringComparer.Ordinal))
                {
                    var extensionId = grant.ExtensionId;
                    <div class="inline" style="min-width: 0;">
                        <span class="truncate" style="flex: 1; min-width: 0;">
                            <strong>@ExtensionName(extensionId)</strong>
                            <span class="muted">@Describe(grant)</span>
                            @if (Stale(grant))
                            {
                                <span class="chip" title="Decided for an earlier build. The build running now will be asked again.">earlier build</span>
                            }
                            @if (grant.LastUsed is { } used)
                            {
                                <span class="faint">, last used @Fmt.When(used, Clock.Now)</span>
                            }
                            else if (!grant.Refused)
                            {
                                <span class="faint">, not used yet</span>
                            }
                        </span>
                        <button class="ghost small" @onclick="() => Secrets.Revoke(name, extensionId)"
                                title="@(grant.Refused ? "Forget the no; it will ask again" : "Take it back; it will have to ask again")">
                            @(grant.Refused ? "Forget" : "Revoke")
                        </button>
                    </div>
                }

                @if (_replacing == name)
                {
                    <div class="inline" style="margin-top: 6px;">
                        <input type="password" autocomplete="off" spellcheck="false" placeholder="New value"
                               aria-label="@($"New value of {name}")"
                               value="@_replacement" @oninput="e => _replacement = e.Value?.ToString() ?? string.Empty"
                               @onkeydown="e => OnReplaceKey(e, name)" />
                        <button class="primary small" disabled="@(_busy || _replacement.Length == 0)" @onclick="() => Replace(name)">Save</button>
                        <button class="ghost small" @onclick="CancelReplace">Cancel</button>
                    </div>
                }
                @if (_deleting == name)
                {
                    <div class="banner" style="margin-top: 8px;">
                        <strong>Delete @name?</strong>
                        <p class="muted" style="margin: 4px 0 6px;">
                            Its value is removed from @Secrets.Vault.Description, and every extension's permission with it.
                        </p>
                        <div class="inline">
                            <button class="primary small" disabled="@_busy" @onclick="() => Delete(name)">Delete</button>
                            <button class="ghost small" @onclick="() => _deleting = null">Cancel</button>
                        </div>
                    </div>
                }
            </div>
            <div class="inline" style="align-self: flex-start;">
                <button class="ghost small" @onclick="() => StartReplace(name)">Replace</button>
                <button class="ghost small" @onclick="() => { _deleting = name; _replacing = null; }">Delete</button>
            </div>
        </div>
    }

    <div class="card-head"><h2>Add a secret</h2></div>
    <div class="card-body">
        <div class="inline">
            <input type="text" placeholder="name, such as github or linear" autocomplete="off" spellcheck="false"
                   aria-label="Secret name" style="max-width: 16em;"
                   value="@_name" @oninput="e => _name = e.Value?.ToString()?.Trim() ?? string.Empty" />
            <input type="password" placeholder="value" autocomplete="off" spellcheck="false"
                   aria-label="Secret value"
                   value="@_newValue" @oninput="e => _newValue = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnAddKey" />
            <button class="primary" disabled="@(_busy || _name.Length == 0 || _newValue.Length == 0 || !Secrets.Vault.Available)"
                    @onclick="Add">Add</button>
        </div>
        @if (_error is { Length: > 0 })
        {
            <p class="faint" style="margin: 8px 0 0; color: var(--danger);">@_error</p>
        }
        <p class="faint" style="margin: 8px 0 0;">
            An extension asks for a secret by name, and you are asked before it gets it; your answer holds for
            that build of the extension. Where it can, the dashboard makes the extension's requests itself and
            adds the secret, so the extension never holds it. For Jira, store <span class="mono">email:token</span>.
            Agents never get these: not through the dashboard's tools, not in their environment.
        </p>
        <p class="faint" style="margin: 8px 0 0;">
            This is not a lock. Extensions run inside the dashboard as you, so any extension you have turned on
            could reach a secret without asking, and a program running as you, an agent's shell included, can
            start another copy of the dashboard or, on Windows and Linux, read the store directly. Asking keeps
            an extension that follows the rules to the secrets you meant it to have; what protects you is only
            turning on extensions you trust, and only running agents you would give your login to.
        </p>
    </div>
</div>

@code {
    private string _name = "";
    private string _newValue = "";
    private string? _error;
    private string? _replacing;
    private string _replacement = "";
    private string? _deleting;
    private bool _busy;

    protected override void OnInitialized()
    {
        Secrets.Changed += OnChanged;
        Extensions.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private string ExtensionName(string id) =>
        Extensions.Entries.FirstOrDefault(e => e.Found.Id == id)?.Found.Manifest?.Name ?? id;

    private bool Stale(SecretGrant grant) =>
        Extensions.LoadedHash(grant.ExtensionId) is { } running && running != grant.Hash;

    private static string Describe(SecretGrant grant) =>
        grant.Refused ? "was refused"
        : grant.Access == SecretAccess.Read ? "can read it"
        : $"can send it to {string.Join(", ", grant.Hosts)}";

    /// <summary>Stores run off the window's thread: the OS store can be slow, and on macOS may ask first.</summary>
    private async Task Add()
    {
        _busy = true;
        var (name, value) = (_name, _newValue);
        _error = Secrets.Exists(name)
            ? $"There is already a secret called {name}. Use Replace to change it."
            : await Task.Run(() => Secrets.Store(name, value));
        _busy = false;
        if (_error is null)
        {
            _name = "";
            _newValue = "";
        }
    }

    private async Task OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _name.Length > 0 && _newValue.Length > 0 && !_busy)
        {
            await Add();
        }
    }

    private void StartReplace(string name)
    {
        _replacing = name;
        _replacement = "";
        _deleting = null;
    }

    private void CancelReplace()
    {
        _replacing = null;
        _replacement = "";
    }

    private async Task Replace(string name)
    {
        _busy = true;
        var value = _replacement;
        _error = await Task.Run(() => Secrets.Store(name, value));
        _busy = false;
        if (_error is null)
        {
            CancelReplace();
        }
    }

    private async Task OnReplaceKey(KeyboardEventArgs e, string name)
    {
        if (e.Key == "Enter" && _replacement.Length > 0 && !_busy)
        {
            await Replace(name);
        }
        else if (e.Key == "Escape")
        {
            CancelReplace();
        }
    }

    private async Task Delete(string name)
    {
        _busy = true;
        _error = await Task.Run(() => Secrets.Delete(name));
        _busy = false;
        _deleting = null;
    }

    public void Dispose()
    {
        Secrets.Changed -= OnChanged;
        Extensions.Changed -= OnChanged;
    }
}
