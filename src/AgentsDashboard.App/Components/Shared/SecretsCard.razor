@using AgentsDashboard.Core.Secrets
@using AgentsDashboard.Core.Presentation
@using AgentsDashboard.Core.Extensions
@inject SecretBroker Secrets
@inject ExtensionHost Extensions
@inject AgentsDashboard.Core.Platform.IClock Clock
@implements IDisposable

@* Every secret by name, who may use it, and when they last did. The values
   stay in the OS store: nothing here shows one, and a value typed here goes
   straight into the store. *@

<div class="card">
    <div class="card-head">
        <h2>Secrets</h2>
        <span class="faint spacer">Kept in @Secrets.Vault.Description</span>
    </div>

    @if (!Secrets.Vault.Available)
    {
        <div class="row">
            <div class="banner danger" style="flex: 1;">
                There is no secret store on this machine the dashboard can use. On Linux, install
                <span class="mono">secret-tool</span> (libsecret) and a Secret Service such as GNOME Keyring.
            </div>
        </div>
    }

    @if (Secrets.Secrets.Count == 0)
    {
        <div class="row faint">
            <span>None yet. Add one below, or when an extension first asks for one.</span>
        </div>
    }

    @foreach (var secret in Secrets.Secrets.OrderBy(s => s.Name, StringComparer.Ordinal))
    {
        var name = secret.Name;
        <div class="row ext-row">
            <div class="stack" style="flex: 1; min-width: 0;">
                <div class="inline">
                    <strong class="mono">@name</strong>
                    <span class="faint">added @Fmt.When(secret.Added, Clock.Now)</span>
                </div>
                @{ var bindings = Secrets.Bindings.Where(b => b.Secret == name).OrderBy(b => b.ExtensionId, StringComparer.Ordinal).ToList(); }
                @if (bindings.Count == 0)
                {
                    <span class="faint">No extension is given it.</span>
                }
                @foreach (var binding in bindings)
                {
                    var (extensionId, need) = (binding.ExtensionId, binding.Need);
                    <div class="inline" style="min-width: 0;">
                        <span class="truncate" style="flex: 1; min-width: 0;">
                            <strong>@ExtensionName(extensionId)</strong>
                            <span class="muted">as <span class="mono">@need</span>, @SecretText.Scope(binding)</span>
                            @if (Stale(binding))
                            {
                                <span class="chip" title="Bound for an earlier build. The build running now will be asked again.">earlier build</span>
                            }
                            @if (binding.LastUsed is { } used)
                            {
                                <span class="faint">, last used @Fmt.When(used, Clock.Now)</span>
                            }
                            else
                            {
                                <span class="faint">, not used yet</span>
                            }
                        </span>
                        <button class="ghost small" @onclick="() => Secrets.Unbind(extensionId, need)"
                                title="Take it back; the extension will have to be given a secret again">Unbind</button>
                    </div>
                }

                @if (_replacing == name)
                {
                    <div class="inline" style="margin-top: 6px;">
                        <input type="password" autocomplete="off" spellcheck="false" placeholder="New value"
                               aria-label="@($"New value of {name}")"
                               value="@_replacement" @oninput="e => _replacement = e.Value?.ToString() ?? string.Empty"
                               @onkeydown="e => OnReplaceKey(e, name)" />
                        <button class="primary small" disabled="@(_busy || _replacement.Length == 0)" @onclick="() => Replace(name)">Save</button>
                        <button class="ghost small" @onclick="CancelReplace">Cancel</button>
                    </div>
                }
                @if (_deleting == name)
                {
                    <div class="banner" style="margin-top: 8px;">
                        <strong>Delete @name?</strong>
                        <p class="muted" style="margin: 4px 0 6px;">
                            Its value is removed from @Secrets.Vault.Description, and every extension's permission with it.
                        </p>
                        <div class="inline">
                            <button class="primary small" disabled="@_busy" @onclick="() => Delete(name)">Delete</button>
                            <button class="ghost small" @onclick="() => _deleting = null">Cancel</button>
                        </div>
                    </div>
                }
            </div>
            <div class="inline" style="align-self: flex-start;">
                <button class="ghost small" @onclick="() => StartReplace(name)">Replace</button>
                <button class="ghost small" @onclick="() => { _deleting = name; _replacing = null; }">Delete</button>
            </div>
        </div>
    }

    @* Every need an extension declares, known from its manifest before its
       code runs, and which of your secrets answers it. Binding here is the
       same approval as the prompt a first call puts up. *@
    <div class="card-head"><h2>What extensions need</h2></div>
    @{ var needing = Extensions.Entries.Where(e => e.Found.Manifest is { Secrets.Count: > 0 }).ToList(); }
    @if (needing.Count == 0)
    {
        <div class="row faint"><span>No extension declares a secret.</span></div>
    }
    @foreach (var entry in needing)
    {
        var found = entry.Found;
        var manifest = found.Manifest!;
        var hash = BuildHash(found);
        @foreach (var need in manifest.Secrets)
        {
            var key = $"{found.Id}/{need.Name}";
            var binding = Secrets.Binding(found.Id, need.Name);
            var current = binding is not null && binding.Hash == hash;
            <div class="row ext-row">
                <div class="stack" style="flex: 1; min-width: 0;">
                    <div class="inline">
                        <strong>@manifest.Name</strong>
                        <span class="mono">@need.Name</span>
                        <span class="faint">@SecretText.Scope(need)</span>
                    </div>
                    @if (need.Purpose is { Length: > 0 } purpose)
                    {
                        <span class="muted">@purpose</span>
                    }
                    <span class="faint">@NeedStatus(binding, current, hash)</span>
                </div>
                <div class="inline" style="align-self: flex-start;">
                    @if (hash is not null && Secrets.Secrets.Count > 0)
                    {
                        <Picker AriaLabel="@($"Secret for {manifest.Name}'s {need.Name}")" Class="setting-picker"
                                Placeholder="Choose a secret"
                                Value="@(_choices.GetValueOrDefault(key) ?? (current ? binding!.Secret : null))"
                                Options="@([.. Secrets.Secrets.OrderBy(x => x.Name, StringComparer.Ordinal).Select(x => new PickerOption(x.Name, x.Name))])"
                                ValueChanged="v => _choices[key] = v" />
                        <button class="small" disabled="@(_choices.GetValueOrDefault(key) is null)"
                                @onclick="() => Bind(found.Id, hash, need, key)">Bind</button>
                    }
                    @if (binding is not null)
                    {
                        <button class="ghost small" @onclick="() => Secrets.Unbind(found.Id, need.Name)"
                                title="@(binding.Refused ? "Forget the no; it will ask again" : "Take it back; it will ask again")">
                            @(binding.Refused ? "Forget" : "Unbind")
                        </button>
                    }
                </div>
            </div>
        }
    }

    <div class="card-head"><h2>Add a secret</h2></div>
    <div class="card-body">
        <div class="inline">
            <input type="text" placeholder="name, such as github or linear" autocomplete="off" spellcheck="false"
                   aria-label="Secret name" style="max-width: 16em;"
                   value="@_name" @oninput="e => _name = e.Value?.ToString()?.Trim() ?? string.Empty" />
            <input type="password" placeholder="value" autocomplete="off" spellcheck="false"
                   aria-label="Secret value"
                   value="@_newValue" @oninput="e => _newValue = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnAddKey" />
            <button class="primary" disabled="@(_busy || _name.Length == 0 || _newValue.Length == 0 || !Secrets.Vault.Available)"
                    @onclick="Add">Add</button>
        </div>
        @if (_error is { Length: > 0 })
        {
            <p class="faint" style="margin: 8px 0 0; color: var(--danger);">@_error</p>
        }
        <p class="faint" style="margin: 8px 0 0;">
            An extension can only ask for the secrets its extension.json declares, and gets none until you bind
            each to one of yours, above or when it first asks; the binding holds for that build of the extension.
            Your names and its names need not match. Where it can, the dashboard makes the extension's requests
            itself and adds the secret, so the extension never holds it, and only to the hosts it declared.
            For Jira, store <span class="mono">email:token</span>.
            Agents never get these: not through the dashboard's tools, not in their environment.
        </p>
        <p class="faint" style="margin: 8px 0 0;">
            This is not a lock. Extensions run inside the dashboard as you, so any extension you have turned on
            could reach a secret without asking, and a program running as you, an agent's shell included, can
            start another copy of the dashboard or, on Windows and Linux, read the store directly. Asking keeps
            an extension that follows the rules to the secrets you meant it to have; what protects you is only
            turning on extensions you trust, and only running agents you would give your login to.
        </p>
    </div>
</div>

@code {
    private string _name = "";
    private string _newValue = "";
    private string? _error;
    private string? _replacing;
    private string _replacement = "";
    private string? _deleting;
    private bool _busy;

    protected override void OnInitialized()
    {
        Secrets.Changed += OnChanged;
        Extensions.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private string ExtensionName(string id) =>
        Extensions.Entries.FirstOrDefault(e => e.Found.Id == id)?.Found.Manifest?.Name ?? id;

    private readonly Dictionary<string, string> _choices = [];

    private bool Stale(SecretBinding binding) =>
        Extensions.LoadedHash(binding.ExtensionId) is { } running && running != binding.Hash;

    /// <summary>
    /// The build a binding made here is for: the one running, or, when it is
    /// off, the one on disk, which is what will run when it is turned on. Null
    /// when it has not been built.
    /// </summary>
    private string? BuildHash(FoundExtension found) =>
        Extensions.LoadedHash(found.Id) ?? ExtensionCatalog.Hash(found);

    private static string NeedStatus(SecretBinding? binding, bool current, string? hash) =>
        hash is null ? "Not built yet, so there is no build to bind it for."
        : binding is null ? "Not bound. It gets nothing until you choose a secret."
        : binding.Refused ? (current ? "You said no for this build." : "You said no for an earlier build; this one will ask.")
        : current ? $"Gets your {binding.Secret}."
        : $"Got your {binding.Secret} for an earlier build; this one will ask, or bind it again here.";

    private async Task Bind(string extensionId, string hash, SecretNeed need, string key)
    {
        if (_choices.GetValueOrDefault(key) is not { } secret)
        {
            return;
        }

        _busy = true;
        _error = await Task.Run(() => Secrets.Bind(extensionId, hash, need, secret));
        _busy = false;
        if (_error is null)
        {
            _choices.Remove(key);
        }
    }

    /// <summary>Stores run off the window's thread: the OS store can be slow, and on macOS may ask first.</summary>
    private async Task Add()
    {
        _busy = true;
        var (name, value) = (_name, _newValue);
        _error = Secrets.Exists(name)
            ? $"There is already a secret called {name}. Use Replace to change it."
            : await Task.Run(() => Secrets.Store(name, value));
        _busy = false;
        if (_error is null)
        {
            _name = "";
            _newValue = "";
        }
    }

    private async Task OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _name.Length > 0 && _newValue.Length > 0 && !_busy)
        {
            await Add();
        }
    }

    private void StartReplace(string name)
    {
        _replacing = name;
        _replacement = "";
        _deleting = null;
    }

    private void CancelReplace()
    {
        _replacing = null;
        _replacement = "";
    }

    private async Task Replace(string name)
    {
        _busy = true;
        var value = _replacement;
        _error = await Task.Run(() => Secrets.Store(name, value));
        _busy = false;
        if (_error is null)
        {
            CancelReplace();
        }
    }

    private async Task OnReplaceKey(KeyboardEventArgs e, string name)
    {
        if (e.Key == "Enter" && _replacement.Length > 0 && !_busy)
        {
            await Replace(name);
        }
        else if (e.Key == "Escape")
        {
            CancelReplace();
        }
    }

    private async Task Delete(string name)
    {
        _busy = true;
        _error = await Task.Run(() => Secrets.Delete(name));
        _busy = false;
        _deleting = null;
    }

    public void Dispose()
    {
        Secrets.Changed -= OnChanged;
        Extensions.Changed -= OnChanged;
    }
}
