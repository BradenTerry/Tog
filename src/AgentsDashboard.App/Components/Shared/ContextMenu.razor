@inject IJSRuntime Js

@* A menu opened by a right click, at the pointer. A transparent layer over the
   window takes the next click or right click anywhere else and closes it, which
   is how a native menu behaves and needs no listener on the document. The menu
   is moved back inside the window once drawn, since only the page knows how
   big it came out. *@

<div class="context-backdrop" @onclick="Close" @oncontextmenu="Close" @oncontextmenu:preventDefault="true"></div>
<div class="context-menu" role="menu" tabindex="-1" style="@Position" @ref="_menu" @onkeydown="OnKey">
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public double X { get; set; }

    [Parameter, EditorRequired]
    public double Y { get; set; }

    /// <summary>The items: <c>button.context-item</c>, with <c>hr.context-sep</c> between groups.</summary>
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference _menu;

    private string Position => FormattableString.Invariant($"left: {X}px; top: {Y}px;");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Js.InvokeVoidAsync("agentsDashboard.fitMenu", _menu);
            }
            catch (JSException)
            {
                // Drawn where the pointer was, perhaps partly off screen.
            }
        }
    }

    private Task Close() => OnClose.InvokeAsync();

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
