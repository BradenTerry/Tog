@using AgentsDashboard.App.Extensions
@using AgentsDashboard.Extensions

@* An extension's view, drawn from a type the app only learned about at runtime.
   DynamicComponent rather than a route, because routes are fixed when the app
   starts and an extension can arrive later. The error boundary is what keeps a
   throwing view from ending the circuit, which in a one-window app is
   everything. *@

<CascadingValue Value="Live.Context" IsFixed="true">
    <ErrorBoundary @ref="_boundary">
        <ChildContent>
            <DynamicComponent Type="Live.View.Component" Parameters="Parameters" />
        </ChildContent>
        <ErrorContent Context="error">
            <div class="banner danger">
                <strong>@Live.View.Title failed.</strong>
                <p class="mono muted" style="margin: 5px 0 8px;">@error.Message</p>
                <button class="small" @onclick="() => _boundary?.Recover()">Retry</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public LiveView Live { get; set; } = default!;

    /// <summary>Null for a worktree view with no agent in its worktree.</summary>
    [Parameter]
    public AgentContext? Agent { get; set; }

    /// <summary>Set for a worktree view only.</summary>
    [Parameter]
    public WorktreeContext? Worktree { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    /// <summary>
    /// Built for an agent or worktree no longer on screen. A parked view is
    /// drawn once more to hear it is hidden, then left alone: its context is
    /// from when it was last shown, and re-rendering it every second for
    /// nobody is the cost parking is meant to avoid.
    /// </summary>
    [Parameter]
    public bool Parked { get; set; }

    private ErrorBoundary? _boundary;
    private bool _wasParked;

    protected override bool ShouldRender()
    {
        var skip = Parked && _wasParked;
        _wasParked = Parked;
        return !skip;
    }

    /// <summary>
    /// Only the parameters the view declares. DynamicComponent throws for one it
    /// does not have, and a view need not derive from AgentViewBase.
    /// </summary>
    private Dictionary<string, object?> Parameters
    {
        get
        {
            var parameters = new Dictionary<string, object?>();
            if (Declares(nameof(AgentViewBase.Agent)))
            {
                parameters[nameof(AgentViewBase.Agent)] = Agent;
            }

            if (Declares(nameof(WorktreeViewBase.Worktree)))
            {
                parameters[nameof(WorktreeViewBase.Worktree)] = Worktree;
            }

            if (Declares(nameof(AgentViewBase.IsVisible)))
            {
                parameters[nameof(AgentViewBase.IsVisible)] = IsVisible;
            }

            return parameters;
        }
    }

    private bool Declares(string name) =>
        Live.View.Component.GetProperty(name) is { } property
        && property.IsDefined(typeof(ParameterAttribute), inherit: true);
}
