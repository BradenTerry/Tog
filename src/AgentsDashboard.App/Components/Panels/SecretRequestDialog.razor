@using AgentsDashboard.Core.Secrets
@inject SecretBroker Secrets
@implements IDisposable

@* An extension asking for a secret. The call waits in the extension until
   this is answered, in whichever window you answer it. Allow and Don't allow
   are kept for this build of the extension, so the next call does not ask;
   Settings, Secrets forgets either. Not now, and Escape, keep nothing: the
   extension hears null and asks again next time. *@

@if (Secrets.Pending.FirstOrDefault() is { } request)
{
    if (request != _shown)
    {
        // Answered elsewhere, or a new one: what was typed was for the last.
        _shown = request;
        _value = "";
        _error = null;
    }

    var exists = Secrets.Exists(request.Name);
    <div class="modal-backdrop">
        <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="secret-request-title"
             aria-describedby="secret-request-body" tabindex="-1" @onkeydown="e => OnKey(e, request)">
            <header class="modal-head">
                <h2 id="secret-request-title">
                    @if (request.Access == SecretAccess.Brokered)
                    {
                        <span>@request.Caller.ExtensionName wants to use <span class="mono">@request.Name</span> with @request.Host</span>
                    }
                    else
                    {
                        <span>@request.Caller.ExtensionName asks for <span class="mono">@request.Name</span></span>
                    }
                </h2>
            </header>

            <div id="secret-request-body" class="wt-dialog-body">
                @if (request.Purpose is { Length: > 0 } purpose)
                {
                    <p>It says: <q>@purpose</q></p>
                }
                @if (request.Access == SecretAccess.Brokered)
                {
                    <p>
                        The dashboard adds it to the extension's requests to <span class="mono">@request.Host</span>,
                        over https, and gives the extension the responses. It never handles the secret itself,
                        though a host that echoes headers back would show it one.
                    </p>
                }
                else
                {
                    <p>The extension is handed the value, and can send it anywhere once it has it.</p>
                }
                @if (!exists)
                {
                    <p>There is no secret called <span class="mono">@request.Name</span> yet. Enter it to add it.</p>
                    <input type="password" autocomplete="off" spellcheck="false"
                           aria-label="@($"Value of {request.Name}")"
                           value="@_value" @oninput="e => _value = e.Value?.ToString() ?? string.Empty" />
                }
                <p class="faint">
                    Kept for this build of the extension (<span class="mono">@request.Caller.Hash[..12]</span>);
                    a rebuilt or updated one asks again. This is not a lock: an enabled extension runs inside the
                    dashboard as you and could reach any secret another way. It keeps an extension that follows the
                    rules to the secrets you meant it to have.
                </p>
                @if (_error is { Length: > 0 })
                {
                    <div class="banner danger">@_error</div>
                }
            </div>

            <div class="wt-dialog-foot">
                @if (Secrets.Pending.Count > 1)
                {
                    <span class="faint spacer">@(Secrets.Pending.Count - 1) more waiting</span>
                }
                <button class="ghost" @onclick="() => Dismiss(request)">Not now</button>
                <button class="ghost" @onclick="() => Refuse(request)" title="Kept for this build. Settings, Secrets forgets it.">Don't allow</button>
                <button class="primary" @onclick="() => Allow(request, exists)"
                        disabled="@(_busy || (!exists && _value.Length == 0))">
                    @(exists ? "Allow" : "Save and allow")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private SecretRequest? _shown;
    private string _value = "";
    private string? _error;
    private bool _busy;

    protected override void OnInitialized() => Secrets.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task Allow(SecretRequest request, bool exists)
    {
        _busy = true;
        var value = exists ? null : _value;

        // The OS store can take a moment, and on macOS may show its own prompt.
        _error = await Task.Run(() => Secrets.Allow(request, value));
        _busy = false;
        if (_error is null)
        {
            _value = "";
        }
    }

    private void Refuse(SecretRequest request)
    {
        _error = null;
        _value = "";
        Secrets.Refuse(request);
    }

    private void Dismiss(SecretRequest request)
    {
        _error = null;
        _value = "";
        Secrets.Dismiss(request);
    }

    private void OnKey(KeyboardEventArgs e, SecretRequest request)
    {
        if (e.Key == "Escape")
        {
            Dismiss(request);
        }
    }

    public void Dispose() => Secrets.Changed -= OnChanged;
}
