@inherits StateComponent
@inject WorktreeInventory Inventory
@inject WorktreeCleanup Cleanup
@inject MonitorService Monitor
@inject AgentHost Host
@inject IWebHostEnvironment Env
@inject Workbench Bench
@inject AgentDirectory Directory
@inject NavigationManager Nav

@* Every worktree of every repo, what each takes on disk, and whether it can go.
   Worktrees pile up: an agent finishes, its branch merges, and the checkout
   with its node_modules stays. This is where that becomes visible, and where it
   is cleaned up. Nothing here removes anything on its own: every action is a
   button, and every button opens a dialog that says what will happen first. *@

<div class="page wt-page">
    <div class="page-head"><h1>Worktrees</h1></div>
    <p class="page-sub">
        Every worktree of every repository, whether or not an agent is in it.
        @if (MeasuringNow is { } measuring)
        {
            <span>Measuring <span class="mono">@Fmt.Leaf(measuring)</span>@(PendingCount > 1 ? $", {PendingCount - 1} more to go" : "")...</span>
        }
        else if (OldestMeasure is { } oldest)
        {
            <span>Sizes measured @Fmt.When(oldest, Snapshot.Value.TakenAt).</span>
        }
        <button class="ghost small" @onclick="RemeasureAll" disabled="@(MeasuringNow is not null)">Measure again</button>
        <span class="wt-legend spacer" aria-label="Size bar key">
            <span><span class="wt-swatch project"></span>project files</span>
            <span><span class="wt-swatch changes"></span>changes</span>
            <span><span class="wt-swatch out"></span>ignored output</span>
        </span>
    </p>

    @if (_notice is { } notice)
    {
        <div class="banner @(notice.Ok ? "info" : "danger")">
            <div class="inline">
                <span style="white-space: pre-line;">@notice.Message</span>
                <button class="ghost small spacer" @onclick="() => _notice = null">Dismiss</button>
            </div>
        </div>
    }

    @{
        var rows = Rows();

        // The main checkouts are the repositories themselves: never removed here,
        // so they count toward none of the totals or the bar's scale.
        var linked = rows.Where(r => !r.View.Worktree.IsPrimary).ToList();
        var measured = linked.Where(r => r.Facts is not null).ToList();
        var safe = rows.Where(r => r.State == CleanupState.SafeToRemove).ToList();
        var bulk = safe.Where(r => !r.View.Worktree.Locked).ToList();
        var orphans = rows.Where(r => r.State == CleanupState.Orphaned).ToList();
        var largest = Math.Max(1, measured.Select(r => r.Facts!.TotalBytes).DefaultIfEmpty(0).Max());
    }

    <section class="wt-summary">
        <div class="wt-tile">
            <div class="wt-tile-label">Worktrees</div>
            <div class="wt-tile-value">@linked.Count</div>
            <div class="faint">across @Snapshot.Repos.Count @Fmt.Plural(Snapshot.Repos.Count, "repository", "repositories"), not counting main checkouts</div>
        </div>
        <div class="wt-tile">
            <div class="wt-tile-label">On disk</div>
            <div class="wt-tile-value">@Fmt.Bytes(measured.Sum(r => r.Facts!.TotalBytes))</div>
        </div>
        <div class="wt-tile good">
            <div class="wt-tile-label">Reclaimable now</div>
            <div class="wt-tile-value">@Fmt.Bytes(safe.Sum(r => r.Facts!.TotalBytes))</div>
            <div class="faint">@Fmt.Count(safe.Count, "worktree") with nothing unsaved</div>
        </div>
    </section>

    <div class="wt-toolbar">
        @FilterChip(null, "All", rows.Count)
        @foreach (var state in FilterStates)
        {
            var count = rows.Count(r => r.State == state);
            @if (count > 0)
            {
                @FilterChip(state, Label(state), count)
            }
        }
        <span class="spacer"></span>
        @if (orphans.Count > 0)
        {
            <button class="small" @onclick="() => OpenPrune(orphans)">Prune orphaned</button>
        }
        <button class="primary small" disabled="@(bulk.Count == 0)" @onclick="() => OpenBulk(bulk)"
                title="@(bulk.Count == 0 ? "Nothing is safe to remove right now" : "Pick which of these to remove")">
            Clean up merged (@Fmt.Bytes(bulk.Sum(r => r.Facts!.TotalBytes)))
        </button>
    </div>

    @if (Inventory.Leftovers is { Count: > 0 } leftovers)
    {
        <section class="card wt-repo wt-leftovers">
            <div class="card-head">
                <strong>Leftover folders</strong>
                <span class="faint spacer nums">@Fmt.Count(leftovers.Count, "folder") &middot; @Fmt.Bytes(leftovers.Sum(l => l.Bytes))</span>
            </div>
            <p class="wt-leftover-note">
                Folders where a worktree was that git no longer lists. Usually a removal that could not finish because
                another program had something in the folder open. Nothing deletes them on its own.
            </p>
            @foreach (var leftover in leftovers)
            {
                <div class="wt-leftover">
                    <span class="mono truncate" title="@leftover.Path">@leftover.Path</span>
                    <span class="faint nums">@Fmt.Count(leftover.Files, "file") &middot; @Fmt.Bytes(leftover.Bytes)</span>
                    <button class="small" @onclick="() => OpenLeftover(leftover)">Delete...</button>
                </div>
            }
        </section>
    }

    @if (Snapshot.Repos.Count == 0)
    {
        <div class="empty">
            <h2>No repositories yet</h2>
            <p>Add one in Settings, or start an agent, and its worktrees show up here.</p>
        </div>
    }

    @foreach (var repo in Snapshot.Repos)
    {
        var repoRows = rows.Where(r => r.Repo.Root == repo.Root && (_filter is null || r.State == _filter)).ToList();
        @if (repoRows.Count == 0)
        {
            continue;
        }

        var repoLinked = linked.Where(r => r.Repo.Root == repo.Root).ToList();
        var repoBytes = repoLinked.Where(r => r.Facts is not null).Sum(r => r.Facts!.TotalBytes);
        <section class="card wt-repo">
            <div class="card-head">
                <strong>@repo.Name</strong>
                <span class="mono faint truncate">@repo.Root</span>
                <span class="faint spacer nums">@Fmt.Count(repoLinked.Count, "worktree") &middot; @Fmt.Bytes(repoBytes)</span>
            </div>
            <div class="wt-row wt-head" aria-hidden="true">
                <span></span><span>Worktree</span><span>State</span><span>Git</span><span>Last activity</span><span>Size</span><span></span>
            </div>
            @foreach (var row in repoRows)
            {
                @RowView((row, largest))
            }
        </section>
    }
</div>

@if (_dialog is { } dialog)
{
    <div class="modal-backdrop" @onclick="CloseDialog">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="wt-dialog-title" tabindex="-1"
             @ref="_dialogRef" @onclick:stopPropagation @onkeydown="OnDialogKey">
            @switch (dialog.Kind)
            {
                case DialogKind.Remove:
                    @RemoveDialog(dialog)
                    break;
                case DialogKind.Bulk:
                    @BulkDialog(dialog)
                    break;
                case DialogKind.Prune:
                    @PruneDialog(dialog)
                    break;
                case DialogKind.Agents:
                    @AgentsDialog(dialog)
                    break;
                case DialogKind.Leftover:
                    @LeftoverDialog(dialog)
                    break;
            }
        </div>
    </div>
}

@code {
    private static readonly CleanupState[] FilterStates =
    [
        CleanupState.SafeToRemove, CleanupState.HasWork, CleanupState.NotMerged,
        CleanupState.AgentRunning, CleanupState.Orphaned,
    ];

    private CleanupState? _filter;
    private readonly HashSet<string> _open = new(StringComparer.Ordinal);
    private Notice? _notice;
    private Dialog? _dialog;
    private ElementReference _dialogRef;
    private bool _focusDialog;
    private ElementReference _confirmRef;
    private bool _focusConfirm;

    private sealed record Notice(bool Ok, string Message);

    /// <summary>One worktree, with what is known about it, as a row draws it.</summary>
    private sealed record Row(
        RepoView Repo,
        WorktreeView View,
        WorktreeFacts? Facts,
        CleanupState State,
        DateTimeOffset? LastActive,
        IReadOnlyList<HostedAgent> Parked);

    private enum DialogKind { Remove, Bulk, Prune, Agents, Leftover }

    private sealed class Dialog(DialogKind kind)
    {
        public DialogKind Kind { get; } = kind;
        public Row? Target { get; init; }
        public LeftoverFolder? Leftover { get; init; }
        public List<Row> Rows { get; init; } = [];
        public HashSet<string> Picked { get; init; } = new(StringComparer.Ordinal);
        public bool DeleteBranch { get; set; }
        public bool ForgetAgents { get; set; } = true;
        public string Typed { get; set; } = "";
        public IReadOnlyList<string>? LostFiles { get; set; }
        public IReadOnlyList<string>? LostCommits { get; set; }
        public bool Busy { get; set; }
        public string? Error { get; set; }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Inventory.Changed += OnInventoryChanged;
        State.Changed += OnSnapshot;
        Bench.Changed += OnBench;

        // Opening the view is when stale sizes are worth measuring again. After
        // that only worktrees never measured are, as they appear.
        Inventory.Refresh(Snapshot.Repos, Remeasure.Stale);
        ScanLeftovers(force: true);
        _ = TakeRemoveRequest();
    }

    private void OnBench() => _ = InvokeAsync(TakeRemoveRequest);

    /// <summary>
    /// The agent list's "Remove" lands here: it opens this tab with the worktree
    /// named, and the same dialog as the row's button comes up, so the offer
    /// never removes anything without the dialog in between.
    /// </summary>
    private async Task TakeRemoveRequest()
    {
        if (Bench.RemoveRequest is not { } path)
        {
            return;
        }

        Bench.RemoveRequest = null;
        if (Rows().FirstOrDefault(r => r.View.Worktree.Path == path) is { } row
            && Removable(row.State))
        {
            await OpenRemove(row);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Whether Remove is offered. A running agent does not stop it: the dialog
    /// says which agents it stops first. The main checkout, the dashboard's own
    /// worktree and one not measured yet are the exceptions.
    /// </summary>
    private static bool Removable(CleanupState state) =>
        state is CleanupState.SafeToRemove or CleanupState.NotMerged or CleanupState.HasWork or CleanupState.AgentRunning;

    /// <summary>
    /// The agents in a worktree, running or stopped, as the agent list shows
    /// them: working and waiting first, then the rest, most recent first.
    /// </summary>
    private IReadOnlyList<ChatTarget> AgentsIn(Row row) =>
        Directory.Targets(Snapshot.Value)
            .Where(t => t.WorktreePath == row.View.Worktree.Path)
            .OrderBy(t => t.State is ChatState.Parked or ChatState.Failed)
            .ThenByDescending(t => t.Since)
            .ToList();

    private static string AgentName(AgentSession agent) => agent.Summary ?? agent.Name ?? agent.SessionId[..8];

    private void OnInventoryChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnSnapshot()
    {
        Inventory.Refresh(State.Snapshot.Repos, Remeasure.Missing);
        ScanLeftovers(force: false);
    }

    private void RemeasureAll()
    {
        Inventory.Refresh(Snapshot.Repos, Remeasure.All);
        ScanLeftovers(force: true);
    }

    private string? _scannedFor;

    /// <summary>
    /// Looks for leftover folders when the page opens, when asked to measure
    /// again, and whenever the worktrees git lists change: a removal that left a
    /// folder shows it on the snapshot after git stopped listing the worktree,
    /// not on the one before, which still has it.
    /// </summary>
    private void ScanLeftovers(bool force)
    {
        var repos = State.Snapshot.Repos;
        var worktrees = string.Join('\n', repos.SelectMany(r => r.Worktrees).Select(w => w.Worktree.Path).Order(StringComparer.Ordinal));
        if (force || worktrees != _scannedFor)
        {
            _scannedFor = worktrees;
            Inventory.ScanLeftovers(repos);
        }
    }

    private string? MeasuringNow => Inventory.Measuring;

    private int PendingCount =>
        Snapshot.Repos.SelectMany(r => r.Worktrees).Count(w => Inventory.Pending(w.Worktree.Path));

    private DateTimeOffset? OldestMeasure =>
        Snapshot.Repos.SelectMany(r => r.Worktrees)
            .Select(w => Inventory.Facts(w.Worktree.Path)?.MeasuredAt)
            .Where(t => t is not null)
            .Min();

    /// <summary>
    /// The directories the dashboard runs from. A worktree holding either is
    /// never offered for removal: the app would be deleting itself.
    /// </summary>
    private IEnumerable<string> OwnDirectories => [Env.ContentRootPath, AppContext.BaseDirectory];

    private List<Row> Rows()
    {
        var hosted = Host.Agents;
        var rows = new List<Row>();

        foreach (var repo in Snapshot.Repos)
        {
            var paths = repo.Worktrees.Select(w => w.Worktree.Path).ToList();
            foreach (var view in repo.Worktrees)
            {
                var path = view.Worktree.Path;
                var facts = Inventory.Facts(path);
                var hostsDashboard = OwnDirectories.Any(d => Owner(d, paths) == path);
                var state = WorktreeCleanup.Classify(view.Worktree, facts, view.Agents.Count > 0, hostsDashboard);

                // Stopped agents are kept on the agent list; once their worktree is
                // gone they cannot be resumed there, so removing offers to forget them.
                var parked = hosted.Where(a => a.State == HostedState.Stopped && Owner(a.Cwd, paths) == path).ToList();

                DateTimeOffset?[] times =
                [
                    facts?.LastCommitAt,
                    view.Agents.Select(a => (DateTimeOffset?)a.LastActivity).Max(),
                    hosted.Where(a => Owner(a.Cwd, paths) == path).Select(a => (DateTimeOffset?)a.StateSince).Max(),
                ];

                rows.Add(new Row(repo, view, facts, state, times.Max(), parked));
            }
        }

        // The primary last: it is there for reference, not for cleaning. The rest
        // largest first, since that is where the space is.
        return rows
            .OrderBy(r => r.View.Worktree.IsPrimary)
            .ThenByDescending(r => r.Facts?.TotalBytes ?? -1)
            .ToList();
    }

    /// <summary>The worktree a directory belongs to: the deepest one it is under, as the monitor places agents.</summary>
    private static string? Owner(string directory, IReadOnlyList<string> worktrees)
    {
        return worktrees
            .Where(w => AgentsDashboard.Core.Repos.RealPaths.IsUnder(directory, w))
            .MaxBy(w => w.Length);
    }

    private static string Label(CleanupState state) => state switch
    {
        CleanupState.Checking => "Measuring",
        CleanupState.Primary => "Main checkout",
        CleanupState.Dashboard => "Runs the dashboard",
        CleanupState.Orphaned => "Orphaned",
        CleanupState.AgentRunning => "Agent running",
        CleanupState.HasWork => "Has work",
        CleanupState.NotMerged => "Not merged",
        CleanupState.SafeToRemove => "Safe to remove",
        _ => "Unknown",
    };

    private static string PillClass(CleanupState state) => state switch
    {
        CleanupState.SafeToRemove => "active",
        CleanupState.HasWork => "waiting",
        CleanupState.AgentRunning => "accent",
        CleanupState.Orphaned => "danger",
        _ => "",
    };

    /// <summary>Why a worktree is in the state it is, in a sentence, for the row's detail.</summary>
    private static string Why(Row row) => row.State switch
    {
        CleanupState.Primary => "The repository's main checkout, shown for reference. It is never removed here.",
        CleanupState.Dashboard => "The dashboard is running from this worktree, so it is not offered for removal.",
        CleanupState.Orphaned => "The folder was deleted outside git. Git still lists it and still holds its branch, so that branch cannot be checked out anywhere else until it is pruned.",
        CleanupState.AgentRunning => "An agent is working here. Removing the worktree stops it first, so it is not left working in a folder that is gone.",
        CleanupState.HasWork => "There is work here that exists nowhere else. Removing it would lose that work, so push or commit it first, or remove it knowingly.",
        CleanupState.NotMerged => "Clean, and every commit is on a remote, so removing it loses nothing. Its branch is not merged yet, so it is not included in bulk cleanup.",
        CleanupState.SafeToRemove => row.Facts?.Merge switch
        {
            MergeState.NoOwnCommits => "Clean, and it never had commits of its own. Nothing would be lost.",
            MergeState.SquashMerged => $"Clean, and {row.Facts.Base} already has its changes (squash or rebase merged). Nothing would be lost.",
            _ => $"Clean, and merged into {row.Facts?.Base}. Nothing would be lost.",
        },
        CleanupState.Checking => "Being measured.",
        _ => row.Facts?.Error ?? "Git could not be asked about this worktree.",
    };

    private RenderFragment FilterChip(CleanupState? state, string label, int count) => __builder =>
    {
        <button type="button" class="wt-filter @(_filter == state ? "on" : "")" aria-pressed="@(_filter == state ? "true" : "false")"
                @onclick="() => _filter = state">
            @label <span class="faint nums">@count</span>
        </button>
    };

    private RenderFragment GitFacts(Row row) => __builder =>
    {
        var facts = row.Facts;
        if (row.View.Worktree.Prunable)
        {
            <span class="faint">directory missing</span>
            return;
        }

        if (facts?.Status is not { } status)
        {
            <span class="faint">@(Inventory.Pending(row.View.Worktree.Path) ? "measuring..." : facts?.Error ?? "")</span>
            return;
        }

        if (status.IsClean)
        {
            <span>clean</span>
        }
        else
        {
            <span class="wt-warn">@Fmt.Changes(status)</span>
        }

        if (facts.OnlyHere > 0 && facts.Merge != MergeState.SquashMerged)
        {
            <span> &middot; </span><span class="wt-warn">@Fmt.Count(facts.OnlyHere, "commit") only here</span>
        }

        if (!row.View.Worktree.IsPrimary)
        {
            <span> &middot; </span>
            @switch (facts.Merge)
            {
                case MergeState.Merged:
                    <span class="wt-ok">merged into @facts.Base</span>
                    break;
                case MergeState.SquashMerged:
                    <span class="wt-ok">in @facts.Base (squashed)</span>
                    break;
                case MergeState.NoOwnCommits:
                    <span>no commits of its own</span>
                    break;
                case MergeState.NotMerged:
                    <span>not merged</span>
                    break;
            }
        }
    };

    private RenderFragment RowView((Row Row, long Largest) args) => __builder =>
    {
        var row = args.Row;
        var wt = row.View.Worktree;
        var facts = row.Facts;
        var open = _open.Contains(wt.Path);
        var canRemove = Removable(row.State);

        <div class="wt-row @(open ? "open" : "") @(wt.Prunable ? "orphan" : "")" @key="wt.Path">
            <button type="button" class="icon-btn wt-caret" aria-expanded="@(open ? "true" : "false")" aria-label="Details for @wt.Name"
                    @onclick="() => Toggle(wt.Path)">
                <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                    <path d="@(open ? "M4 6l4 4 4-4" : "M6 4l4 4-4 4")" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <div class="stack wt-who">
                <span class="mono truncate wt-name" title="@wt.Path">@wt.Name</span>
                <span class="faint truncate wt-branch">
                    @(wt.Branch ?? (wt.Detached ? "detached HEAD" : ""))
                    @if (wt.Locked)
                    {
                        <span class="wt-tag" title="@(wt.LockReason ?? "Locked")">locked</span>
                    }
                </span>
            </div>
            <span class="wt-state"><span class="chip @PillClass(row.State)">@Label(row.State)</span></span>
            <span class="wt-facts truncate">@GitFacts(row)</span>
            <span class="faint wt-when">@(row.LastActive is { } at ? Fmt.When(at, Snapshot.Value.TakenAt) : "")</span>
            <div class="wt-size">
                @if (wt.IsPrimary && facts is { TotalBytes: > 0 })
                {
                    <span class="nums faint" title="The repository itself, not counted in the totals">@Fmt.Bytes(facts.TotalBytes), not counted</span>
                }
                else if (facts is { TotalBytes: > 0 })
                {
                    <span class="nums wt-size-label" title="@SizeTitle(facts)">
                        <span>@Fmt.Bytes(facts.TotalBytes)</span>
                        @if (facts.ChangesBytes > 0 || facts.Changes.Count > 0)
                        {
                            <span class="wt-changes">changes @Fmt.Bytes(facts.ChangesBytes)</span>
                        }
                    </span>
                    <div class="wt-bar" aria-hidden="true">
                        <span class="project" style="width: @Pct(facts.ProjectBytes, args.Largest)"></span>
                        <span class="changes" style="width: @Pct(facts.ChangesBytes, args.Largest)"></span>
                        <span class="out" style="width: @Pct(facts.OutputBytes, args.Largest)"></span>
                    </div>
                }
                else if (!wt.Prunable)
                {
                    <span class="faint">@(Inventory.Pending(wt.Path) ? "measuring..." : "")</span>
                }
            </div>
            <div class="wt-actions">
                @if (row.State == CleanupState.Orphaned)
                {
                    <button class="small" @onclick="() => OpenPrune([row])">Prune</button>
                }
                else
                {
                    @if (AgentsIn(row) is { Count: > 0 } agents)
                    {
                        <button class="small" @onclick="() => Show(new Dialog(DialogKind.Agents) { Target = row })"
                                title="The agents in this worktree">Agents (@agents.Count)</button>
                    }
                    <button class="small" @onclick="() => Bench.OpenNewAgent(row.Repo.Root, wt.Path)"
                            title="Start a new agent in this worktree">New agent</button>
                    @if (!wt.IsPrimary && row.State != CleanupState.Dashboard)
                    {
                        <button class="small" disabled="@(!canRemove)" @onclick="() => OpenRemove(row)"
                                title="@(canRemove ? "Remove this worktree" : Why(row))">Remove</button>
                    }
                }
            </div>

            @if (open)
            {
                <div class="wt-detail">
                    <div>
                        <h4>@Label(row.State)</h4>
                        <p>@Why(row)</p>
                        @if (wt.Locked)
                        {
                            <p>Locked@(wt.LockReason is { Length: > 0 } reason ? $": {reason}" : ""). Removing unlocks it first.</p>
                        }
                        @if (row.View.Agents.Count > 0)
                        {
                            <p>Working here: @string.Join(", ", row.View.Agents.Select(AgentName))</p>
                        }
                        @if (row.Parked.Count > 0)
                        {
                            <p>@Fmt.Count(row.Parked.Count, "stopped agent") on the agent list.</p>
                        }
                        <p class="mono faint">@wt.Path</p>
                    </div>
                    <div>
                        <h4>Where the space is</h4>
                        @if (facts is null)
                        {
                            <p class="faint">Not measured yet.</p>
                        }
                        else
                        {
                            @* Three parts that add up to the total. The changes first, since
                               they are what makes this worktree differ from any other; the
                               project's files last, since every worktree of the repo has them. *@
                            <h5 class="wt-part"><span class="wt-swatch changes"></span>Changes
                                <span class="spacer nums">@Fmt.Bytes(facts.ChangesBytes)</span></h5>
                            @if (facts.Changes.Count == 0)
                            {
                                <p class="faint">None: it matches its last commit.</p>
                            }
                            else
                            {
                                <div class="wt-kv wt-files">
                                    @foreach (var change in facts.Changes.Take(10))
                                    {
                                        <span class="wt-kind k-@change.Kind" title="@KindName(change.Kind)">@change.Kind</span>
                                        <span class="mono truncate" title="@change.Path">@change.Path</span>
                                        <span class="nums">@(change.Kind == 'D' ? "" : Fmt.Bytes(change.Bytes))</span>
                                    }
                                    @if (facts.Changes.Count > 10)
                                    {
                                        <span></span>
                                        <span class="faint">@(facts.Changes.Count - 10) more @Fmt.Plural(facts.Changes.Count - 10, "file", "files")</span>
                                        <span class="nums faint">@Fmt.Bytes(facts.Changes.Skip(10).Sum(c => c.Bytes))</span>
                                    }
                                </div>
                            }

                            <h5 class="wt-part"><span class="wt-swatch out"></span>Ignored output
                                <span class="spacer nums">@Fmt.Bytes(facts.OutputBytes)</span></h5>
                            @if (facts.Output.Count(o => o.Bytes > 0) == 0)
                            {
                                <p class="faint">None.</p>
                            }
                            else
                            {
                                <div class="wt-kv">
                                    @foreach (var entry in facts.Output.Where(o => o.Bytes > 0).Take(6))
                                    {
                                        <span class="mono truncate" title="@entry.Path">@entry.Path</span>
                                        <span class="nums">@Fmt.Bytes(entry.Bytes)</span>
                                    }
                                </div>
                            }

                            <h5 class="wt-part"><span class="wt-swatch project"></span>Project files
                                <span class="spacer nums">@Fmt.Bytes(facts.ProjectBytes)</span></h5>
                            <p class="faint">The checked-out files, unchanged: what any worktree of @row.Repo.Name takes.</p>
                            <div class="wt-kv">
                                @foreach (var entry in facts.Top.Take(6))
                                {
                                    <span class="mono truncate" title="@entry.Path">@entry.Path</span>
                                    <span class="nums">@Fmt.Bytes(entry.Bytes)</span>
                                }
                                @if (facts.Top.Count > 6)
                                {
                                    <span class="faint">@(facts.Top.Count - 6) more @Fmt.Plural(facts.Top.Count - 6, "entry", "entries")</span>
                                    <span class="nums faint">@Fmt.Bytes(facts.Top.Skip(6).Sum(t => t.Bytes))</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    };

    private static string SizeTitle(WorktreeFacts facts) =>
        $"Project files {Fmt.Bytes(facts.ProjectBytes)}, changes {Fmt.Bytes(facts.ChangesBytes)}, ignored output {Fmt.Bytes(facts.OutputBytes)}";

    private static string KindName(char kind) => kind switch
    {
        'M' => "Modified",
        'A' => "Added",
        'D' => "Deleted",
        'R' => "Renamed",
        'U' => "Untracked",
        _ => "Conflicted",
    };

    private static string Pct(long part, long whole) =>
        FormattableString.Invariant($"{Math.Clamp(part * 100.0 / whole, 0, 100):0.##}%");

    private void Toggle(string path)
    {
        if (!_open.Remove(path))
        {
            _open.Add(path);
        }
    }

    // ---------- dialogs ----------

    private void Show(Dialog dialog)
    {
        _dialog = dialog;
        _focusDialog = true;
    }

    private void CloseDialog()
    {
        if (_dialog is { Busy: false })
        {
            _dialog = null;
        }
    }

    private void OnDialogKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseDialog();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDialog && _dialog is not null)
        {
            _focusDialog = false;
            await _dialogRef.FocusAsync();
        }

        if (_focusConfirm && _dialog is not null)
        {
            _focusConfirm = false;
            await _confirmRef.FocusAsync();
        }
    }

    private async Task OpenRemove(Row row)
    {
        var dialog = new Dialog(DialogKind.Remove)
        {
            Target = row,
            DeleteBranch = row.State == CleanupState.SafeToRemove && row.View.Worktree.Branch is not null,
        };
        Show(dialog);

        // Read fresh for a running agent too: it may have changed files since the
        // worktree was measured, and the dialog must list what would be lost now.
        if (row.State is CleanupState.HasWork or CleanupState.AgentRunning)
        {
            var (files, commits) = await Cleanup.LossesAsync(row.View.Worktree.Path, row.Facts?.Base);
            dialog.LostFiles = files;
            dialog.LostCommits = commits;
        }

        // The name box only appears once the read is back, after the dialog took
        // focus, so it is focused then: typing the name is the one thing to do.
        _focusConfirm = _dialog == dialog && Loses(dialog);
    }

    private void OpenBulk(List<Row> rows) => Show(new Dialog(DialogKind.Bulk)
    {
        Rows = rows,
        Picked = rows.Select(r => r.View.Worktree.Path).ToHashSet(StringComparer.Ordinal),
        DeleteBranch = true,
    });

    private void OpenPrune(List<Row> rows) => Show(new Dialog(DialogKind.Prune) { Rows = rows });

    private static void Pick(Dialog dialog, string key, bool on)
    {
        if (on)
        {
            dialog.Picked.Add(key);
        }
        else
        {
            dialog.Picked.Remove(key);
        }
    }

    /// <summary>
    /// Removes one worktree. The branch goes with it only when asked, and is
    /// deleted past git's merged check only when that check cannot see the
    /// merge (a squash) or when the dialog already made you confirm the loss.
    /// </summary>
    /// <summary>
    /// Removes one worktree, stopping any agent working in it first. The branch
    /// goes with it only when asked, and is deleted past git's merged check only
    /// when that check cannot see the merge (a squash) or when the dialog already
    /// made you confirm the loss.
    /// </summary>
    private async Task<CleanupResult> Remove(Row row, bool force, bool deleteBranch, bool forgetAgents)
    {
        foreach (var agent in row.View.Agents)
        {
            await Host.StopAsync(agent.SessionId);
        }

        var result = await Cleanup.RemoveAsync(
            row.Repo.Root,
            row.View.Worktree,
            force: force,
            deleteBranch: deleteBranch,
            forceBranch: force || row.Facts?.Merge == MergeState.SquashMerged);

        if (result.Ok)
        {
            Inventory.Forget(row.View.Worktree.Path);
            if (forgetAgents)
            {
                foreach (var id in row.Parked.Select(a => a.SessionId).Concat(row.View.Agents.Select(a => a.SessionId)))
                {
                    await Host.RemoveAsync(id);
                }
            }
        }

        return result;
    }

    /// <summary>Whether removing the dialog's worktree loses work: known from its state, or found when the dialog read it fresh.</summary>
    private static bool Loses(Dialog dialog) =>
        dialog.Target!.State == CleanupState.HasWork
        || dialog.LostFiles is { Count: > 0 }
        || dialog.LostCommits is { Count: > 0 };

    private async Task Run(Dialog dialog, Func<Task<Notice>> work)
    {
        dialog.Busy = true;
        dialog.Error = null;
        try
        {
            _notice = await work();
            _dialog = null;
        }
        catch (Exception e)
        {
            dialog.Error = e.Message;
        }
        finally
        {
            dialog.Busy = false;
            Monitor.InvalidateWorktrees();
        }
    }

    private Task ConfirmRemove(Dialog dialog) => Run(dialog, async () =>
    {
        var result = await Remove(dialog.Target!, Loses(dialog), dialog.DeleteBranch, dialog.ForgetAgents);
        if (!result.Ok)
        {
            throw new InvalidOperationException(result.Message);
        }

        // Removed, but with a folder left on disk: said as a problem, not a success.
        return new Notice(result.Leftover is null, result.Message);
    });

    private Task ConfirmBulk(Dialog dialog) => Run(dialog, async () =>
    {
        var done = new List<string>();
        var problems = new List<string>();
        long freed = 0;
        foreach (var row in dialog.Rows.Where(r => dialog.Picked.Contains(r.View.Worktree.Path)))
        {
            var result = await Remove(row, force: false, dialog.DeleteBranch, dialog.ForgetAgents);
            if (result.Ok)
            {
                freed += (row.Facts?.TotalBytes ?? 0) - (result.Leftover?.Bytes ?? 0);
            }

            if (result.Ok && result.Leftover is null)
            {
                done.Add(result.Message);
            }
            else
            {
                problems.Add(result.Ok ? result.Message : $"{row.View.Worktree.Name}: {result.Message}");
            }
        }

        // Anything that went wrong comes first, where it is read: a summary that
        // opens with the space freed reads as a success.
        List<string> lines = problems.Count == 0
            ? [$"Freed about {Fmt.Bytes(freed)}.", .. done]
            : [$"{Fmt.Count(problems.Count, "worktree")} did not come off cleanly:", .. problems, "", $"Freed about {Fmt.Bytes(freed)}.", .. done];
        return new Notice(problems.Count == 0, string.Join('\n', lines));
    });

    private Task ConfirmPrune(Dialog dialog) => Run(dialog, async () =>
    {
        var lines = new List<string>();
        foreach (var root in dialog.Rows.Select(r => r.Repo.Root).Distinct(StringComparer.Ordinal))
        {
            var result = await Cleanup.PruneAsync(root);
            lines.Add(result.Ok ? $"Pruned {Fmt.Leaf(root)}." : $"{Fmt.Leaf(root)}: {result.Message}");
        }

        foreach (var row in dialog.Rows)
        {
            Inventory.Forget(row.View.Worktree.Path);
        }

        return new Notice(true, string.Join('\n', lines));
    });

    private void OpenLeftover(LeftoverFolder leftover) => Show(new Dialog(DialogKind.Leftover) { Leftover = leftover });

    private Task ConfirmLeftover(Dialog dialog) => Run(dialog, async () =>
    {
        var result = await Cleanup.DeleteLeftoverAsync(dialog.Leftover!);
        ScanLeftovers(force: true);
        if (!result.Ok)
        {
            throw new InvalidOperationException(result.Message);
        }

        return new Notice(true, result.Message);
    });

    private RenderFragment DialogHead(string title) => __builder =>
    {
        <header class="modal-head">
            <h2 id="wt-dialog-title">@title</h2>
            <button type="button" class="icon-btn spacer" @onclick="CloseDialog" title="Close" aria-label="Close">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </button>
        </header>
    };

    private RenderFragment DialogError(Dialog dialog) => __builder =>
    {
        if (dialog.Error is { } error)
        {
            <div class="banner danger">@error</div>
        }
    };

    private RenderFragment ForgetOption(Dialog dialog, int count) => __builder =>
    {
        if (count > 0)
        {
            <label class="wt-option">
                <input type="checkbox" checked="@dialog.ForgetAgents" @onchange="e => dialog.ForgetAgents = e.Value is true" />
                <span>
                    Take @Fmt.Count(count, "agent") in it off the agent list
                    <small>Their conversations stay saved, and New agent can resume them.</small>
                </span>
            </label>
        }
    };

    private RenderFragment RemoveDialog(Dialog dialog) => __builder =>
    {
        var row = dialog.Target!;
        var wt = row.View.Worktree;
        var running = row.View.Agents;
        var reading = row.State is CleanupState.HasWork or CleanupState.AgentRunning && dialog.LostFiles is null;
        var hasWork = Loses(dialog);
        var confirmed = !reading && (!hasWork || dialog.Typed.Trim() == wt.Name);

        @DialogHead(hasWork ? $"Remove {wt.Name}? This loses work." : $"Remove {wt.Name}?")
        @DialogError(dialog)
        <div class="wt-dialog-body">
            @if (running.Count > 0)
            {
                <div class="banner info">
                    @(running.Count == 1 ? "An agent is" : $"{running.Count} agents are") working here:
                    <strong>@string.Join(", ", running.Select(AgentName))</strong>.
                    Removing the worktree stops @(running.Count == 1 ? "it" : "them") first.
                </div>
            }
            @if (reading)
            {
                <p class="faint">Checking for work that would be lost...</p>
            }
            else if (hasWork)
            {
                <p>This worktree has changes that exist nowhere else:</p>
                <div class="wt-loss mono">
                    @if (dialog.LostFiles is null)
                    {
                        <div class="faint">Reading...</div>
                    }
                    else
                    {
                        @foreach (var line in dialog.LostFiles.Take(40))
                        {
                            <div>@line</div>
                        }
                        @foreach (var commit in dialog.LostCommits!.Take(20))
                        {
                            <div>@commit <span class="faint">(on no remote)</span></div>
                        }
                        @if (dialog.LostFiles.Count > 40 || dialog.LostCommits!.Count > 20)
                        {
                            <div class="faint">and more</div>
                        }
                    }
                </div>
                <p>Type <strong class="mono">@wt.Name</strong> to remove it anyway.</p>
                @* No placeholder: the name drawn in grey in an empty box reads as
                   already typed, and the button then looks broken. *@
                <input type="text" aria-label="Worktree name" value="@dialog.Typed" @ref="_confirmRef"
                       autocomplete="off" spellcheck="false"
                       @oninput="e => dialog.Typed = e.Value?.ToString() ?? string.Empty" />
            }
            else
            {
                <p>
                    @(row.State == CleanupState.AgentRunning
                        ? "It has no changes or commits that exist only here, so nothing would be lost."
                        : Why(row))
                    @if (row.Facts is { TotalBytes: > 0 } f)
                    {
                        <span> Frees @Fmt.Bytes(f.TotalBytes).</span>
                    }
                </p>
            }

            @if (wt.Branch is { } branch)
            {
                <label class="wt-option">
                    <input type="checkbox" checked="@dialog.DeleteBranch" @onchange="e => dialog.DeleteBranch = e.Value is true" />
                    <span>
                        Also delete branch <span class="mono">@branch</span>
                        <small>
                            @(hasWork
                                ? "Its commits that are on no remote are lost with it."
                                : row.Facts?.Merge == MergeState.SquashMerged
                                    ? "Git does not see a squash merge, so this deletes it past git's merged check. The base has its changes."
                                    : "Git keeps it if it does not count it as merged.")
                        </small>
                    </span>
                </label>
            }

            @ForgetOption(dialog, row.Parked.Count + running.Count)

            <div class="wt-cmd mono">
                @if (wt.Locked)
                {
                    <div>git worktree unlock @wt.Path</div>
                }
                <div>git worktree remove @(hasWork ? "--force " : "")@wt.Path</div>
                @if (dialog.DeleteBranch && wt.Branch is not null)
                {
                    <div>git branch @(hasWork || row.Facts?.Merge == MergeState.SquashMerged ? "-D" : "-d") @wt.Branch</div>
                }
            </div>
        </div>
        <footer class="wt-dialog-foot">
            <button class="ghost" @onclick="CloseDialog" disabled="@dialog.Busy">Cancel</button>
            <button class="@(hasWork ? "wt-danger" : "primary")" disabled="@(dialog.Busy || !confirmed)" @onclick="() => ConfirmRemove(dialog)">
                @(dialog.Busy ? "Removing..." : hasWork ? "Remove and lose changes" : "Remove")
            </button>
        </footer>
    };

    private RenderFragment BulkDialog(Dialog dialog) => __builder =>
    {
        var picked = dialog.Rows.Where(r => dialog.Picked.Contains(r.View.Worktree.Path)).ToList();
        var parked = picked.Sum(r => r.Parked.Count);

        @DialogHead("Clean up merged worktrees")
        @DialogError(dialog)
        <div class="wt-dialog-body">
            <p>These are clean, have nothing that exists only here, are merged or never diverged, and have no agent running. Untick any you want to keep.</p>
            <div class="wt-checklist">
                @foreach (var row in dialog.Rows)
                {
                    var path = row.View.Worktree.Path;
                    <label>
                        <input type="checkbox" checked="@dialog.Picked.Contains(path)" @onchange="e => Pick(dialog, path, e.Value is true)" />
                        <span class="stack">
                            <span class="mono">@row.View.Worktree.Name</span>
                            <span class="faint">@row.Repo.Name &middot; @Why(row)</span>
                        </span>
                        <span class="nums faint">@Fmt.Bytes(row.Facts?.TotalBytes ?? 0)</span>
                    </label>
                }
            </div>
            <label class="wt-option">
                <input type="checkbox" checked="@dialog.DeleteBranch" @onchange="e => dialog.DeleteBranch = e.Value is true" />
                <span>
                    Delete their branches too
                    <small>Merged branches with git's check; squash-merged ones past it, since the base has their changes.</small>
                </span>
            </label>
            @ForgetOption(dialog, parked)
        </div>
        <footer class="wt-dialog-foot">
            <button class="ghost" @onclick="CloseDialog" disabled="@dialog.Busy">Cancel</button>
            <button class="primary" disabled="@(dialog.Busy || picked.Count == 0)" @onclick="() => ConfirmBulk(dialog)">
                @(dialog.Busy ? "Removing..." : $"Remove {Fmt.Count(picked.Count, "worktree")} ({Fmt.Bytes(picked.Sum(r => r.Facts?.TotalBytes ?? 0))})")
            </button>
        </footer>
    };

    /// <summary>Every agent in a worktree, to pick one to go to. Drawn live, so states move while it is open.</summary>
    private RenderFragment AgentsDialog(Dialog dialog) => __builder =>
    {
        var row = dialog.Target!;
        var agents = AgentsIn(row);

        @DialogHead($"Agents in {row.View.Worktree.Name}")
        <div class="wt-dialog-body">
            @if (agents.Count == 0)
            {
                <p class="faint">No agents here any more.</p>
            }
            else
            {
                <div class="wt-agents">
                    @foreach (var agent in agents)
                    {
                        <button type="button" class="wt-agent" @onclick="() => GoTo(agent)">
                            <span class="dot @AgentDirectory.DotClass(agent.State)" aria-hidden="true"></span>
                            <span class="stack">
                                <span class="truncate">@agent.Label</span>
                                <span class="faint">@AgentDirectory.StateWord(agent) &middot; @Fmt.When(agent.Since, Snapshot.Value.TakenAt)</span>
                            </span>
                        </button>
                    }
                </div>
            }
        </div>
        <footer class="wt-dialog-foot">
            <button class="ghost" @onclick="CloseDialog">Close</button>
            <button @onclick="() => NewAgentFrom(row)">New agent here</button>
        </footer>
    };

    private void NewAgentFrom(Row row)
    {
        _dialog = null;
        Bench.OpenNewAgent(row.Repo.Root, row.View.Worktree.Path);
    }

    private void GoTo(ChatTarget agent)
    {
        _dialog = null;
        Nav.NavigateTo(Urls.Chat(agent.SessionId));
    }

    private RenderFragment PruneDialog(Dialog dialog) => __builder =>
    {
        @DialogHead("Prune orphaned worktrees")
        @DialogError(dialog)
        <div class="wt-dialog-body">
            <p>
                Git still lists @Fmt.Count(dialog.Rows.Count, "worktree") whose folder no longer exists. Pruning drops the
                record and frees the branch to be checked out elsewhere. No files are touched.
            </p>
            <div class="wt-checklist">
                @foreach (var row in dialog.Rows)
                {
                    <label>
                        <span></span>
                        <span class="stack">
                            <span class="mono">@row.View.Worktree.Name</span>
                            <span class="faint">@row.Repo.Name &middot; @(row.View.Worktree.Branch ?? "detached")</span>
                        </span>
                        <span></span>
                    </label>
                }
            </div>
            <div class="wt-cmd mono">git worktree prune</div>
        </div>
        <footer class="wt-dialog-foot">
            <button class="ghost" @onclick="CloseDialog" disabled="@dialog.Busy">Cancel</button>
            <button class="primary" disabled="@dialog.Busy" @onclick="() => ConfirmPrune(dialog)">Prune</button>
        </footer>
    };

    private RenderFragment LeftoverDialog(Dialog dialog) => __builder =>
    {
        var leftover = dialog.Leftover!;
        @DialogHead("Delete leftover folder")
        @DialogError(dialog)
        <div class="wt-dialog-body">
            <p>
                A worktree was here, and git no longer lists it. Deleting the folder removes everything still in it, and
                git has no copy to bring any of it back from.
            </p>
            <div class="wt-cmd mono">@leftover.Path</div>
            <p>@Fmt.Count(leftover.Files, "file"), @Fmt.Bytes(leftover.Bytes)@(leftover.Files > 0 ? ", including:" : ".")</p>
            @if (leftover.Sample.Count > 0)
            {
                <ul class="wt-leftover-files mono">
                    @foreach (var file in leftover.Sample)
                    {
                        <li>@file</li>
                    }
                    @if (leftover.Files > leftover.Sample.Count)
                    {
                        <li class="faint">and @Fmt.Count(leftover.Files - leftover.Sample.Count, "more file")</li>
                    }
                </ul>
            }
        </div>
        <footer class="wt-dialog-foot">
            <button class="ghost" @onclick="CloseDialog" disabled="@dialog.Busy">Cancel</button>
            <button class="wt-danger" disabled="@dialog.Busy" @onclick="() => ConfirmLeftover(dialog)">Delete folder</button>
        </footer>
    };

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Inventory.Changed -= OnInventoryChanged;
            State.Changed -= OnSnapshot;
            Bench.Changed -= OnBench;
        }

        base.Dispose(disposing);
    }
}
