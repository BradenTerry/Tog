@inherits StateComponent
@inject AgentHost Host
@inject AgentDirectory Directory
@inject MonitorService Monitor
@inject TranscriptLocator Locator
@inject ConversationReader Conversations
@inject IJSRuntime Js
@inject ChatDrafts Drafts
@inject Workbench Bench

@* The conversation with one agent, in the bottom panel. It reads like every
   messaging app, newest at the bottom with the box to type in under it. Keyed
   by the agent in the panel, so switching agents starts it afresh. *@

@if (Current is not { } agent)
{
    <div class="empty chat-empty">
        <h2>Agent not found</h2>
        <p>It may have been removed, or it has not reached the registry yet.</p>
    </div>
}
else
{
    <div class="chat-panel">
        <header class="chat-head">
            <span class="dot @AgentDirectory.DotClass(agent.State)" aria-hidden="true"></span>
            <strong class="truncate chat-title @(agent.LabelIsPrompt ? "untitled" : "")"
                    title="@(agent.LabelIsPrompt ? "Your prompt. The agent names the conversation when its first turn ends." : agent.Label)">@agent.Label</strong>
            <span class="faint truncate chat-state" title="@(agent.State == ChatState.Active ? agent.CurrentTool : null)">
                @AgentDirectory.StateWord(agent)@if (agent.State == ChatState.Active)
                {
                    <WorkingDots />
                }
            </span>
            <span class="spacer"></span>
            @* With another worktree picked in the title bar, the files on screen are
               not this agent's. One click brings its own up, and keeps them. *@
            @if (agent.WorktreePath is { } home && Workbench.Find(Snapshot.Value, home) is { } place)
            {
                if (Bench.WorktreeInView(Snapshot.Value) == home)
                {
                    <span class="chip worktree-open" title="The files, Source control and editor are this agent's worktree, @agent.Where">Worktree open</span>
                }
                else
                {
                    <button class="ghost small" @onclick="() => Bench.PinWorktree(home, place.Worktree.RepoRoot)"
                            title="Open this agent's worktree, @agent.Where, in place of the one open now">Change to worktree</button>
                }
            }
            @if (agent.State is ChatState.Active or ChatState.Waiting)
            {
                <button class="ghost small" @onclick="() => Act(() => Host.CancelAsync(agent.SessionId))" disabled="@_busy"
                        title="Stop the turn in progress. The agent stays, with everything so far kept.">Stop turn</button>
            }
            @if (agent.State is not ChatState.Parked)
            {
                <button class="ghost small" @onclick="() => Act(() => Host.StopAsync(agent.SessionId))" disabled="@_busy"
                        title="End the agent's session. Its conversation is kept, and a message picks it up again.">End session</button>
            }
            <button class="ghost small" @onclick="() => Act(() => Host.RemoveAsync(agent.SessionId))" disabled="@_busy"
                    title="Take it off the list. The conversation stays saved and can be resumed from New agent.">Remove</button>
        </header>

        @if (agent.FolderGone && !CanSend(agent))
        {
            <div class="banner danger chat-notice">
                <span>The folder this agent worked in is gone: <code>@agent.Cwd</code>. Its conversation is saved, but Claude can only resume it there. Recreate the worktree at that path to carry on, or remove the agent.</span>
                <button class="ghost small spacer" @onclick="() => Act(() => Host.RemoveAsync(agent.SessionId))" disabled="@_busy">Remove</button>
            </div>
        }

        @if (_notice is { Length: > 0 })
        {
            <div class="banner @(_noticeFailed ? "danger" : "info") chat-notice">
                @_notice
                <button class="ghost small spacer" @onclick="() => { _notice = null; }">Dismiss</button>
            </div>
        }

        <div class="chat-thread" @ref="_thread">
            @if (_entries.Count == 0 && _pending.Count == 0)
            {
                <div class="chat-hint">
                    @(_transcriptMissing
                        ? "No conversation found for this agent yet. It appears here as soon as the agent writes its transcript."
                        : "No messages yet. Say what you want it to do.")
                </div>
            }

            @foreach (var entry in _entries)
            {
                switch (entry.Kind)
                {
                    case ChatKind.You:
                        <div class="msg you">
                            <div class="bubble">@entry.Text</div>
                            <span class="msg-meta">You · @When(entry.At)</span>
                        </div>
                        break;

                    case ChatKind.Agent:
                        <div class="msg agent">
                            <div class="bubble">
                                <FileLinks Text="@entry.Text" WorktreePath="@(agent.WorktreePath ?? agent.Cwd ?? "")"
                                           SessionId="@agent.SessionId" />
                            </div>
                            <span class="msg-meta">Agent · @When(entry.At)</span>
                        </div>
                        break;

                    case ChatKind.Activity:
                        @if (entry.Steps.Count > 0)
                        {
                            <details class="activity">
                                <summary>@ConversationReader.Describe(entry.Steps)</summary>
                                <ul>
                                    @foreach (var step in entry.Steps)
                                    {
                                        <li><span class="mono activity-tool">@step.Tool</span> <span class="activity-what">@step.Summary</span></li>
                                    }
                                </ul>
                            </details>
                        }
                        @if (entry.Edits.Count > 0)
                        {
                            var runKey = entry.Edits[0].ToolUseId;
                            var files = entry.ChangedFiles;
                            var runOpen = _open.Contains(runKey);
                            @* Opened and closed on the server rather than by the browser's own
                               details toggle, so the file list and its diffs are only built
                               while you are looking at them: the view redraws every second. *@
                            <details class="activity files-changed" open="@runOpen">
                                <summary @onclick="() => Toggle(runKey)" @onclick:preventDefault>
                                    Files changed <span class="count">@files.Count</span>
                                    <span class="edit-add">+@entry.Edits.Sum(e => e.Added)</span>
                                    <span class="edit-del">-@entry.Edits.Sum(e => e.Removed)</span>
                                </summary>
                                @if (runOpen)
                                {
                                    <div class="files-changed-list">
                                        @foreach (var file in files)
                                        {
                                            var fileKey = runKey + "|" + file.Key;
                                            var fileOpen = _open.Contains(fileKey);
                                            var relative = RelativeTo(agent, file.Key);
                                            <details class="changed-file" open="@fileOpen">
                                                <summary @onclick="() => Toggle(fileKey)" @onclick:preventDefault>
                                                    <span class="mono changed-path" title="@file.Key">@relative</span>
                                                    @if (file.All(e => e.Failed))
                                                    {
                                                        <span class="faint">failed</span>
                                                    }
                                                    else
                                                    {
                                                        @if (file.Any(e => e.Created))
                                                        {
                                                            <span class="faint">new</span>
                                                        }
                                                        <span class="edit-add">+@file.Sum(e => e.Added)</span>
                                                        <span class="edit-del">-@file.Sum(e => e.Removed)</span>
                                                    }
                                                </summary>
                                                @if (fileOpen)
                                                {
                                                    <div class="edit-diff mono">
                                                        @foreach (var edit in file.Where(e => !e.Failed))
                                                        {
                                                            @foreach (var hunk in edit.Hunks)
                                                            {
                                                                var oldLine = hunk.OldStart;
                                                                var newLine = hunk.NewStart;
                                                                <div class="edit-hunk"></div>
                                                                @foreach (var line in hunk.Lines)
                                                                {
                                                                    var mark = line.Length > 0 ? line[0] : ' ';
                                                                    // Removed lines are numbered in the old file, the
                                                                    // rest in the new one, as in the Changes diff.
                                                                    var number = mark == '-' ? oldLine : newLine;
                                                                    <div class="edit-line @(mark == '+' ? "add" : mark == '-' ? "del" : "")">
                                                                        <span class="edit-ln">@number</span><span class="edit-text">@(line.Length > 0 ? line[1..] : "")</span>
                                                                    </div>
                                                                    if (mark != '+' && oldLine is not null) { oldLine++; }
                                                                    if (mark != '-' && newLine is not null) { newLine++; }
                                                                }
                                                            }
                                                            @if (edit.Truncated)
                                                            {
                                                                <div class="edit-more faint">Longer than @ConversationReader.MaxEditLines lines; the rest is left out.</div>
                                                            }
                                                        }
                                                    </div>
                                                    @if (!file.All(e => e.Failed) && relative != file.Key)
                                                    {
                                                        <a class="small changed-open" href="@Urls.AgentFile(agent.SessionId, relative, FirstLine(file))">Open in the editor</a>
                                                    }
                                                }
                                            </details>
                                        }
                                    </div>
                                }
                            </details>
                        }
                        break;

                    case ChatKind.Notice:
                        <div class="chat-notice-line">@entry.Text</div>
                        break;
                }
            }

            @foreach (var pending in _pending)
            {
                <div class="msg you pending @(pending.State == SendState.Failed ? "failed" : "")">
                    <div class="bubble">@pending.Text</div>
                    <span class="msg-meta">
                        @switch (pending.State)
                        {
                            case SendState.Sending:
                                <span>Sending...</span>
                                break;
                            case SendState.Sent:
                                <span>Sent.</span>
                                break;
                            default:
                                <span class="failed-text">Not sent: @pending.Error</span>
                                <button class="ghost small" @onclick="() => Retry(pending)">Edit and retry</button>
                                <button class="ghost small" @onclick="() => _pending.Remove(pending)">Dismiss</button>
                                break;
                        }
                    </span>
                </div>
            }

            @* What the agent is saying right now, before its transcript has it:
               streamed over ACP as it is written. *@
            @if (_liveShown is { Length: > 0 } live)
            {
                <div class="msg agent live">
                    <div class="bubble">
                        <FileLinks Text="@live" WorktreePath="@(agent.WorktreePath ?? agent.Cwd)" SessionId="@agent.SessionId" />
                    </div>
                    <span class="msg-meta">Agent · writing</span>
                </div>
            }

            @if (agent.Permission is { } ask)
            {
                <div class="permission-card" role="alert">
                    <div class="stack" style="gap: 3px; min-width: 0;">
                        <strong>Allow this?</strong>
                        <span class="mono permission-title">@ask.Title</span>
                        @if (ask.Detail is { Length: > 0 } detail)
                        {
                            <span class="faint">@detail</span>
                        }
                    </div>
                    <div class="inline permission-choices">
                        @foreach (var choice in ask.Choices)
                        {
                            var option = choice;
                            <button class="small @(option.Allows ? "primary" : "")"
                                    @onclick="() => Host.Answer(agent.SessionId, ask.Key, option.OptionId)">@option.Name</button>
                        }
                    </div>
                </div>
            }
            else if (agent.State == ChatState.Active)
            {
                <div class="chat-working">
                    <span class="dot active" aria-hidden="true"></span>
                    <span title="@agent.CurrentTool">Working<WorkingDots /></span>
                </div>
            }

            @if (agent.State == ChatState.Failed && agent.Error is { Length: > 0 } error)
            {
                <div class="banner danger">@error</div>
            }
        </div>

        @* Work that goes on outside the turn: a subagent or a background
           command keeps running after the agent says it is done, and an
           idle agent with work in flight is not finished. Folded to its
           count by default, so it does not take room from the thread; the
           open attribute is left to the browser, so a re-render keeps it
           open or shut as the user left it. *@
        @if (agent.BackgroundCount > 0 && agent.State is not (ChatState.Parked or ChatState.Failed))
        {
            <details class="background-strip">
                <summary class="background-head">
                    <WorkingDots /> Running in the background <span class="count">@agent.BackgroundCount</span>
                </summary>
                @foreach (var sub in agent.Subagents ?? [])
                {
                    <span class="background-item" title="@sub.Description">
                        <span class="background-kind">@(sub.AgentType ?? "Subagent")</span>
                        <span class="background-what">@(sub.Description ?? "Subagent")</span>
                        <span class="faint nums">@Fmt.Duration(Snapshot.Value.TakenAt - sub.StartedAt)</span>
                    </span>
                }
                @foreach (var command in agent.BackgroundCommands ?? [])
                {
                    <span class="background-item" title="@command.Description">
                        <span class="background-kind">Command</span>
                        <span class="background-what">@command.Description</span>
                        <span class="faint nums">@Fmt.Duration(Snapshot.Value.TakenAt - command.StartedAt)</span>
                    </span>
                }
            </details>
        }

        <form class="chat-composer" @onsubmit="Send">
            <div class="composer-row">
                @* Filled and emptied by app.js as a slash command is typed. *@
                <div class="command-menu" @ref="_menu" role="listbox" aria-label="Slash commands"></div>
                <textarea @ref="_box" rows="1"
                          placeholder="@Placeholder(agent)"
                          aria-label="Message for @agent.Label"
                          aria-autocomplete="list"
                          disabled="@(!CanSend(agent))"
                          @oninput="e => { _draft = e.Value?.ToString() ?? string.Empty; Drafts.Set(agent.SessionId, _draft); }"></textarea>
                <button type="submit" class="primary"
                        disabled="@(_sending || string.IsNullOrWhiteSpace(_draft) || !CanSend(agent))">
                    Send
                </button>
            </div>
            <div class="composer-foot">
                <span class="composer-hint">@Hint(agent)</span>
                @if (agent.Context is { } context)
                {
                    @* Under the Send button, where you are when you decide whether
                       to keep going or start afresh. As of the last turn's end:
                       the agent only reports it then. *@
                    <span class="context-meter @ContextClass(context)"
                          title="@($"{Fmt.Tokens(context.Used)} of {Fmt.Tokens(context.Size)} tokens in context, as of the last turn")">
                        <span class="context-bar" aria-hidden="true"><span style="width: @(Math.Clamp(context.Percent, 0, 100))%"></span></span>
                        @context.Percent% context
                    </span>
                }
            </div>
        </form>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string SessionId { get; set; } = "";

    /// <summary>Whether the panel is showing this, which is when the thread is followed and the box is wired.</summary>
    [Parameter]
    public bool IsVisible { get; set; }

    private enum SendState { Sending, Sent, Failed }

    /// <summary>A message on its way, shown until the transcript records it.</summary>
    private sealed class Pending(string text)
    {
        public string Text { get; } = text;
        public DateTimeOffset SentAt { get; } = DateTimeOffset.Now;
        public SendState State { get; set; } = SendState.Sending;
        public string? Error { get; set; }
    }

    private IReadOnlyList<ChatEntry> _entries = [];
    private bool _transcriptMissing;
    private readonly List<Pending> _pending = [];

    /// <summary>The "Files changed" folds and the files in them that are open, by key.</summary>
    private readonly HashSet<string> _open = new(StringComparer.Ordinal);

    private void Toggle(string key)
    {
        if (!_open.Remove(key))
        {
            _open.Add(key);
        }
    }

    /// <summary>A changed file's path relative to the agent's worktree, or as given when it is outside it.</summary>
    private static string RelativeTo(ChatTarget agent, string path)
    {
        var root = agent.WorktreePath ?? agent.Cwd;
        return path.StartsWith(root + "/", StringComparison.Ordinal) ? path[(root.Length + 1)..] : path;
    }

    /// <summary>Where a file's first change starts, to open the editor there.</summary>
    private static int? FirstLine(IEnumerable<ChatEdit> edits) =>
        edits.SelectMany(e => e.Hunks).Select(h => h.NewStart).FirstOrDefault(n => n is not null);

    /// <summary>
    /// What is in the message box, as the browser last reported it. The box is
    /// never written from here on a render: the panel re-renders every second, and
    /// writing a copy that is a keystroke behind back into the box drops what was
    /// typed in between. Text is put into it only on purpose, through
    /// <see cref="_putInBox"/>.
    /// </summary>
    private string _draft = "";

    /// <summary>Text to place in the box after the next render, when there is some.</summary>
    private string? _putInBox;
    private bool _sending;
    private bool _busy;
    private string? _notice;
    private bool _noticeFailed;

    private ElementReference _thread;
    private ElementReference _box;
    private ElementReference _menu;

    /// <summary>The command list last handed to the box, to hand it over again only when the agent lists a new one.</summary>
    private IReadOnlyList<AcpCommand>? _commandsSent;
    private int _shownCount = -1;
    private bool _forceScroll = true;
    private bool _wasVisible;

    private DateTimeOffset Now => Snapshot.Value.TakenAt;

    private ChatTarget? Current => Directory.Targets(Snapshot.Value).FirstOrDefault(t => t.SessionId == SessionId);

    // Claude resumes a conversation only in the folder it started in, so an
    // agent whose worktree was removed has nowhere to carry on.
    private static bool CanSend(ChatTarget target) => !target.FolderGone || target.State is not (ChatState.Parked or ChatState.Failed);

    private static string Placeholder(ChatTarget target) => target.State switch
    {
        ChatState.Parked => "Message it to pick it up again...",
        ChatState.Failed => "Message it to try again...",
        _ => "Message the agent...",
    };

    /// <summary>Amber from 70%, red from 85%: Claude compacts the conversation on its own not far past that.</summary>
    private static string ContextClass(ContextUsage context) => context.Percent switch
    {
        >= 85 => "high",
        >= 70 => "warn",
        _ => "",
    };

    private static string Hint(ChatTarget target)
    {
        var Keys = "Enter to send, Shift+Enter for a new line." + (target.Commands is { Count: > 0 } ? " / for commands." : "");
        if (!CanSend(target))
        {
            return "Its folder is gone, so it cannot be resumed.";
        }

        return target.State switch
        {
            ChatState.Active or ChatState.Waiting => Keys,
            ChatState.Parked => Keys + " Its session has ended: sending resumes it with its conversation kept.",
            ChatState.Failed => Keys + " Sending starts it again with its conversation kept.",
            _ => Keys + " It picks up from where the conversation left off.",
        };
    }

    private string When(DateTimeOffset at) =>
        at == DateTimeOffset.MinValue ? "" : Now - at < TimeSpan.FromHours(12) ? at.ToLocalTime().ToString("t") : at.ToLocalTime().ToString("MMM d, t");

    protected override void OnInitialized()
    {
        base.OnInitialized();
        State.Changed += OnSnapshot;
        Directory.Changed += OnDirectoryChanged;
        Bench.Changed += OnBenchChanged;

        // Each agent keeps what you had typed to it.
        _draft = Drafts.Get(SessionId);
        _putInBox = _draft;
        ReadConversation();
    }

    private void OnBenchChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        // Brought back into view: the thread lands at the bottom again, as it
        // would have if it had been on screen all along.
        if (IsVisible && !_wasVisible)
        {
            _forceScroll = true;
        }

        _wasVisible = IsVisible;
    }

    /// <summary>The host heard from the agent: new streamed text, a tool call, a permission prompt.</summary>
    private void OnDirectoryChanged() => _ = InvokeAsync(() =>
    {
        ReadConversation();
        StateHasChanged();
    });

    /// <summary>
    /// Keeps the conversation current. Runs on the monitor's tick, so a working
    /// agent's replies appear as it writes them.
    /// </summary>
    private void OnSnapshot() => _ = InvokeAsync(() =>
    {
        ReadConversation();
        StateHasChanged();
    });

    private void ReadConversation()
    {
        if (Current is not { } target)
        {
            _entries = [];
            return;
        }

        var path = Locator.Locate(target.SessionId, target.Cwd);
        _transcriptMissing = path is null;
        if (path is null)
        {
            return;
        }

        _entries = Conversations.Read(target.SessionId, path);
        _liveShown = LiveToShow(target);

        // A delivered message stops being "pending" once the transcript has it.
        _pending.RemoveAll(p => p.State == SendState.Sent && _entries.Any(e =>
            e.Kind == ChatKind.You
            && e.At >= p.SentAt.AddMinutes(-1)
            && string.Equals(e.Text.Trim(), p.Text.Trim(), StringComparison.Ordinal)));
    }

    /// <summary>The streamed reply drawn under the thread, if any.</summary>
    private string? _liveShown;

    /// <summary>The last streamed text seen, and when, kept after the host clears it.</summary>
    private string? _lastLive;
    private DateTimeOffset _lastLiveAt;

    /// <summary>When the agent was first seen out of its turn, or null while it is in one.</summary>
    private DateTimeOffset? _idleSince;

    /// <summary>
    /// The reply being written, held on screen until the transcript has it.
    /// </summary>
    /// <remarks>
    /// The host clears its live text when a tool call starts or the turn ends. The
    /// transcript is later than that: Claude writes a message to it only once the
    /// tool call after it has finished streaming, which for a call that writes a
    /// whole file is ten seconds or more. Taking the host's word made the message
    /// vanish for that long and come back. So the last live text stays until a
    /// message in the thread matches it, and steps aside as soon as one does, so
    /// the two are never shown at once.
    /// <para>
    /// While the agent is still in its turn it is held for as long as a tool call
    /// could take to stream. Once the turn is over the transcript has everything,
    /// so a few seconds is the limit, in case it words the message differently
    /// enough never to match.
    /// </para>
    /// </remarks>
    private string? LiveToShow(ChatTarget target)
    {
        var now = DateTimeOffset.UtcNow;
        var inTurn = target.State is ChatState.Active or ChatState.Waiting;
        _idleSince = inTurn ? null : _idleSince ?? now;

        var live = inTurn ? target.LiveText : "";
        if (live.Length > 0)
        {
            _lastLive = live;
            _lastLiveAt = now;
        }
        else if (_lastLive is not null
                 && (now - _lastLiveAt > TimeSpan.FromMinutes(2)
                     || now - _idleSince > TimeSpan.FromSeconds(5)))
        {
            _lastLive = null;
        }

        var shown = live.Length > 0 ? live : _lastLive;
        if (shown is null)
        {
            return null;
        }

        var flat = Flat(shown);
        var written = _entries
            .Where(e => e.Kind == ChatKind.Agent)
            .TakeLast(3)
            .Select(e => Flat(e.Text))
            .Any(text => text.Contains(flat, StringComparison.Ordinal));

        if (written)
        {
            _lastLive = null;
            return null;
        }

        return shown;
    }

    private static string Flat(string text) =>
        string.Join(' ', text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));

    private async Task Send()
    {
        if (Current is not { } target || _sending)
        {
            return;
        }

        var text = _draft.Trim();
        if (text.Length == 0 || !CanSend(target))
        {
            return;
        }

        var pending = new Pending(text);
        _pending.Add(pending);
        _draft = "";
        Drafts.Set(target.SessionId, "");
        _sending = true;
        _forceScroll = true;
        StateHasChanged();
        await ResetBox();

        var result = await Host.SendAsync(target.SessionId, text);

        _sending = false;
        if (result.Ok)
        {
            pending.State = SendState.Sent;
        }
        else
        {
            pending.State = SendState.Failed;
            pending.Error = result.Message;
        }

        Monitor.InvalidateWorktrees();
    }

    private void Retry(Pending pending)
    {
        _pending.Remove(pending);
        _draft = pending.Text;
        _putInBox = pending.Text;
        if (Current is { } target)
        {
            Drafts.Set(target.SessionId, _draft);
        }
    }

    private async Task ResetBox()
    {
        try
        {
            await Js.InvokeVoidAsync("agentsDashboard.resetComposer", _box);
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
        {
            // The circuit went away. Nothing to reset.
        }
    }

    private async Task Act(Func<Task<HostResult>> action)
    {
        _busy = true;
        _notice = null;
        StateHasChanged();

        var result = await action();

        // Only a failure is worth a banner. When stopping a turn or ending a
        // session works, the agent's state and the chat already say so, and a
        // second "Stopping the turn." on top of that is just something to dismiss.
        _busy = false;
        _noticeFailed = !result.Ok;
        _notice = result.Ok ? null : result.Message;
        Monitor.InvalidateWorktrees();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The composer and the thread are always built, but only followed while
        // the panel is showing them.
        if (Current is not { } agent || !IsVisible)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("agentsDashboard.bindComposer", _box);

            if (!ReferenceEquals(agent.Commands, _commandsSent))
            {
                _commandsSent = agent.Commands;
                await Js.InvokeVoidAsync("agentsDashboard.setComposerCommands", _box, _menu, agent.Commands ?? []);
            }

            if (_putInBox is { } text)
            {
                _putInBox = null;
                await Js.InvokeVoidAsync("agentsDashboard.setComposer", _box, text);
            }

            var count = _entries.Count + _pending.Count;
            if (_forceScroll || count != _shownCount)
            {
                var force = _forceScroll;
                _forceScroll = false;
                _shownCount = count;
                await Js.InvokeVoidAsync("agentsDashboard.scrollThread", _thread, force);
            }
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
        {
            // The circuit went away mid-render.
        }
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            State.Changed -= OnSnapshot;
            Directory.Changed -= OnDirectoryChanged;
            Bench.Changed -= OnBenchChanged;
        }

        base.Dispose(disposing);
    }
}
