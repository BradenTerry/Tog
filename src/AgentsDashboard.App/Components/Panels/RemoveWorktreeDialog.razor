@inherits StateComponent
@inject Workbench Bench
@inject WorktreeInventory Inventory
@inject WorktreeCleanup Cleanup
@inject MonitorService Monitor
@inject AgentHost Host
@inject IWebHostEnvironment Env
@inject Toasts Notes

@* Removing one worktree, as a dialog over the window like New agent, so
   whatever was on screen stays there: Delete on an agent in the agent list and
   the Remove button on a row of the Worktrees view both land here, through
   Bench.AskRemoveWorktree. It used to live inside the Worktrees view, which
   meant asking from the agent list switched the editor to that view behind
   the dialog. Nothing is removed without a confirmation here. A removal that
   went through closes the dialog and says so in a toast, kept branch and all;
   only a folder left on disk keeps it open, since that is still to deal with. *@

@if (_path is { } path)
{
    var row = _result is null ? Find(path) : null;
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="rm-wt-title" tabindex="-1"
             @ref="_dialogRef" @onclick:stopPropagation @onkeydown="OnKey">
            @if (_result is { } result)
            {
                @Head(result.Ok ? "Worktree removed" : "Worktree not removed")
                <div class="wt-dialog-body">
                    <div class="banner danger">
                        <span style="white-space: pre-line;">@result.Message</span>
                    </div>
                </div>
                <footer class="wt-dialog-foot">
                    <button class="primary" @onclick="Close">Close</button>
                </footer>
            }
            else if (row is null)
            {
                @Head($"Remove {Fmt.Leaf(path)}?")
                <div class="wt-dialog-body"><p>Git no longer lists this worktree.</p></div>
                <footer class="wt-dialog-foot">
                    <button class="primary" @onclick="Close">Close</button>
                </footer>
            }
            else if (row.State == CleanupState.Checking)
            {
                @Head($"Remove {row.View.Worktree.Name}?")
                <div class="wt-dialog-body"><p class="faint">Measuring the worktree to see what removing it would lose...</p></div>
                <footer class="wt-dialog-foot">
                    <button class="ghost" @onclick="Close">Cancel</button>
                    <button class="primary" disabled>Remove</button>
                </footer>
            }
            else if (!Removable(row.State))
            {
                @Head($"{row.View.Worktree.Name} cannot be removed")
                <div class="wt-dialog-body"><p>@Why(row.State, row.Facts)</p></div>
                <footer class="wt-dialog-foot">
                    <button class="primary" @onclick="Close">Close</button>
                </footer>
            }
            else
            {
                @RemoveBody(row)
            }
        </div>
    </div>
}

@code {
    /// <summary>The worktree the dialog is about; null while it is shut.</summary>
    private string? _path;

    private CleanupResult? _result;
    private ElementReference _dialogRef;
    private bool _focusDialog;
    private ElementReference _confirmRef;
    private bool _focusConfirm;

    // What the dialog has been told, kept across renders while the row itself
    // is looked up fresh from each snapshot.
    private bool _optionsSet;
    private bool _deleteBranch;
    private bool _forgetAgents = true;
    private string _typed = "";
    private bool _reading;
    private IReadOnlyList<string>? _lostFiles;
    private IReadOnlyList<string>? _lostCommits;
    private bool _busy;
    private string? _error;

    /// <summary>One worktree with what is known about it, as the Worktrees view draws a row.</summary>
    private sealed record Row(
        RepoView Repo,
        WorktreeView View,
        WorktreeFacts? Facts,
        CleanupState State,
        IReadOnlyList<HostedAgent> Parked);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Bench.Changed += OnBench;
        Inventory.Changed += OnInventoryChanged;
    }

    private void OnBench() => _ = InvokeAsync(() =>
    {
        if (Bench.RemoveRequest is not { } path)
        {
            return;
        }

        Bench.RemoveRequest = null;
        if (_busy)
        {
            return;
        }

        Reset();
        _path = path;
        _focusDialog = true;

        // A worktree not measured yet cannot be judged, so it is measured now
        // and the dialog waits on it; the agent list can ask about one nobody
        // has opened the Worktrees view for.
        if (Place(path) is { } place)
        {
            Inventory.Refresh(place.Repo, place.View.Worktree, Remeasure.Missing);
        }

        Settle();
        StateHasChanged();
    });

    private void OnInventoryChanged() => _ = InvokeAsync(() =>
    {
        if (_path is not null)
        {
            Settle();
            StateHasChanged();
        }
    });

    /// <summary>
    /// Once the worktree has been measured, picks the dialog's defaults and, when
    /// there may be work to lose, reads it fresh: an agent may have changed files
    /// since it was measured, and the dialog must list what would be lost now.
    /// </summary>
    private void Settle()
    {
        if (_optionsSet || _path is not { } path || Find(path) is not { } row || row.State == CleanupState.Checking)
        {
            return;
        }

        _optionsSet = true;
        _deleteBranch = row.State == CleanupState.SafeToRemove && row.View.Worktree.Branch is not null;
        if (row.State is CleanupState.HasWork or CleanupState.AgentRunning)
        {
            _reading = true;
            _ = ReadLosses(path, row.Facts?.Base);
        }
    }

    private async Task ReadLosses(string path, string? @base)
    {
        var (files, commits) = await Cleanup.LossesAsync(path, @base);
        await InvokeAsync(() =>
        {
            if (_path != path)
            {
                return;
            }

            _lostFiles = files;
            _lostCommits = commits;
            _reading = false;

            // The name box only appears once the read is back, after the dialog
            // took focus, so it is focused then: typing the name is the one thing to do.
            _focusConfirm = Loses(Find(path));
            StateHasChanged();
        });
    }

    private void Reset()
    {
        _result = null;
        _optionsSet = false;
        _deleteBranch = false;
        _forgetAgents = true;
        _typed = "";
        _reading = false;
        _lostFiles = null;
        _lostCommits = null;
        _error = null;
    }

    private void Close()
    {
        if (!_busy)
        {
            _path = null;
            Reset();
        }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    /// <remarks>
    /// A failed focus is swallowed: the name box can be gone by the time this
    /// runs (the worktree went back to being measured), and a throw here ends
    /// the circuit, which leaves the dialog on screen answering nothing.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDialog && _path is not null)
        {
            _focusDialog = false;
            await Focus(_dialogRef);
        }

        if (_focusConfirm && _path is not null)
        {
            _focusConfirm = false;
            await Focus(_confirmRef);
        }
    }

    private static async Task Focus(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    /// <summary>
    /// Whether Remove is offered. A running agent does not stop it: the dialog
    /// says which agents it stops first.
    /// </summary>
    internal static bool Removable(CleanupState state) =>
        state is CleanupState.SafeToRemove or CleanupState.NotMerged or CleanupState.HasWork or CleanupState.AgentRunning;

    /// <summary>Why a worktree is in the state it is, in a sentence; the Worktrees view's rows say it too.</summary>
    internal static string Why(CleanupState state, WorktreeFacts? facts) => state switch
    {
        CleanupState.Primary => "The repository's main checkout, shown for reference. It is never removed here.",
        CleanupState.Dashboard => "The dashboard is running from this worktree, so it is not offered for removal.",
        CleanupState.Orphaned => "The folder was deleted outside git. Git still lists it and still holds its branch, so that branch cannot be checked out anywhere else until it is pruned.",
        CleanupState.AgentRunning => "An agent is working here. Removing the worktree stops it first, so it is not left working in a folder that is gone.",
        CleanupState.HasWork => "There is work here that exists nowhere else. Removing it would lose that work, so push or commit it first, or remove it knowingly.",
        CleanupState.NotMerged => "Clean, and every commit is on a remote, so removing it loses nothing. Its branch is not merged yet, so it is not included in bulk cleanup.",
        CleanupState.SafeToRemove => facts?.Merge switch
        {
            MergeState.NoOwnCommits => "Clean, and it never had commits of its own. Nothing would be lost.",
            MergeState.SquashMerged => $"Clean, and {facts.Base} already has its changes (squash or rebase merged). Nothing would be lost.",
            _ => $"Clean, and merged into {facts?.Base}. Nothing would be lost.",
        },
        CleanupState.Checking => "Being measured.",
        _ => facts?.Error ?? "Git could not be asked about this worktree.",
    };

    private (RepoView Repo, WorktreeView View)? Place(string path)
    {
        foreach (var repo in Snapshot.Repos)
        {
            if (repo.Worktrees.FirstOrDefault(w => w.Worktree.Path == path) is { } view)
            {
                return (repo, view);
            }
        }

        return null;
    }

    private Row? Find(string path)
    {
        if (Place(path) is not { } place)
        {
            return null;
        }

        var paths = place.Repo.Worktrees.Select(w => w.Worktree.Path).ToList();
        var facts = Inventory.Facts(path);
        var hostsDashboard = new[] { Env.ContentRootPath, AppContext.BaseDirectory }.Any(d => Owner(d, paths) == path);
        var state = WorktreeCleanup.Classify(place.View.Worktree, facts, place.View.Agents.Count > 0, hostsDashboard);

        // Stopped agents are kept on the agent list; once their worktree is gone
        // they cannot be resumed there, so removing offers to forget them.
        var parked = Host.Agents.Where(a => a.State == HostedState.Stopped && Owner(a.Cwd, paths) == path).ToList();
        return new Row(place.Repo, place.View, facts, state, parked);
    }

    /// <summary>The worktree a directory belongs to: the deepest one it is under, as the monitor places agents.</summary>
    internal static string? Owner(string directory, IReadOnlyList<string> worktrees) =>
        worktrees
            .Where(w => AgentsDashboard.Core.Repos.RealPaths.IsUnder(directory, w))
            .MaxBy(w => w.Length);

    /// <summary>
    /// Removes one worktree, stopping any agent working in it first. The branch
    /// goes with it only when asked, and is deleted past git's merged check only
    /// when that check cannot see the merge (a squash) or when the dialog already
    /// made you confirm the loss. The Worktrees view's bulk clean up uses it too.
    /// </summary>
    internal static async Task<CleanupResult> RemoveAsync(
        AgentHost host, WorktreeCleanup cleanup, WorktreeInventory inventory,
        RepoView repo, WorktreeView view, WorktreeFacts? facts, IReadOnlyList<HostedAgent> parked,
        bool force, bool deleteBranch, bool forgetAgents)
    {
        foreach (var agent in view.Agents)
        {
            await host.StopAsync(agent.SessionId);
        }

        var result = await cleanup.RemoveAsync(
            repo.Root,
            view.Worktree,
            force: force,
            deleteBranch: deleteBranch,
            forceBranch: force || facts?.Merge == MergeState.SquashMerged);

        if (result.Ok)
        {
            inventory.Forget(view.Worktree.Path);
            if (forgetAgents)
            {
                foreach (var id in parked.Select(a => a.SessionId).Concat(view.Agents.Select(a => a.SessionId)))
                {
                    await host.RemoveAsync(id);
                }
            }
        }

        return result;
    }

    /// <summary>Whether removing loses work: known from its state, or found when the dialog read it fresh.</summary>
    private bool Loses(Row? row) =>
        row?.State == CleanupState.HasWork
        || _lostFiles is { Count: > 0 }
        || _lostCommits is { Count: > 0 };

    private async Task Confirm(Row row)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await RemoveAsync(Host, Cleanup, Inventory, row.Repo, row.View, row.Facts, row.Parked,
                force: Loses(row), _deleteBranch, _forgetAgents);
            if (!result.Ok)
            {
                _error = result.Message;
            }
            else if (result.Leftover is null)
            {
                _busy = false;
                Close();
                Notes.Show(result.Message);
            }
            else
            {
                _result = result;
                _focusDialog = true;
            }
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
            Monitor.InvalidateWorktrees();
        }
    }

    private static string AgentName(AgentSession agent) => agent.Summary ?? agent.Name ?? agent.SessionId[..8];

    private RenderFragment Head(string title) => __builder =>
    {
        <header class="modal-head">
            <h2 id="rm-wt-title">@title</h2>
            <button type="button" class="icon-btn spacer" @onclick="Close" title="Close" aria-label="Close">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </button>
        </header>
    };

    private RenderFragment RemoveBody(Row row) => __builder =>
    {
        var wt = row.View.Worktree;
        var running = row.View.Agents;
        var hasWork = Loses(row);
        var confirmed = !_reading && (!hasWork || _typed.Trim() == wt.Name);
        var forget = row.Parked.Count + running.Count;

        @Head(hasWork ? $"Remove {wt.Name}? This loses work." : $"Remove {wt.Name}?")
        @if (_error is { } error)
        {
            <div class="banner danger">@error</div>
        }
        <div class="wt-dialog-body">
            @if (running.Count > 0)
            {
                <div class="banner info">
                    @(running.Count == 1 ? "An agent is" : $"{running.Count} agents are") working here:
                    <strong>@string.Join(", ", running.Select(AgentName))</strong>.
                    Removing the worktree stops @(running.Count == 1 ? "it" : "them") first.
                </div>
            }
            @if (_reading)
            {
                <p class="faint">Checking for work that would be lost...</p>
            }
            else if (hasWork)
            {
                <p>This worktree has changes that exist nowhere else:</p>
                <div class="wt-loss mono">
                    @if (_lostFiles is null)
                    {
                        <div class="faint">Reading...</div>
                    }
                    else
                    {
                        @foreach (var line in _lostFiles.Take(40))
                        {
                            <div>@line</div>
                        }
                        @foreach (var commit in _lostCommits!.Take(20))
                        {
                            <div>@commit <span class="faint">(on no remote)</span></div>
                        }
                        @if (_lostFiles.Count > 40 || _lostCommits!.Count > 20)
                        {
                            <div class="faint">and more</div>
                        }
                    }
                </div>
                <p>Type <strong class="mono">@wt.Name</strong> to remove it anyway.</p>
                @* No placeholder: the name drawn in grey in an empty box reads as
                   already typed, and the button then looks broken. *@
                <input type="text" aria-label="Worktree name" value="@_typed" @ref="_confirmRef"
                       autocomplete="off" spellcheck="false"
                       @oninput="e => _typed = e.Value?.ToString() ?? string.Empty" />
            }
            else
            {
                <p>
                    @(row.State == CleanupState.AgentRunning
                        ? "It has no changes or commits that exist only here, so nothing would be lost."
                        : Why(row.State, row.Facts))
                    @if (row.Facts is { TotalBytes: > 0 } f)
                    {
                        <span> Frees @Fmt.Bytes(f.TotalBytes).</span>
                    }
                </p>
            }

            @if (wt.Branch is { } branch)
            {
                <label class="wt-option">
                    <input type="checkbox" checked="@_deleteBranch" @onchange="e => _deleteBranch = e.Value is true" />
                    <span>
                        Also delete branch <span class="mono">@branch</span>
                        <small>
                            @(hasWork
                                ? "Its commits that are on no remote are lost with it."
                                : row.Facts?.Merge == MergeState.SquashMerged
                                    ? "Git does not see a squash merge, so this deletes it past git's merged check. The base has its changes."
                                    : "Git keeps it if it does not count it as merged.")
                        </small>
                    </span>
                </label>
            }

            @if (forget > 0)
            {
                <label class="wt-option">
                    <input type="checkbox" checked="@_forgetAgents" @onchange="e => _forgetAgents = e.Value is true" />
                    <span>
                        Take @Fmt.Count(forget, "agent") in it off the agent list
                        <small>Their conversations stay saved, and New agent can resume them.</small>
                    </span>
                </label>
            }

            <div class="wt-cmd mono">
                @if (wt.Locked)
                {
                    <div>git worktree unlock @wt.Path</div>
                }
                <div>git worktree remove @(hasWork ? "--force " : "")@wt.Path</div>
                @if (_deleteBranch && wt.Branch is not null)
                {
                    <div>git branch @(hasWork || row.Facts?.Merge == MergeState.SquashMerged ? "-D" : "-d") @wt.Branch</div>
                }
            </div>
        </div>
        <footer class="wt-dialog-foot">
            <button class="ghost" @onclick="Close" disabled="@_busy">Cancel</button>
            <button class="@(hasWork ? "wt-danger" : "primary")" disabled="@(_busy || !confirmed)" @onclick="() => Confirm(row)">
                @(_busy ? "Removing..." : hasWork ? "Remove and lose changes" : "Remove")
            </button>
        </footer>
    };

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Bench.Changed -= OnBench;
            Inventory.Changed -= OnInventoryChanged;
        }

        base.Dispose(disposing);
    }
}
