@inherits StateComponent
@inject Workbench Bench
@inject ExtensionHost Extensions
@inject AgentDirectory Directory

@* One of the three panels: a strip of tabs, the app's own first and then any
   extension's that asked for this panel, over what the tab in front shows. A
   tab you have opened stays built while another is in front, hidden rather than
   thrown away, so it keeps its scroll and what it had read. The app's own tabs
   are rebuilt when the panel moves to another agent or worktree; an extension's
   is parked instead, so switching back does not load it again. *@

<section class="wb-panel" aria-label="@Label">
    <div class="ptabs" role="tablist" aria-label="@Label">
        @foreach (var tab in Tabs)
        {
            var active = tab.Key == ActiveKey;
            <button type="button" role="tab" class="ptab @(active ? "active" : "")" aria-selected="@(active ? "true" : "false")"
                    @onclick="() => Bench.Show(Side, tab.Key)">
                @tab.Title
                @if (tab.Count is { Length: > 0 } count)
                {
                    <span class="count @tab.Tone" title="@tab.Tooltip">@count</span>
                }
            </button>
        }
    </div>

    <div class="ptab-body">
        @if (Agent is null && Worktree is null)
        {
            <div class="panel-note faint">@(Bench.SessionId is null ? "Pick an agent, or open a worktree from the title bar." : "That agent is not in the list.")</div>
        }
        else if (Tabs.Count == 0)
        {
            <div class="panel-note faint">
                @(Agent is null
                    ? "Pick an agent to talk to it here."
                    : Side == PanelSide.Bottom ? "Nothing to show." : "This agent is not working in a git worktree, so there is nothing to show here.")
            </div>
        }
        else
        {
            var agent = Agent;
            var worktree = Worktree;
            @* One loop for the tabs on screen and the parked ones, so a parked view
               coming back matches its own key among the same siblings and keeps
               its instance. *@
            @foreach (var (tab, key, parked) in Layers(agent?.SessionId, worktree))
            {
                var active = !parked && tab.Key == ActiveKey;
                <div class="ptab-layer @(active ? "" : "hidden")" @key="key">
                    @switch (tab.Key)
                    {
                        case Workbench.FilesTab:
                            <FileTreePanel WorktreePath="@(worktree!)" />
                            break;

                        case Workbench.SourceControlTab:
                            <SourceControlPanel WorktreePath="@(worktree!)" SessionId="@agent?.SessionId" />
                            break;

                        case Workbench.ChatTab:
                            <ChatPanel SessionId="@agent!.SessionId" IsVisible="@(active && Bench.Panel(Side).Open)" />
                            break;

                        default:
                            @* Keyed by generation as well, so a reloaded extension's view
                               is built fresh from the new copy's type rather than handed
                               new parameters. *@
                            <div class="panel-scroll ext-view">
                                <ExtensionViewHost Live="tab.View!" Agent="@tab.Agent" Worktree="@tab.Worktree"
                                                   IsVisible="@(active && Bench.Panel(Side).Open)" Parked="parked" />
                            </div>
                            break;
                    }
                </div>
            }
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public PanelSide Side { get; set; }

    private sealed record Tab(string Key, string Title, LiveView? View = null, string? Count = null, string? Tone = null, string? Tooltip = null)
    {
        /// <summary>What an extension's view is drawn for: an agent view gets the agent, a worktree view the worktree and the agent in it, if any.</summary>
        public AgentsDashboard.Extensions.AgentContext? Agent { get; init; }

        public AgentsDashboard.Extensions.WorktreeContext? Worktree { get; init; }
    }

    /// <summary>The tabs opened for the agent on screen, which stay built until the panel moves to another.</summary>
    private readonly HashSet<string> _visited = new(StringComparer.Ordinal);
    private (string?, string?) _shown;

    /// <summary>What a layer is keyed by: a tab, the extension copy it came from, and whom it was built for.</summary>
    private readonly record struct LayerKey(string Tab, int? Generation, string? SessionId, string? Worktree);

    /// <summary>
    /// Extension views built for an agent or worktree no longer on screen, kept
    /// hidden so switching back finds them as they were. An extension may read a
    /// lot when it starts, and paying that on every switch would make the app
    /// feel slow for something it does not control. The app's own tabs are cheap
    /// to rebuild and should show the worktree afresh, so they are not kept.
    /// </summary>
    private readonly Dictionary<LayerKey, Tab> _parked = [];

    /// <summary>
    /// The tabs as last drawn. By the time a switch is noticed <see cref="Tabs"/>
    /// already describes the agent arriving, so the one leaving is parked from these.
    /// </summary>
    private List<Tab> _drawn = [];

    private IEnumerable<(Tab Tab, LayerKey Key, bool Parked)> Layers(string? sessionId, string? worktree)
    {
        foreach (var tab in Tabs.Where(t => _visited.Contains(t.Key)))
        {
            yield return (tab, new LayerKey(tab.Key, tab.View?.Generation, sessionId, worktree), false);
        }

        foreach (var (key, tab) in _parked)
        {
            yield return (tab, key, true);
        }
    }

    private string Label => Side switch
    {
        PanelSide.Left => "Left panel",
        PanelSide.Right => "Right panel",
        _ => "Bottom panel",
    };

    private ChatTarget? Agent => Bench.Agent(Snapshot.Value);

    /// <summary>The agent's worktree, or with no agent in view the one left open when it went.</summary>
    private string? Worktree => Bench.WorktreeInView(Snapshot.Value);

    private List<Tab> Tabs
    {
        get
        {
            var tabs = new List<Tab>();
            var agent = Agent;
            var worktree = Worktree;

            // The app's own tab leads each panel. The files and the diff need a
            // worktree, which outlasts its agent; the conversation needs an agent.
            switch (Side)
            {
                case PanelSide.Left when worktree is not null:
                    tabs.Add(new Tab(Workbench.FilesTab, "Files"));
                    break;
                case PanelSide.Right when worktree is not null:
                    tabs.Add(new Tab(Workbench.SourceControlTab, "Source control", Count: ChangeCount(worktree)));
                    break;
                case PanelSide.Bottom when agent is not null:
                    tabs.Add(new Tab(Workbench.ChatTab, "Chat"));
                    break;
            }

            // An agent view needs an agent. A worktree view needs only the
            // worktree in view, which is there with no agent picked, and is
            // told about the agent only when that agent works in it.
            var api = agent is null ? null : ApiModel.Agent(agent, State);
            var tree = worktree is null ? null : ApiModel.Worktree(worktree, State);
            var agentHere = api is not null && api.Worktree?.Path == tree?.Path ? api : null;
            foreach (var live in Extensions.Views.Where(v => Workbench.SideOf(v.View.DefaultLocation) == Side))
            {
                var (forAgent, forWorktree) = live.View.ForWorktree ? (agentHere, tree) : (api, null);
                if (live.View.ForWorktree ? forWorktree is null || !Applies(live, forWorktree) : forAgent is null || !Applies(live, forAgent))
                {
                    continue;
                }

                var indicator = forWorktree is not null
                    ? Extensions.IndicatorFor(live.View, forWorktree)
                    : Extensions.IndicatorFor(live.View, forAgent!);
                tabs.Add(new Tab(live.View.Key, live.View.Title, live, indicator?.Text, indicator is null ? null : ToneClass(indicator.Tone), indicator?.Tooltip)
                {
                    Agent = forAgent,
                    Worktree = forWorktree,
                });
            }

            return tabs;
        }
    }

    /// <summary>The tab in front: the one chosen, or the first when that one is not here for this agent.</summary>
    private string? ActiveKey
    {
        get
        {
            var tabs = Tabs;
            var wanted = Bench.Panel(Side).Tab;
            return tabs.Any(t => t.Key == wanted) ? wanted : tabs.FirstOrDefault()?.Key;
        }
    }

    /// <summary>A view whose filter throws is left out rather than taking the panel down with it.</summary>
    private static bool Applies(LiveView live, AgentsDashboard.Extensions.AgentContext agent)
    {
        try
        {
            return live.View.AppliesTo?.Invoke(agent) ?? true;
        }
        catch (Exception)
        {
            return false;
        }
    }

    private static bool Applies(LiveView live, AgentsDashboard.Extensions.WorktreeContext worktree)
    {
        try
        {
            return live.View.WorktreeAppliesTo?.Invoke(worktree) ?? true;
        }
        catch (Exception)
        {
            return false;
        }
    }

    private string? ChangeCount(string path) =>
        State.Worktree(path)?.Status is { } s && s.Changed + s.Staged + s.Untracked is > 0 and var n
            ? n.ToString(System.Globalization.CultureInfo.InvariantCulture)
            : null;

    private static string ToneClass(AgentsDashboard.Extensions.Tone tone) => tone switch
    {
        AgentsDashboard.Extensions.Tone.Danger => "danger",
        AgentsDashboard.Extensions.Tone.Warning => "warning",
        AgentsDashboard.Extensions.Tone.Success => "success",
        AgentsDashboard.Extensions.Tone.Info => "info",
        _ => "",
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Bench.Changed += OnChanged;
        Extensions.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnParametersSet() => Track();

    /// <summary>
    /// Keeps the set of built tabs. Moving to another agent parks the extension
    /// views built for the one leaving, clears the rest, and takes back what was
    /// parked for the one arriving. The tab in front is always added.
    /// </summary>
    private void Track()
    {
        var shown = (Bench.SessionId, Worktree);
        if (_shown != shown)
        {
            var (leftSession, leftWorktree) = _shown;
            foreach (var tab in _drawn.Where(t => t.View is not null && _visited.Contains(t.Key)))
            {
                _parked[new LayerKey(tab.Key, tab.View!.Generation, leftSession, leftWorktree)] = tab;
            }

            _shown = shown;
            _visited.Clear();

            foreach (var key in _parked.Keys.Where(k => k.SessionId == shown.SessionId && k.Worktree == shown.Worktree).ToList())
            {
                _parked.Remove(key);
                _visited.Add(key.Tab);
            }
        }

        if (ActiveKey is { } active)
        {
            _visited.Add(active);
        }

        _drawn = Tabs;
        Prune();
    }

    /// <summary>
    /// Drops parked views whose agent has gone from the list, whose worktree has
    /// gone, or whose extension has been reloaded or removed, so the cache holds
    /// only what could still be switched back to.
    /// </summary>
    private void Prune()
    {
        if (_parked.Count == 0)
        {
            return;
        }

        var agents = Directory.Targets(Snapshot.Value).Select(t => t.SessionId).ToHashSet(StringComparer.Ordinal);
        var live = Extensions.Views.Select(v => (v.View.Key, v.Generation)).ToHashSet();
        foreach (var key in _parked.Keys.ToList())
        {
            if ((key.SessionId is { } id && !agents.Contains(id))
                || (key.Worktree is { } path && State.Worktree(path) is null)
                || !live.Contains((key.Tab, key.Generation ?? -1)))
            {
                _parked.Remove(key);
            }
        }
    }

    protected override bool ShouldRender()
    {
        // Every render path comes through here, the snapshot's and the bench's,
        // so this is where the tab in front is marked as built.
        Track();
        return true;
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Bench.Changed -= OnChanged;
            Extensions.Changed -= OnChanged;
        }

        base.Dispose(disposing);
    }
}
