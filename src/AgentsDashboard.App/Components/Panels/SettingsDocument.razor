@inherits StateComponent
@inject SettingsStore Store
@inject MonitorService Monitor
@inject AgentHost Host
@inject FolderPicker Folders
@inject IJSRuntime Js

@* Settings, as a tab in the editor like VS Code's, so it closes like any other
   tab and the agent you were on stays where it was. *@

<div class="page settings-page">
    <div class="page-head"><h1>Settings</h1></div>

    @if (Monitor.LastError is { Length: > 0 } error)
    {
        <div class="banner danger settings-banner">
            <strong>The last refresh failed.</strong>
            <p class="mono muted" style="margin: 5px 0 0;">@error</p>
        </div>
    }

    <div class="settings-layout">
        @* Grouped the way VS Code's settings are, a list of sections down the
           side, since one long page had grown past what reads at a glance. *@
        <nav class="settings-nav" role="tablist" @ref="_nav" aria-orientation="vertical" aria-label="Settings sections">
            @foreach (var section in Sections)
            {
                var id = section.Id;
                var on = id == _section;
                <button type="button" role="tab" id="@("settings-tab-" + id)"
                        class="settings-tab @(on ? "on" : "")"
                        aria-selected="@(on ? "true" : "false")"
                        aria-controls="settings-panel"
                        tabindex="@(on ? 0 : -1)"
                        @ref="_tabs[id]"
                        @onclick="() => _section = id"
                        @onkeydown="e => OnTabKey(e, id)">
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <path d="@section.Icon" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>@section.Title</span>
                    @if (section.Count is { } count)
                    {
                        <span class="settings-tab-count nums">@count</span>
                    }
                </button>
            }
        </nav>

        <section class="settings-panel" id="settings-panel" role="tabpanel"
                 aria-labelledby="@("settings-tab-" + _section)">
            @switch (_section)
            {
                case "agents":
                    <header class="settings-section-head">
                        <h2>New agents</h2>
                        <p class="muted">What every start form begins with. Each can still be changed per agent.</p>
                    </header>

                    <div class="card">
                        <div class="row setting-row">
                            <div class="stack" style="flex: 1;">
                                <strong>Default model</strong>
                                <span class="faint">
                                    Preselected in every start form. Left to the agent, the model your own Claude
                                    settings already choose keeps applying.
                                </span>
                            </div>
                            <Picker AriaLabel="Default model" Class="setting-picker"
                                    Value="@(_settings.DefaultModel ?? "")"
                                    Options="@Choices("model")"
                                    ValueChanged="v => Set(_settings with { DefaultModel = Blank(v) })" />
                        </div>

                        <div class="row setting-row">
                            <div class="stack" style="flex: 1;">
                                <strong>Default effort</strong>
                                <span class="faint">How hard a new agent thinks before it answers.</span>
                            </div>
                            <Picker AriaLabel="Default effort" Class="setting-picker"
                                    Value="@(_settings.DefaultEffort ?? "")"
                                    Options="@Choices("effort")"
                                    ValueChanged="v => Set(_settings with { DefaultEffort = Blank(v) })" />
                        </div>

                        <div class="row setting-row">
                            <div class="stack" style="flex: 1;">
                                <strong>Default permission mode</strong>
                                <span class="faint">What a new agent may do without asking you first.</span>
                            </div>
                            <Picker AriaLabel="Default permission mode" Class="setting-picker"
                                    Value="@(_settings.DefaultPermissionMode ?? "")"
                                    Options="@Choices("mode")"
                                    ValueChanged="v => Set(_settings with { DefaultPermissionMode = Blank(v) })" />
                        </div>
                    </div>
                    break;

                case "appearance":
                    <header class="settings-section-head">
                        <h2>Appearance</h2>
                        <p class="muted">How the dashboard looks.</p>
                    </header>

                    <div class="card">
                        <div class="row setting-row">
                            <div class="stack" style="flex: 1;">
                                <strong>Theme</strong>
                                <span class="faint">
                                    The colours of the whole window, the editor and diffs included. A diff already
                                    coloured keeps its syntax colours until it is reopened.
                                </span>
                            </div>
                            <Picker AriaLabel="Theme" Class="setting-picker"
                                    Value="@Themes.Resolve(_settings.Theme)"
                                    Options="@ThemeChoices"
                                    ValueChanged="SetTheme" />
                        </div>
                    </div>
                    break;

                case "notifications":
                    <header class="settings-section-head">
                        <h2>Notifications</h2>
                        <p class="muted">When the dashboard interrupts you.</p>
                    </header>

                    <div class="card">
                        <label class="row setting-row">
                            <div class="stack" style="flex: 1;">
                                <strong>Notify when an agent starts waiting</strong>
                                <span class="faint">
                                    One notification per time an agent blocks, never repeated while it stays there,
                                    and nothing for agents that were already blocked when the app opened.
                                </span>
                            </div>
                            <input type="checkbox" class="switch" role="switch" checked="@_settings.NotifyOnWaiting"
                                   @onchange="e => Set(_settings with { NotifyOnWaiting = (bool)e.Value! })"
                                   aria-label="Notify when an agent starts waiting" />
                        </label>
                    </div>
                    break;

                case "extensions":
                    <header class="settings-section-head">
                        <h2>Extensions</h2>
                        <p class="muted">Tabs, panels and tools added to the dashboard, each turned on here.</p>
                    </header>

                    <ExtensionsCard />
                    break;

                default:
                    <header class="settings-section-head">
                        <h2>Repositories</h2>
                        <p class="muted">The repositories you add here are the ones New agent offers to start in.</p>
                    </header>

                    <div class="card">
                        <div class="card-body">
                            <div class="inline">
                                @* An explicit value plus oninput rather than @@bind: two-way binding
                                   will not push a value the component itself cleared back into the
                                   DOM, so the field would keep the path after it was added. *@
                                <input type="text" placeholder="/Users/you/code/your-repo"
                                       aria-label="Repository path"
                                       style="flex: 1; width: auto;"
                                       value="@_newRoot"
                                       @oninput="e => _newRoot = e.Value?.ToString() ?? string.Empty"
                                       @onkeydown="OnAddKey" />
                                @if (Folders.Available)
                                {
                                    <button class="primary" @onclick="Browse" disabled="@_picking">Choose folder...</button>
                                    <button @onclick="Add" disabled="@string.IsNullOrWhiteSpace(_newRoot)">Add</button>
                                }
                                else
                                {
                                    <button class="primary" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(_newRoot)">Add</button>
                                }
                            </div>
                            @if (_error is { Length: > 0 })
                            {
                                <p class="faint" style="margin: 8px 0 0; color: var(--danger);">@_error</p>
                            }
                        </div>

                        @if (_settings.RepoRoots.Count == 0)
                        {
                            <div class="row faint">None yet. Add one above, or pick one Claude is already running in.</div>
                        }

                        @foreach (var root in ByName(_settings.RepoRoots, r => State.Repo(r)?.Name ?? Fmt.Leaf(r)))
                        {
                            var known = State.Repo(root);
                            <div class="row">
                                <div class="stack" style="flex: 1; min-width: 0;">
                                    <strong>@(known?.Name ?? Fmt.Leaf(root))</strong>
                                    <span class="mono faint truncate">@root</span>
                                </div>
                                @if (known is not null)
                                {
                                    <span class="chip">@Fmt.Count(known.Worktrees.Count, "worktree")</span>
                                }
                                else if (!Directory.Exists(root))
                                {
                                    <span class="chip danger" title="There is no directory at this path any more">missing</span>
                                }
                                <button class="ghost small" @onclick="() => Remove(root)">Remove</button>
                            </div>
                        }
                    </div>

                    @if (Discovered.Count > 0)
                    {
                        <h3 class="settings-subhead">Running elsewhere</h3>
                        <div class="card">
                            <div class="row faint">
                                Claude sessions are running in these, but they are not in your list. Add one to start
                                new agents in it.
                            </div>
                            @foreach (var repo in ByName(Discovered, r => r.Name))
                            {
                                <div class="row">
                                    <div class="stack" style="flex: 1; min-width: 0;">
                                        <strong>@repo.Name</strong>
                                        <span class="mono faint truncate">@repo.Root</span>
                                    </div>
                                    <button class="small" @onclick="() => AddRoot(repo.Root)">Add</button>
                                    <button class="ghost small" @onclick="() => Hide(repo.Root)">Hide</button>
                                </div>
                            }
                        </div>
                    }

                    @if (_settings.HiddenRoots.Count > 0)
                    {
                        <h3 class="settings-subhead">Hidden</h3>
                        <div class="card">
                            @foreach (var root in ByName(_settings.HiddenRoots, r => r))
                            {
                                <div class="row">
                                    <span class="mono truncate" style="flex: 1;">@root</span>
                                    <button class="ghost small" @onclick="() => Unhide(root)">Show again</button>
                                </div>
                            }
                        </div>
                    }
                    break;
            }
        </section>
    </div>
</div>

@code {
    private Settings _settings = new();
    private string _section = "repos";

    private ElementReference _nav;
    private readonly Dictionary<string, ElementReference> _tabs = [];
    private bool _focusTab;

    private sealed record Section(string Id, string Title, string Icon, int? Count = null);

    private IReadOnlyList<Section> Sections =>
    [
        new("repos", "Repositories", "M3 2.5h7l3 3v8H3zM6 7.5h4M6 10h4", _settings.RepoRoots.Count),
        new("agents", "New agents", "M8 2.5v3M5.5 5.5h5a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2zM6.5 9.5h0M9.5 9.5h0"),
        new("appearance", "Appearance", "M8 2.5a5.5 5.5 0 1 0 0 11a5.5 5.5 0 0 0 0-11zM8 2.5v11M8 5h3.5M8 8h5M8 11h3.5"),
        new("notifications", "Notifications", "M4 11V7.5a4 4 0 0 1 8 0V11l1 1.5H3zM6.5 14h3"),
        new("extensions", "Extensions", "M6 2.5h4v3h3v4h-3v4H6v-4H3v-4h3z"),
    ];

    /// <summary>Up and down move between sections, the way a vertical tab list is walked.</summary>
    private void OnTabKey(KeyboardEventArgs e, string id)
    {
        var ids = Sections.Select(s => s.Id).ToList();
        var at = ids.IndexOf(id);
        var next = e.Key switch
        {
            "ArrowDown" => ids[(at + 1) % ids.Count],
            "ArrowUp" => ids[(at - 1 + ids.Count) % ids.Count],
            "Home" => ids[0],
            "End" => ids[^1],
            _ => null,
        };

        if (next is not null)
        {
            _section = next;
            _focusTab = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await Js.InvokeVoidAsync("agentsDashboard.bindTablist", _nav);
            }

            if (_focusTab && _tabs.TryGetValue(_section, out var tab))
            {
                _focusTab = false;
                await tab.FocusAsync();
            }
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
        }
    }

    /// <summary>A setting's choices, led by the blank that leaves it to the agent.</summary>
    private IReadOnlyList<PickerOption> Choices(string id) =>
    [
        new("", "Leave to the agent", "Its own default applies"),
        .. StartChoices.For(id, Host.KnownOptions).Select(c => new PickerOption(c.Value, c.Name)),
    ];
    private static readonly IReadOnlyList<PickerOption> ThemeChoices =
        Themes.All.Select(t => new PickerOption(t.Id, t.Name, t.Description)).ToList();

    /// <summary>
    /// Saves the choice and repaints this window straight away. The page only
    /// reads the stored theme when it loads, so another window open at the time
    /// changes on its next start.
    /// </summary>
    private async Task SetTheme(string? value)
    {
        var id = Themes.Resolve(value);
        Set(_settings with { Theme = id == Themes.System ? null : id });

        try
        {
            await Js.InvokeVoidAsync("agentsTheme.set", id);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    private string _newRoot = "";
    private string? _error;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _settings = Store.Load();
    }

    private bool _picking;

    /// <summary>
    /// Opens the system folder chooser and adds what comes back, the same as
    /// typing the path and pressing Add. Cancelling leaves the field alone.
    /// </summary>
    private async Task Browse()
    {
        _picking = true;
        try
        {
            var start = Directory.Exists(_newRoot.Trim()) ? _newRoot.Trim() : null;
            if (await Folders.PickAsync("Choose a repository", start) is { } chosen)
            {
                _newRoot = chosen;
                Add();
            }
        }
        finally
        {
            _picking = false;
        }
    }

    private void OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Add();
        }
    }

    private void Add()
    {
        var root = _newRoot.Trim();
        _error = null;

        if (root.Length == 0)
        {
            return;
        }

        if (!Directory.Exists(root))
        {
            _error = "There is no directory at that path.";
            return;
        }

        if (!Directory.Exists(Path.Combine(root, ".git")) && !File.Exists(Path.Combine(root, ".git")))
        {
            // Not fatal: discovery resolves any directory inside a repo up to its
            // root. Worth saying so rather than silently accepting nothing.
            _error = "That is not a repository root, but it will be resolved to one if it is inside a repository.";
        }

        AddRoot(root);
        _newRoot = "";
    }

    private void AddRoot(string root) => Set(_settings with
    {
        RepoRoots = [.. _settings.RepoRoots.Where(r => r != root), root],
        HiddenRoots = _settings.HiddenRoots.Where(r => r != root).ToArray(),
    });

    /// <summary>
    /// Takes a repository off the list. It is not hidden: while Claude runs in
    /// it, it still shows up under Running elsewhere.
    /// </summary>
    private void Remove(string root) =>
        Set(_settings with { RepoRoots = _settings.RepoRoots.Where(r => r != root).ToArray() });

    /// <summary>
    /// A list in name order. The settings file keeps repositories in the order they
    /// were added, which says nothing to someone looking for one.
    /// </summary>
    private static IEnumerable<T> ByName<T>(IEnumerable<T> items, Func<T, string> name) =>
        items.OrderBy(name, StringComparer.OrdinalIgnoreCase);

    /// <summary>Repositories the monitor found through live sessions that are not in the list.</summary>
    private IReadOnlyList<RepoView> Discovered =>
        Snapshot.Repos.Where(r => !_settings.RepoRoots.Contains(r.Root, StringComparer.Ordinal)).ToList();

    private void Hide(string root) => Set(_settings with
    {
        HiddenRoots = [.. _settings.HiddenRoots.Where(r => r != root), root],
        RepoRoots = _settings.RepoRoots.Where(r => r != root).ToArray(),
    });

    private void Unhide(string root) =>
        Set(_settings with { HiddenRoots = _settings.HiddenRoots.Where(r => r != root).ToArray() });

    /// <summary>
    /// A blank choice means "say nothing", which is not the same as a value: it
    /// leaves the agent's own default in place rather than pinning one here.
    /// </summary>
    private static string? Blank(object? value) =>
        value?.ToString() is { Length: > 0 } chosen ? chosen : null;

    private void Set(Settings next)
    {
        _settings = next;
        Store.Save(next);

        // The repo list is read on the monitor's slow timer. Waiting up to twenty
        // seconds to see a repository you just added would read as broken.
        Monitor.InvalidateWorktrees();
    }
}
