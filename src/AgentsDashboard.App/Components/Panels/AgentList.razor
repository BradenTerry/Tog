@inherits StateComponent
@inject AgentDirectory Directory
@inject Workbench Bench
@inject NavigationManager Nav
@inject WorktreeInventory Inventory
@inject WorktreeViews Views

@* Every agent, down the right of the bottom panel beside the conversation, like a
   messaging app's list of conversations. Picking one moves every panel to it. *@

<div class="agent-list">
    <div class="agent-list-head">
        <span class="panel-label">Agents</span>
        @if (Snapshot.Waiting.Count > 0)
        {
            <span class="chip waiting" title="@Fmt.Count(Snapshot.Waiting.Count, "agent") waiting on you">@Snapshot.Waiting.Count waiting</span>
        }
        <button type="button" class="icon-btn spacer @(Bench.NewAgentOpen ? "active" : "")" @onclick="Bench.OpenNewAgent"
                title="New agent" aria-label="New agent" aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </button>
    </div>

    <div class="chat-list-items">
        @if (Targets.Count == 0)
        {
            <p class="faint chat-list-empty">No agents yet. Start one with New agent.</p>
        }

        @foreach (var target in Targets)
        {
            <a class="chat-item @(target.SessionId == Bench.SessionId && IsAtAgent ? "active" : "")" href="@Urls.Chat(target.SessionId)"
               title="@($"{target.Label} ({target.Where}, {AgentDirectory.StateWord(target)})")">
                <span class="dot @AgentDirectory.DotClass(target.State)" aria-hidden="true"></span>
                <span class="chat-item-body">
                    <span class="chat-item-top">
                        <span class="chat-item-name @(target.LabelIsPrompt ? "untitled" : "")">@target.Label</span>
                        @* A running clock for an agent that is doing something, or
                           waiting; a fixed time for one that has stopped, since a
                           ticking clock beside it reads as though it were still going. *@
                        <span class="chat-item-time">
                            @(target.State is ChatState.Parked or ChatState.Failed
                                ? Fmt.At(target.Since, Snapshot.Value.TakenAt)
                                : Fmt.Duration(Snapshot.Value.TakenAt - target.Since))
                        </span>
                    </span>
                    <span class="chat-item-where">@target.Where</span>
                    @if (target.BackgroundCount > 0 && target.State is not (ChatState.Parked or ChatState.Failed))
                    {
                        <span class="chat-item-bg">@target.BackgroundCount running in background</span>
                    }
                    @if (target.WaitingFor is { Length: > 0 } question)
                    {
                        <span class="chat-item-snippet waiting">@AgentSession.Shorten(question, 80)</span>
                    }
                    else if (target.LastReply is { Length: > 0 } reply)
                    {
                        <span class="chat-item-snippet">@AgentSession.Shorten(reply, 80)</span>
                    }
                    else if (target.State is ChatState.Parked or ChatState.Failed)
                    {
                        <span class="chat-item-snippet">@AgentDirectory.StateWord(target)</span>
                    }
                </span>
            </a>
            @if (Offer(target) is { } offer)
            {
                <div class="cleanup-offer" role="note">
                    <span class="cleanup-offer-text">
                        @(offer.Merge == MergeState.SquashMerged ? $"{offer.Base} has its changes." : $"Merged into {offer.Base}.")
                        The worktree is clean and holds @Fmt.Bytes(offer.TotalBytes).
                    </span>
                    <button class="small" @onclick="() => AskRemove(target)">Remove...</button>
                    <button class="ghost small" @onclick="() => Keep(target)">Keep</button>
                </div>
            }
        }
    </div>
</div>

@code {
    private IReadOnlyList<ChatTarget> Targets => Directory.Targets(Snapshot.Value);

    private string Relative => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];

    /// <summary>The selection is shown only while an agent's view is the page, not over Settings.</summary>
    private bool IsAtAgent => Relative.Length == 0 || Relative.StartsWith("chat", StringComparison.Ordinal);

    /// <summary>Each agent's state at the last snapshot, to see one stop.</summary>
    private readonly Dictionary<string, ChatState> _was = new(StringComparer.Ordinal);

    /// <summary>
    /// The facts behind an offer to remove a stopped agent's worktree: clean,
    /// nothing only here, and merged. A worktree that never had commits is safe
    /// too, but offering to remove it would nag about every agent that answered
    /// a question and changed nothing. Only after an agent has stopped: an
    /// attached one is still using its worktree.
    /// </summary>
    private WorktreeFacts? Offer(ChatTarget target)
    {
        if (target.State != ChatState.Parked || target.WorktreePath is not { } path || Views.For(path).CleanupDismissed)
        {
            return null;
        }

        var place = Place(path);
        if (place is null || place.Value.View.Worktree.IsPrimary)
        {
            return null;
        }

        var facts = Inventory.Facts(path);
        var state = WorktreeCleanup.Classify(place.Value.View.Worktree, facts, place.Value.View.Agents.Count > 0, hostsDashboard: false);
        return state == CleanupState.SafeToRemove && facts!.Merge is MergeState.Merged or MergeState.SquashMerged ? facts : null;
    }

    private (RepoView Repo, WorktreeView View)? Place(string path)
    {
        foreach (var repo in Snapshot.Repos)
        {
            if (repo.Worktrees.FirstOrDefault(w => w.Worktree.Path == path) is { } view)
            {
                return (repo, view);
            }
        }

        return null;
    }

    /// <summary>
    /// Opens the Worktrees tab over the agent in view, on the remove dialog for
    /// this worktree. The dialog is what removes it, as it is from the tab.
    /// </summary>
    private void AskRemove(ChatTarget target)
    {
        var inView = Targets.FirstOrDefault(t => t.SessionId == Bench.SessionId)?.WorktreePath;
        Bench.OpenWorktrees(inView, target.WorktreePath);
    }

    private void Keep(ChatTarget target)
    {
        if (target.WorktreePath is { } path)
        {
            Views.For(path).CleanupDismissed = true;
        }
    }

    /// <summary>
    /// Stopped agents' worktrees are measured once, and again when an agent
    /// stops, since that is when its work is finished. Merges land when you
    /// fetch or pull, which the Worktrees view picks up when it is opened.
    /// </summary>
    private void OnSnapshotForOffers()
    {
        foreach (var target in Directory.Targets(State.Snapshot))
        {
            var stopped = target.State == ChatState.Parked
                          && _was.TryGetValue(target.SessionId, out var before) && before != ChatState.Parked;
            _was[target.SessionId] = target.State;

            if (target.State != ChatState.Parked || target.WorktreePath is not { } path || Place(path) is not { } place)
            {
                continue;
            }

            if (!place.View.Worktree.IsPrimary)
            {
                Inventory.Refresh(place.Repo, place.View.Worktree, stopped ? Remeasure.All : Remeasure.Missing);
            }
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        State.Changed += OnSnapshotForOffers;
        Inventory.Changed += OnDirectoryChanged;
        Nav.LocationChanged += OnLocationChanged;
        Directory.Changed += OnDirectoryChanged;
        Bench.Changed += OnDirectoryChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnDirectoryChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            State.Changed -= OnSnapshotForOffers;
            Inventory.Changed -= OnDirectoryChanged;
            Nav.LocationChanged -= OnLocationChanged;
            Directory.Changed -= OnDirectoryChanged;
            Bench.Changed -= OnDirectoryChanged;
        }

        base.Dispose(disposing);
    }
}
