@inject Workbench Bench
@implements IDisposable

@* Settings, as a dialog over the window like New agent rather than a tab in
   the editor: it belongs to no file and no worktree, and closing it leaves the
   agent and its files exactly as they were. Escape, the close button or a
   click outside close it. The key recorder in Keyboard shortcuts and an open
   Picker keep their own Escape from reaching it. *@

@if (Bench.SettingsOpen)
{
    <div class="modal-backdrop" @onclick="Bench.CloseSettings">
        <div class="modal settings-dialog" role="dialog" aria-modal="true" aria-labelledby="settings-title" tabindex="-1"
             @ref="_dialog" @onclick:stopPropagation @onkeydown="OnKey">
            <header class="modal-head">
                <h2 id="settings-title">Settings</h2>
                <button type="button" class="icon-btn spacer" @onclick="Bench.CloseSettings" title="Close" aria-label="Close">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </button>
            </header>
            <div class="settings-dialog-body">
                <SettingsDocument />
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _dialog;
    private bool _wasOpen;

    protected override void OnInitialized() => Bench.Changed += OnChanged;

    /// <summary>
    /// Only redraws when it opens or closes: Settings draws itself, and the
    /// workbench changes far more often than that.
    /// </summary>
    private void OnChanged() => _ = InvokeAsync(() =>
    {
        if (Bench.SettingsOpen != _wasOpen)
        {
            _wasOpen = Bench.SettingsOpen;
            StateHasChanged();
        }
    });

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Bench.CloseSettings();
        }
    }

    public void Dispose() => Bench.Changed -= OnChanged;
}
