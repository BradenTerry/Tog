@inherits StateComponent
@inject Workbench Bench
@inject AgentDirectory Directory
@inject AgentHost Host
@inject IJSRuntime Js

@* Along the bottom of the window, as VS Code's status bar: the directory the
   agent in view works in. The worktree and branch are in the header above, so
   they are not repeated here. On the right, how much of the Claude plan is
   used, as the last turn reported it. *@

<footer class="statusbar" aria-label="Where the agent works and plan usage">
    @if (Agent is { } agent)
    {
        var directory = agent.WorktreePath ?? agent.Cwd;
        @* A worktree path runs to a hundred characters and pushes everything
           else off the bar. The folder name tells worktrees apart; the full
           path is in the tooltip and a click away on the clipboard. *@
        <span class="status-item" title="@directory">
            <span class="status-label">Directory</span>
            <span class="mono truncate">.../@Fmt.Leaf(directory)</span>
            <button class="ghost status-copy" @onclick="() => Copy(directory)"
                    title="Copy the full path">@(_copied == directory ? "Copied" : "Copy")</button>
        </span>
    }
    else
    {
        <span class="status-item faint">No agent selected</span>
    }
    @if (Limits.Count > 0)
    {
        var now = DateTimeOffset.Now;
        @* Used against elapsed is the figure that matters: 60% used is fine with
           80% of the window gone and trouble with 20%. A fill past the time
           marker reads at a glance where two percentages had to be compared.
           The reset times and the rest are a click away rather than taking the
           bar. *@
        <button class="status-plan" @onclick="() => _details = !_details" aria-expanded="@_details"
                title="Plan usage: the fill is the share used, the marker how much of the window has gone by. Click for details.">
            @foreach (var limit in Limits)
            {
                <span class="status-item plan-limit @LimitClass(limit)" title="@Summary(limit, now)">
                    <span class="status-label">@limit.Label</span>
                    @Meter(limit, now)
                    <span>@Figure(limit)</span>
                </span>
            }
        </button>
        @if (_details)
        {
            <div class="context-backdrop" @onclick="() => _details = false"></div>
            <div class="plan-details" role="dialog" aria-label="Plan usage">
                @foreach (var limit in Limits)
                {
                    <div class="plan-detail @LimitClass(limit)">
                        <div class="plan-detail-head">
                            <strong>@limit.Label</strong>
                            <span>@Figure(limit) used</span>
                        </div>
                        @if (limit.Elapsed(now) is { } elapsed && limit.Length is { } length)
                        {
                            @Meter(limit, now)
                            <div class="faint">@Percent(elapsed) of the @Span(length) window gone by</div>
                            @if (Pace(limit, elapsed) is { } pace)
                            {
                                <div class="faint">@pace</div>
                            }
                        }
                        @if (limit.ResetsAt is { } reset)
                        {
                            <div class="faint">Resets in @Span(reset - now), @When(reset)</div>
                        }
                    </div>
                }
                <div class="faint plan-seen">As of @Fmt.DayClock(Limits.Max(l => l.SeenAt).ToLocalTime()), the last turn that reported it.</div>
            </div>
        }
    }
</footer>

@code {
    private ChatTarget? Agent =>
        Bench.SessionId is { } id ? Directory.Targets(Snapshot.Value).FirstOrDefault(t => t.SessionId == id) : null;

    /// <summary>The limits worth a place: a figure to show, or a warning without one.</summary>
    private IReadOnlyList<PlanLimit> Limits =>
        Host.PlanLimits.Where(l => l.Percent is not null || l.Blocked || l.Warning).ToList();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Bench.Changed += OnChanged;
    }

    /// <summary>Red when Claude refuses, amber when it warns or past 75%, the line its own warnings start at.</summary>
    private static string LimitClass(PlanLimit limit) =>
        limit.Blocked ? "high" : limit.Warning || limit.Percent >= 75 ? "warn" : "";

    private static string Figure(PlanLimit limit) => limit switch
    {
        { Blocked: true } => "limit reached",
        { Percent: { } percent, AtLeast: true } => $"over {percent}%",
        { Percent: { } percent } => $"{percent}%",
        _ => "near limit",
    };

    private bool _details;

    private static string Percent(double share) => $"{(int)Math.Round(share * 100)}%";

    private static string Width(double? share) =>
        FormattableString.Invariant($"{Math.Clamp(share ?? 0, 0, 1) * 100:0.#}%");

    /// <summary>
    /// The share used as a fill, with a marker at the share of the window gone
    /// by. A refusal with no figure fills the track, since the limit is spent.
    /// </summary>
    private static RenderFragment Meter(PlanLimit limit, DateTimeOffset now) => __builder =>
    {
        <span class="plan-meter" aria-hidden="true">
            <span class="plan-meter-fill" style="width: @Width(limit.Blocked && limit.Percent is null ? 1 : limit.Percent / 100.0)"></span>
            @if (limit.Elapsed(now) is { } elapsed)
            {
                <span class="plan-meter-now" style="left: @Width(elapsed)"></span>
            }
        </span>
    };

    private static string Summary(PlanLimit limit, DateTimeOffset now) =>
        limit.Elapsed(now) is { } elapsed
            ? $"{limit.Label}: {Figure(limit)} used, {Percent(elapsed)} of the window gone by"
            : $"{limit.Label}: {Figure(limit)} used";

    /// <summary>
    /// Where the current rate lands by the reset. Left out early in a window,
    /// where a few minutes of work project to nonsense.
    /// </summary>
    private static string? Pace(PlanLimit limit, double elapsed)
    {
        if (limit.Blocked || limit.AtLeast || limit.Percent is not { } percent || elapsed < 0.1)
        {
            return null;
        }

        var projected = (int)Math.Round(percent / elapsed);
        return projected > 100
            ? $"At this rate it runs out before the reset (on pace for {projected}%)"
            : $"On pace for about {projected}% by the reset";
    }

    /// <summary>A time left in days and hours past a day, as a weekly window needs.</summary>
    private static string Span(TimeSpan span) =>
        span.TotalDays >= 1 ? $"{(int)span.TotalDays}d {span.Hours}h" : Fmt.Duration(span);

    /// <summary>The time alone within the day, with the weekday past that.</summary>
    private static string When(DateTimeOffset at)
    {
        var local = at.ToLocalTime();
        return local - DateTimeOffset.Now < TimeSpan.FromHours(20) ? Fmt.Clock(local) : Fmt.DayClock(local);
    }

    /// <summary>The path just copied, so its button says so until the next copy.</summary>
    private string? _copied;

    private async Task Copy(string path)
    {
        try
        {
            _copied = await Js.InvokeAsync<bool>("tog.copy", path) ? path : null;
        }
        catch (JSException)
        {
            _copied = null;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Bench.Changed -= OnChanged;
        }

        base.Dispose(disposing);
    }
}
