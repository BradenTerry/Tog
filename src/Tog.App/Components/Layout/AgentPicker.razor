@inherits StateComponent
@inject AgentDirectory Directory
@inject Workbench Bench
@inject NavigationManager Nav
@inject WorktreeInventory Inventory
@inject WorktreeViews Views
@inject Shortcuts Keys
@inject IJSRuntime Js

@* The agent in view, in the title bar beside the counts. A click lists every
   agent, like a messaging app's list of conversations, with New agent at the
   top; picking one moves every panel to it. It used to be a column down the
   right of the bottom panel, which cost the conversation a third of its width
   to show a list you look at only when switching. Delete on an agent in the
   list, or the bin that shows on the row under the pointer, asks to remove its
   worktree, through the same dialog as Remove. Left
   and Right step through the status filters above the list, so with a dozen
   agents the waiting or stopped ones are one key away. An agent that finished
   a turn you have not had on screen carries a blue dot, like an unread message:
   waiting agents need an answer, these need a look. *@

@{
    var targets = Targets;
    var agent = IsAtAgent ? targets.FirstOrDefault(t => t.SessionId == Bench.SessionId) : null;
}
<button type="button" class="agent-pick @(_menu is not null ? "open" : "")" @onclick="Toggle" @ref="_button"
        aria-haspopup="menu" aria-expanded="@(_menu is not null ? "true" : "false")"
        title="@(agent is null ? Keys.Title("Pick an agent, or start one", Commands.SelectAgent) : $"{agent.Label} ({agent.Where}, {AgentDirectory.StateWord(agent)})\n{Keys.Title("Click to switch agents or start one", Commands.SelectAgent)}")">
    @if (agent is not null)
    {
        <span class="dot @AgentDirectory.DotClass(agent.State)" aria-hidden="true"></span>
        <span class="agent-pick-name @(agent.LabelIsPrompt ? "untitled" : "")">@agent.Label</span>
    }
    else
    {
        <span class="agent-pick-name faint">@(targets.Count == 0 ? "No agents" : "Pick an agent")</span>
    }
    <svg class="where-caret" viewBox="0 0 16 16" width="10" height="10" aria-hidden="true">
        <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
</button>

@if (_menu is { } at)
{
    var inView = Bench.WorktreeInView(Snapshot.Value);
    var shown = targets.Where(t => Matches(t, _filter)).ToList();
    <ContextMenu X="at.X" Y="at.Y" OnClose="() => _menu = null" OnKeyDown="OnMenuKey">
        <div class="agent-menu" @ref="_list">
            <button type="button" class="context-item agent-menu-new" role="menuitem" @onclick="NewAgent">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                New agent
            </button>

            @if (targets.Count > 0)
            {
                <hr class="context-sep" />
                <div class="segmented agent-menu-filters" role="group" aria-label="Show agents that are">
                    @foreach (var filter in Filters)
                    {
                        var on = filter == _filter;
                        <button type="button" class="small @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")"
                                tabindex="-1" title="Left and Right switch filters" @onclick="() => SetFilter(filter)">
                            @FilterWord(filter) <span class="nums">@targets.Count(t => Matches(t, filter))</span>
                        </button>
                    }
                </div>
                @if (shown.Count == 0)
                {
                    <div class="agent-menu-empty faint">No @FilterWord(_filter).ToLowerInvariant() agents</div>
                }
            }

            @foreach (var target in shown)
            {
                var current = target.SessionId == Bench.SessionId && IsAtAgent;
                var open = target.WorktreePath is { } home && home == inView;
                var unread = Bench.IsUnread(target);
                <div class="agent-menu-row">
                <button type="button" class="context-item agent-menu-item @(current ? "current" : "") @(unread ? "unread" : "")" role="menuitemradio"
                        aria-checked="@(current ? "true" : "false")" @onclick="() => GoTo(target)"
                        @onkeydown="e => OnItemKey(e, target)"
                        title="@($"{target.Label} ({target.Where}, {AgentDirectory.StateWord(target)}{(unread ? ", finished and not read yet" : "")})")">
                    <span class="dot @AgentDirectory.DotClass(target.State)" aria-hidden="true"></span>
                    <span class="chat-item-body">
                        <span class="chat-item-top">
                            <span class="chat-item-name @(target.LabelIsPrompt ? "untitled" : "")">@target.Label</span>
                            @* A running clock for an agent that is doing something, or
                               waiting; a fixed time for one that has stopped, since a
                               ticking clock beside it reads as though it were still going. *@
                            <span class="chat-item-time">
                                @(target.State is ChatState.Parked or ChatState.Failed
                                    ? Fmt.At(target.Since, Snapshot.Value.TakenAt)
                                    : Fmt.Duration(Snapshot.Value.TakenAt - target.Since))
                            </span>
                            @if (unread)
                            {
                                <span class="unread-dot" role="img" aria-label="Unread"></span>
                            }
                        </span>
                        @* Marks the agents whose files are the ones open, which with a
                           worktree picked in the title bar need not be the agent picked. *@
                        <span class="chat-item-where @(open ? "in-view" : "")" title="@(open ? "Its worktree is the one open" : null)">
                            @if (open)
                            {
                                <svg viewBox="0 0 16 16" width="11" height="11" aria-label="Worktree open">
                                    <path d="M1.5 4.5v8h11l2-5.5h-11l-2 5.5M1.5 4.5v-1.5h4l1.5 1.5h5v2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round" />
                                </svg>
                            }
                            @target.Where
                        </span>
                        @if (target.BackgroundCount > 0 && target.State is not (ChatState.Parked or ChatState.Failed))
                        {
                            <span class="chat-item-bg">@target.BackgroundCount running in background</span>
                        }
                        @if (target.WaitingFor is { Length: > 0 } question)
                        {
                            <span class="chat-item-snippet waiting">@AgentSession.Shorten(question, 80)</span>
                        }
                        else if (target.LastReply is { Length: > 0 } reply)
                        {
                            <span class="chat-item-snippet">@AgentSession.Shorten(reply, 80)</span>
                        }
                        else if (target.State is ChatState.Parked or ChatState.Failed)
                        {
                            <span class="chat-item-snippet">@AgentDirectory.StateWord(target)</span>
                        }
                    </span>
                </button>
                @* Beside the row rather than in it, since a button cannot hold
                   another, and without context-item so the arrows skip it. *@
                @if (target.WorktreePath is not null)
                {
                    <button type="button" class="icon-btn agent-menu-remove" tabindex="-1" @onclick="() => AskRemove(target)"
                            title="Remove its worktree and branch (Delete)" aria-label="Remove @target.Label">
                        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.3"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2.5 4h11M6 4V2.5h4V4M4 4l.7 9.5h6.6L12 4M6.8 6.5v4.5M9.2 6.5v4.5" />
                        </svg>
                    </button>
                }
                </div>
                @if (Offer(target) is { } offer)
                {
                    <div class="cleanup-offer" role="note">
                        <span class="cleanup-offer-text">
                            @(offer.Merge == MergeState.SquashMerged ? $"{offer.Base} has its changes." : $"Merged into {offer.Base}.")
                            The worktree is clean and holds @Fmt.Bytes(offer.TotalBytes).
                        </span>
                        <button class="small" @onclick="() => AskRemove(target)">Remove...</button>
                        <button class="ghost small" @onclick="() => Keep(target)">Keep</button>
                    </div>
                }
            }
        </div>
    </ContextMenu>
}

@code {
    private IReadOnlyList<ChatTarget> Targets => Directory.Targets(Snapshot.Value);

    private string Relative => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];

    /// <summary>The selection is shown only while an agent's view is the page, not over Settings.</summary>
    private bool IsAtAgent => Relative.Length == 0 || Relative.StartsWith("chat", StringComparison.Ordinal);

    /// <summary>Where the list is open, under the pointer; null while it is shut.</summary>
    private (double X, double Y)? _menu;

    /// <summary>Each agent's state at the last snapshot, to see one stop.</summary>
    private readonly Dictionary<string, ChatState> _was = new(StringComparer.Ordinal);

    private enum Filter { All, Waiting, Working, Idle, Stopped }

    private static readonly Filter[] Filters = Enum.GetValues<Filter>();

    /// <summary>
    /// Kept while the app is open rather than reset each time the list opens:
    /// narrowing to the stopped agents to clear them out is several opens of it.
    /// </summary>
    private Filter _filter;

    /// <summary>Focus has to be put back on an item once the list redraws under a new filter.</summary>
    private bool _refocus;

    private ElementReference _list;

    private static string FilterWord(Filter filter) => filter switch
    {
        Filter.Waiting => "Waiting",
        Filter.Working => "Working",
        Filter.Idle => "Idle",
        Filter.Stopped => "Stopped",
        _ => "All",
    };

    /// <summary>A failed agent is stopped too: it will not do anything more until it is sent a message.</summary>
    private static bool Matches(ChatTarget target, Filter filter) => filter switch
    {
        Filter.Waiting => target.State == ChatState.Waiting,
        Filter.Working => target.State == ChatState.Active,
        Filter.Idle => target.State == ChatState.Idle,
        Filter.Stopped => target.State is ChatState.Parked or ChatState.Failed,
        _ => true,
    };

    private void SetFilter(Filter filter)
    {
        _filter = filter;
        _refocus = true;
    }

    private void OnMenuKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight") || e.CtrlKey || e.AltKey || e.MetaKey || e.ShiftKey)
        {
            return;
        }

        var step = e.Key == "ArrowRight" ? 1 : -1;
        SetFilter(Filters[((int)_filter + step + Filters.Length) % Filters.Length]);
    }

    /// <summary>
    /// The item that had focus may have been filtered out of the list, which
    /// leaves focus on the page and the next key going nowhere.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_refocus || _menu is null)
        {
            return;
        }

        _refocus = false;
        try
        {
            await Js.InvokeVoidAsync("tog.focusMenuItem", _list);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The list closed, or the window went, before it was drawn.
        }
    }

    private void Toggle(MouseEventArgs e) => _menu = _menu is null ? (e.ClientX, e.ClientY) : null;

    private ElementReference _button;

    /// <summary>
    /// Select Agent's key: the list opens under the button rather than at a
    /// pointer, and the menu puts focus on the agent in view, so the arrows
    /// start from there and Enter on it changes nothing.
    /// </summary>
    private void OnPickerRequested() => _ = InvokeAsync(async () =>
    {
        if (_menu is not null)
        {
            _menu = null;
            StateHasChanged();
            return;
        }

        try
        {
            var at = await Js.InvokeAsync<double[]>("tog.anchorBelow", _button);
            _menu = (at[0], at[1]);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            return;
        }

        StateHasChanged();
    });

    private void GoTo(ChatTarget target)
    {
        _menu = null;
        Nav.NavigateTo(Urls.Chat(target.SessionId));
    }

    private void NewAgent()
    {
        _menu = null;
        Bench.OpenNewAgent();
    }

    /// <summary>
    /// The facts behind an offer to remove a stopped agent's worktree: clean,
    /// nothing only here, and merged. A worktree that never had commits is safe
    /// too, but offering to remove it would nag about every agent that answered
    /// a question and changed nothing. Only after an agent has stopped: an
    /// attached one is still using its worktree.
    /// </summary>
    private WorktreeFacts? Offer(ChatTarget target)
    {
        if (target.State != ChatState.Parked || target.WorktreePath is not { } path || Views.For(path).CleanupDismissed)
        {
            return null;
        }

        var place = Place(path);
        if (place is null || place.Value.View.Worktree.IsPrimary)
        {
            return null;
        }

        var facts = Inventory.Facts(path);
        var state = WorktreeCleanup.Classify(place.Value.View.Worktree, facts, place.Value.View.Agents.Count > 0, hostsTog: false);
        return state == CleanupState.SafeToRemove && facts!.Merge is MergeState.Merged or MergeState.SquashMerged ? facts : null;
    }

    private (RepoView Repo, WorktreeView View)? Place(string path)
    {
        foreach (var repo in Snapshot.Repos)
        {
            if (repo.Worktrees.FirstOrDefault(w => w.Worktree.Path == path) is { } view)
            {
                return (repo, view);
            }
        }

        return null;
    }

    /// <summary>
    /// Opens the remove dialog for this worktree over the agent in view, which
    /// stays in view behind it. The dialog is what removes it.
    /// </summary>
    private void AskRemove(ChatTarget target)
    {
        _menu = null;
        if (target.WorktreePath is { } path)
        {
            Bench.AskRemoveWorktree(path);
        }
    }

    /// <summary>
    /// Delete, or Backspace, which is what the Mac's delete key sends, on an
    /// agent asks to remove its worktree and branch. It only opens the remove
    /// dialog, which shows what is there and waits for a confirmation, and says
    /// why when a worktree cannot be removed (the main checkout, the one the
    /// app runs from).
    /// </summary>
    private void OnItemKey(KeyboardEventArgs e, ChatTarget target)
    {
        if (e.Key is "Delete" or "Backspace" && !e.CtrlKey && !e.AltKey && !e.MetaKey && target.WorktreePath is not null)
        {
            AskRemove(target);
        }
    }

    private void Keep(ChatTarget target)
    {
        if (target.WorktreePath is { } path)
        {
            Views.For(path).CleanupDismissed = true;
        }
    }

    /// <summary>
    /// Stopped agents' worktrees are measured once, and again when an agent
    /// stops, since that is when its work is finished. Merges land when you
    /// fetch or pull, which the Worktrees view picks up when it is opened.
    /// </summary>
    private void OnSnapshotForOffers()
    {
        foreach (var target in Directory.Targets(State.Snapshot))
        {
            var stopped = target.State == ChatState.Parked
                          && _was.TryGetValue(target.SessionId, out var before) && before != ChatState.Parked;
            _was[target.SessionId] = target.State;

            if (target.State != ChatState.Parked || target.WorktreePath is not { } path || Place(path) is not { } place)
            {
                continue;
            }

            if (!place.View.Worktree.IsPrimary)
            {
                Inventory.Refresh(place.Repo, place.View.Worktree, stopped ? Remeasure.All : Remeasure.Missing);
            }
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        State.Changed += OnSnapshotForOffers;
        Inventory.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        Directory.Changed += OnChanged;
        Bench.Changed += OnChanged;
        Bench.AgentPickerRequested += OnPickerRequested;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            State.Changed -= OnSnapshotForOffers;
            Inventory.Changed -= OnChanged;
            Nav.LocationChanged -= OnLocationChanged;
            Directory.Changed -= OnChanged;
            Bench.Changed -= OnChanged;
            Bench.AgentPickerRequested -= OnPickerRequested;
        }

        base.Dispose(disposing);
    }
}
