@page "/new"
@inject Workbench Bench
@inject NavigationManager Nav

@* New agent is a dialog now. The address still works: it puts the dialog up
   over the agent that was on screen. *@

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            Nav.NavigateTo(Urls.Chat(Bench.SessionId), replace: true);
            Bench.OpenNewAgent();
        }
    }
}
