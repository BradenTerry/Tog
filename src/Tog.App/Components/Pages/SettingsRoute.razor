@page "/settings"
@inherits StateComponent
@inject Workbench Bench
@inject NavigationManager Nav

@* Settings is a dialog now. The address still works, for the links that say
   "add them in Settings": it opens the dialog over the agent that was on
   screen and goes back to it. *@

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            Bench.OpenSettings();
            Nav.NavigateTo(Urls.Chat(Bench.SessionId), replace: true);
        }
    }
}
