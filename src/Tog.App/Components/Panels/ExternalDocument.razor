@inject WorktreeFiles Files
@inject WorktreeViews Views
@inject Workbench Bench
@inject IJSRuntime Js
@implements IDisposable

@* A file outside the worktree that something asked Tog to show:
   a screenshot, a report, or a file of the user's own such as their Claude
   settings. An image draws as one. Text opens in the editor and saves the way
   a worktree file does, on the user's Save only and refusing to overwrite a
   change made since it was read. Nothing but that Save writes it. *@

@if (ImageTypes.IsImage(Doc.Path))
{
    <ImageDocument AbsolutePath="@(Doc.Path ?? "")" Version="@Doc.Reveal" />
}
else
{
    <div class="doc-file">
        <div class="doc-bar">
            <span class="mono truncate faint" title="@Doc.Path">@Doc.Path</span>
            <span class="spacer"></span>
            @if (ShowsEditor)
            {
                <button class="icon-btn doc-wrap @(_wrap ? "active" : "")" @onclick="ToggleWrap"
                        title="@(_wrap ? "Stop wrapping long lines (Alt+Z)" : "Wrap long lines (Alt+Z)")"
                        aria-label="Word wrap" aria-pressed="@(_wrap.ToString().ToLowerInvariant())">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path d="M2 3.5h12M2 7.5h10a2 2 0 0 1 0 4H8.5M10 9.5l-2 2 2 2M2 11.5h3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            }
            @if (_text?.Editable == true)
            {
                <button class="icon-btn doc-save" disabled="@(!_unsaved || _saving)" @onclick="Save"
                        title="@(_saving ? "Saving..." : _unsaved ? "Save (Ctrl+S)" : "No changes to save")"
                        aria-label="Save">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path d="M2.5 2.5h9l2 2v9h-11zM5 2.5v3.5h5v-3.5M4.5 13.5v-4h7v4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                    </svg>
                </button>
            }
            else
            {
                <span class="chip">read-only</span>
            }
            @if (CanPreview)
            {
                <div class="segmented" role="group" aria-label="View">
                    <button class="small @(_preview ? "" : "on")" aria-pressed="@((!_preview).ToString().ToLowerInvariant())"
                            @onclick="() => SetPreview(false)" title="Show the file as it is written">Code</button>
                    <button class="small @(_preview ? "on" : "")" aria-pressed="@(_preview.ToString().ToLowerInvariant())"
                            @onclick="() => SetPreview(true)" title="Show the file as it reads">Preview</button>
                </div>
            }
            <span class="faint nums">@(_file is { Bytes: > 0 } f ? Fmt.Bytes(f.Bytes) : "")</span>
        </div>

        @if (_conflict)
        {
            <div class="banner doc-banner">
                <div class="inline">
                    <span>The file changed on disk since you opened it.</span>
                    <span class="spacer"></span>
                    <button class="small" @onclick="Reload">Reload from disk</button>
                    <button class="small" @onclick="Overwrite">Overwrite</button>
                </div>
            </div>
        }
        else if (_failure is { Length: > 0 } failure)
        {
            <div class="banner danger doc-banner">@failure</div>
        }

        @if (_file is null)
        {
            <div class="empty"><p>Reading the file...</p></div>
        }
        else if (_file.Error is { Length: > 0 } error)
        {
            <div class="empty"><p>@error</p></div>
        }
        else if (_file.IsBinary)
        {
            <div class="empty"><p>Binary file, not shown.</p></div>
        }
        else if (_text?.Editable == true)
        {
            @if (_preview && CanPreview)
            {
                <div class="doc-scroll">
                    <div class="md-preview" @ref="_previewElement">@((MarkupString)_previewHtml)</div>
                </div>
            }

            @* Hidden rather than removed while previewing, so the editor keeps its
               undo history and anything not yet saved. No worktree, so no code
               intelligence: its providers answer for a worktree's own files. *@
            <div class="doc-editor" style="@(_preview && CanPreview ? "display: none;" : "")">
                <CodeEditor @ref="_editor"
                            Path="@System.IO.Path.GetFileName(Doc.Path!)"
                            AbsolutePath="@(Doc.Path ?? string.Empty)"
                            WorktreePath=""
                            Text="@_text.Text"
                            Stamp="@_stamp"
                            Line="@Doc.Line"
                            RevealKey="@Doc.Reveal"
                            OnSave="SaveText"
                            OnDirtyChanged="SetUnsaved"
                            OnTextChanged="PushText"
                            OnWordWrapChanged="SetWrap" />
            </div>
        }
        else if (_preview && CanPreview)
        {
            <div class="doc-scroll">
                <div class="md-preview" @ref="_previewElement">@((MarkupString)_previewHtml)</div>
            </div>
        }
        else
        {
            <div class="doc-scroll">
                @if (_file.Truncated)
                {
                    <div class="row faint">Large file: showing the first part of it.</div>
                }
                <div class="diff-lines file-lines">
                    @for (var i = 0; i < _file.Lines.Count; i++)
                    {
                        <div class="diff-line">
                            <span class="ln-static">@(i + 1)</span>
                            <span class="code">@_file.Lines[i]</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public EditorDoc Doc { get; set; } = default!;

    /// <summary>The worktree whose tabs this is among, where a link in the preview opens.</summary>
    [Parameter, EditorRequired]
    public string WorktreePath { get; set; } = "";

    private FileContent? _file;

    /// <summary>The file as the editor has it, when it can be edited: text, not too large, readable.</summary>
    private TextFile? _text;

    private CodeEditor? _editor;
    private string _stamp = "";
    private bool _unsaved;

    /// <summary>Whether the editor wraps long lines, as it last reported.</summary>
    private bool _wrap;
    private bool _saving;
    private bool _conflict;
    private string? _failure;

    /// <summary>The unsaved text, for the Markdown preview to show as it is being written.</summary>
    private string? _live;
    private int _readAt = -1;

    /// <summary>
    /// Markdown shows as it reads, the same switch as a worktree file's and the
    /// same remembered choice, since an agent handing over a report or a plan
    /// usually means it to be read rather than looked at as source.
    /// </summary>
    private bool _preview;
    private string _previewHtml = "";
    private ElementReference _previewElement;
    private bool _enhance;
    private DotNetObjectReference<ExternalDocument>? _self;

    private bool CanPreview =>
        _file is { IsBinary: false, Truncated: false, Error: null } file
        && (file.Path.EndsWith(".md", StringComparison.OrdinalIgnoreCase)
            || file.Path.EndsWith(".markdown", StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Drawn once per request rather than with the layout's every-second
    /// render: a text file here can be thousands of lines.
    /// </summary>
    private bool _render = true;

    protected override bool ShouldRender()
    {
        if (!_render)
        {
            return false;
        }

        _render = false;
        return true;
    }

    protected override void OnParametersSet()
    {
        if (Doc.Reveal == _readAt)
        {
            return;
        }

        _readAt = Doc.Reveal;
        _render = true;

        // Asked for again while there is unsaved work: brought forward, not read
        // again, since reading would throw the work away.
        if (!ImageTypes.IsImage(Doc.Path) && !_unsaved)
        {
            Read();
            _preview = Views.For(WorktreePath).MarkdownPreview;
            if (_preview && CanPreview)
            {
                Render();
            }
        }
    }

    private void Read()
    {
        // Read as a one-file worktree of its own folder: the same size and
        // binary rules as a worktree file, with no second reader to keep level.
        var path = Doc.Path!;
        _file = Files.Read(System.IO.Path.GetDirectoryName(path) ?? "/", System.IO.Path.GetFileName(path));
        _text = Files.ReadTextOutside(path);
        _stamp = _text.Stamp;
        _live = null;
        _conflict = false;
        _failure = null;
    }

    /// <summary>The Monaco editor is on screen, which is when wrapping means anything.</summary>
    private bool ShowsEditor => _file is { IsBinary: false } file && string.IsNullOrEmpty(file.Error) && _text?.Editable == true && !(_preview && CanPreview);

    private void SetWrap(bool on)
    {
        _render = true;
        _wrap = on;
    }

    private async Task ToggleWrap()
    {
        if (_editor is not null)
        {
            await _editor.ToggleWordWrapAsync();
        }
    }

    private void SetUnsaved(bool unsaved)
    {
        _render = true;
        _unsaved = unsaved;
        Bench.SetDirty(WorktreePath, Doc.Key, unsaved);
    }

    private void PushText(string text)
    {
        _live = text;
        if (_preview && CanPreview)
        {
            _render = true;
            Render();
        }
    }

    /// <summary>Ctrl+S, which arrives with the text attached.</summary>
    private void SaveText(string text) => Write(text, force: false);

    /// <summary>The Save button, which has to ask the editor for the text.</summary>
    private async Task Save()
    {
        if (_editor is not null && await _editor.GetTextAsync() is { } text)
        {
            Write(text, force: false);
        }
    }

    private async Task Overwrite()
    {
        if (_editor is not null && await _editor.GetTextAsync() is { } text)
        {
            Write(text, force: true);
        }
    }

    private void Write(string text, bool force)
    {
        if (_text is null)
        {
            return;
        }

        _render = true;
        _saving = true;
        _failure = null;
        var result = Files.WriteOutside(Doc.Path!, text, _stamp, _text.Eol, _text.HasBom, force);
        _saving = false;

        if (result.Ok)
        {
            _stamp = result.Stamp ?? _stamp;
            _text = _text with { Text = text, Stamp = _stamp };
            if (_file is not null)
            {
                _file = _file with { Bytes = System.Text.Encoding.UTF8.GetByteCount(text) };
            }
            _conflict = false;
            SetUnsaved(false);
            return;
        }

        _conflict = result.Conflict;
        _failure = result.Conflict ? null : result.Message;
    }

    private void Reload()
    {
        _render = true;
        Read();
        SetUnsaved(false);
    }

    private void SetPreview(bool preview)
    {
        if (preview == _preview)
        {
            return;
        }

        _render = true;
        _preview = preview;
        Views.For(WorktreePath).MarkdownPreview = preview;
        if (preview)
        {
            Render();
        }
    }

    /// <summary>Rendered by file name alone, so its relative links resolve from its own folder.</summary>
    private void Render()
    {
        _previewHtml = MarkdownRenderer.Render(_live ?? _text?.Text ?? string.Join('\n', _file!.Lines), System.IO.Path.GetFileName(Doc.Path!));
        _enhance = true;
    }

    /// <summary>A link in the preview to a file beside this one, opened read-only the same way.</summary>
    [JSInvokable]
    public Task OpenLinked(string path) => InvokeAsync(() =>
    {
        var folder = System.IO.Path.GetDirectoryName(Doc.Path!) ?? "/";
        var target = System.IO.Path.GetFullPath(path, folder);
        if (File.Exists(target))
        {
            Bench.OpenExternal(WorktreePath, target);
        }
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_enhance && _preview && _previewElement.Id is not null)
        {
            _enhance = false;
            _self ??= DotNetObjectReference.Create(this);
            try
            {
                await Js.InvokeVoidAsync("tog.enhanceMarkdown", _previewElement, _self);
            }
            catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
            {
            }
        }
    }

    public void Dispose() => _self?.Dispose();
}
