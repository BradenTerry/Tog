@inject Workbench Bench
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

@* New agent, as a dialog over the window rather than a page in the editor's
   place: starting an agent is a short errand, and you come back to what you
   were looking at. Escape, the close button, or a click outside it close it,
   and so does going to a page that is not an agent's, such as Settings from
   the link in it. *@

@if (Bench.NewAgentOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal new-agent" role="dialog" aria-modal="true" aria-labelledby="new-agent-title" tabindex="-1"
             @ref="_dialog" @onclick:stopPropagation @onkeydown="OnKey">
            <header class="modal-head">
                <span class="modal-icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="16" height="16">
                        <path d="M8 3.5v9M3.5 8h9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </span>
                <div class="stack" style="flex: 1;">
                    <h2 id="new-agent-title">New agent</h2>
                    <p class="modal-sub">
                        Start Claude in a fresh worktree or an existing one. Repositories are set up in
                        <a href="settings">Settings</a>.
                    </p>
                </div>
                <button type="button" class="icon-btn" @onclick="Close" title="Close" aria-label="Close">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </button>
            </header>

            <div class="modal-body">
                @if (_result is { Ok: false } failed)
                {
                    <div class="banner danger">@failed.Message</div>
                }

                <StartAgentForm @key="Bench.NewAgentGeneration" OnStarted="r => _result = r" OnStartedAgent="Open" />
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _dialog;
    private HostResult? _result;
    private bool _focus;
    private bool _wasOpen;

    protected override void OnInitialized()
    {
        Bench.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        // Opened afresh: the last attempt's failure is not this one's, and the
        // keyboard goes to the prompt, so you can type straight away and Escape
        // still reaches the dialog.
        if (Bench.NewAgentOpen && !_wasOpen)
        {
            _result = null;
            _focus = true;
        }

        _wasOpen = Bench.NewAgentOpen;

        StateHasChanged();
    });

    /// <summary>
    /// Moving between agents leaves the dialog up, which is also how /new puts
    /// it over the agent that was on screen; any other page takes it down.
    /// </summary>
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var page = Nav.ToBaseRelativePath(e.Location).Split('?', '#')[0];
        if (page.Length > 0 && !page.StartsWith("chat", StringComparison.Ordinal))
        {
            _ = InvokeAsync(Bench.CloseNewAgent);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focus && _dialog.Id is not null)
        {
            _focus = false;
            try
            {
                await Js.InvokeVoidAsync("tog.focusDialog", _dialog, "#start-prompt");
            }
            catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
            {
            }
        }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    private void Close() => Bench.CloseNewAgent();

    /// <summary>Opens the agent just started, or resumed, with the dialog done.</summary>
    private void Open(string sessionId)
    {
        Bench.NewAgentStarted(sessionId);
        Bench.CloseNewAgent();
        Nav.NavigateTo(Urls.Chat(sessionId));
    }

    public void Dispose()
    {
        Bench.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
