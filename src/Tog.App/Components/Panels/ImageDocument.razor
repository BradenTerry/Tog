@inject ImageViews Images
@inject Workbench Bench
@implements IDisposable

@* An image open in the editor: a file in the worktree picked in Files, or a
   screenshot an agent asked Tog to show. Fitted to the tab by
   default, since a screenshot is usually bigger than the space it gets, and
   shown at its own size on request. *@

<div class="doc-file">
    <div class="doc-bar">
        <span class="mono truncate faint" title="@AbsolutePath">@(Label ?? AbsolutePath)</span>
        <span class="spacer"></span>
        <div class="segmented" role="group" aria-label="Zoom">
            <button class="small @(_actual ? "" : "on")" aria-pressed="@((!_actual).ToString().ToLowerInvariant())"
                    @onclick="() => _actual = false" title="Shrink the image to fit the tab">Fit</button>
            <button class="small @(_actual ? "on" : "")" aria-pressed="@(_actual.ToString().ToLowerInvariant())"
                    @onclick="() => _actual = true" title="Show the image at its own size">Actual size</button>
        </div>
        <span class="faint nums">@_size</span>
    </div>

    @if (_url is null)
    {
        <div class="empty"><p>That file is no longer there.</p></div>
    }
    else
    {
        <div class="image-view @(_actual ? "actual" : "fit")">
            <img src="@_url" alt="@System.IO.Path.GetFileName(AbsolutePath)" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string AbsolutePath { get; set; } = "";

    /// <summary>What the bar calls the file: its worktree path, when it has one.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>The worktree the file is in, when it is in one, so an edit on disk shows.</summary>
    [Parameter]
    public string? WorktreePath { get; set; }

    /// <summary>Bumped when the file is asked for again, to read it again.</summary>
    [Parameter]
    public int Version { get; set; }

    private string? _url;
    private string _size = "";
    private bool _actual;
    private string? _shownPath;
    private int _shownVersion = -1;

    protected override void OnInitialized() => Bench.FilesChanged += OnFilesChanged;

    protected override void OnParametersSet()
    {
        if (AbsolutePath != _shownPath || Version != _shownVersion)
        {
            _shownPath = AbsolutePath;
            _shownVersion = Version;
            Read();
        }
    }

    private void Read()
    {
        var info = new FileInfo(AbsolutePath);
        _url = info.Exists ? Images.UrlFor(AbsolutePath) : null;
        _size = info.Exists ? Fmt.Bytes(info.Length) : "";
    }

    private void OnFilesChanged(string worktreePath, IReadOnlySet<string> paths)
    {
        if (WorktreePath is { Length: > 0 } root
            && string.Equals(worktreePath, root, StringComparison.Ordinal)
            && paths.Contains(Label ?? ""))
        {
            Read();
            StateHasChanged();
        }
    }

    public void Dispose() => Bench.FilesChanged -= OnFilesChanged;
}
