@using Tog.Core.Secrets
@using Tog.App.Components.Shared
@inject SecretBroker Secrets
@implements IDisposable

@* An extension calling for a secret its manifest declares, with no binding
   for this build yet. You answer by choosing which of your secrets it gets,
   or adding one, and that binding covers everything the need declares. The
   call waits in the extension until this is answered, in whichever window you
   answer it. Allow and Don't allow are kept for this build of the extension;
   Settings, Secrets changes or forgets either. Not now, and Escape, keep
   nothing: the extension hears null and asks again next time. *@

@if (Secrets.Pending.FirstOrDefault() is { } request)
{
    if (request != _shown)
    {
        // Answered elsewhere, or a new one: what was chosen was for the last.
        _shown = request;
        _choice = DefaultChoice(request);
        _newName = request.Name;
        _value = "";
        _error = null;
    }

    var need = request.Need;
    var adding = _choice == NewSecret;
    <div class="modal-backdrop">
        <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="secret-request-title"
             aria-describedby="secret-request-body" tabindex="-1" @onkeydown="e => OnKey(e, request)">
            <header class="modal-head">
                <h2 id="secret-request-title">
                    @request.Caller.ExtensionName needs a secret it calls <span class="mono">@need.Name</span>
                </h2>
            </header>

            <div id="secret-request-body" class="wt-dialog-body">
                @if (need.Purpose is { Length: > 0 } purpose)
                {
                    <p>Its extension.json says: <q>@purpose</q></p>
                }
                @if (need.Read)
                {
                    <p>The extension is handed the value, and can send it anywhere once it has it.</p>
                }
                else
                {
                    <p>
                        Tog adds it to the extension's https requests to
                        <span class="mono">@string.Join(", ", need.Hosts)</span> and gives the extension the
                        responses. The extension never holds it, though a host that echoes headers back would show
                        it one. A request to any other host is refused.
                    </p>
                }

                <label class="stack" style="gap: 4px;">
                    <span>Which of your secrets should it get?</span>
                    <Picker AriaLabel="Secret to give it" Value="@_choice" Options="@Choices()"
                            ValueChanged="v => { _choice = v; _error = null; }" />
                </label>
                @if (adding)
                {
                    <div class="inline" style="margin-top: 8px;">
                        <input type="text" autocomplete="off" spellcheck="false" style="max-width: 14em;"
                               aria-label="Name of the new secret" placeholder="name"
                               value="@_newName" @oninput="e => _newName = e.Value?.ToString()?.Trim() ?? string.Empty" />
                        <input type="password" autocomplete="off" spellcheck="false" placeholder="value"
                               aria-label="Value of the new secret"
                               value="@_value" @oninput="e => _value = e.Value?.ToString() ?? string.Empty" />
                    </div>
                }
                <p class="faint">
                    Kept for this build of the extension (<span class="mono">@request.Caller.Hash[..12]</span>);
                    a rebuilt or updated one asks again. This is not a lock: an enabled extension runs inside Tog as you and could reach any secret another way. It keeps an extension that follows the
                    rules to the secrets you meant it to have.
                </p>
                @if (_error is { Length: > 0 })
                {
                    <div class="banner danger">@_error</div>
                }
            </div>

            <div class="wt-dialog-foot">
                @if (Secrets.Pending.Count > 1)
                {
                    <span class="faint spacer">@(Secrets.Pending.Count - 1) more waiting</span>
                }
                <button class="ghost" @onclick="() => Dismiss(request)">Not now</button>
                <button class="ghost" @onclick="() => Refuse(request)" title="Kept for this build. Settings, Secrets forgets it.">Don't allow</button>
                <button class="primary" @onclick="() => Allow(request)"
                        disabled="@(_busy || (adding && (_newName.Length == 0 || _value.Length == 0)))">
                    @(adding ? "Save and allow" : "Allow")
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Not a possible secret name, which starts with a letter or digit.
    private const string NewSecret = "+new";

    private SecretRequest? _shown;
    private string _choice = NewSecret;
    private string _newName = "";
    private string _value = "";
    private string? _error;
    private bool _busy;

    protected override void OnInitialized() => Secrets.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private IReadOnlyList<PickerOption> Choices() =>
    [
        .. Secrets.Secrets.OrderBy(s => s.Name, StringComparer.Ordinal).Select(s => new PickerOption(s.Name, s.Name)),
        new PickerOption(NewSecret, "Add a new secret"),
    ];

    /// <summary>
    /// What it was bound to for an earlier build, so an update is one click;
    /// otherwise your secret of the same name, if you have one.
    /// </summary>
    private string DefaultChoice(SecretRequest request)
    {
        if (Secrets.Binding(request.Caller.ExtensionId, request.Name) is { Secret: { } earlier } && Secrets.Exists(earlier))
        {
            return earlier;
        }

        return Secrets.Exists(request.Name) ? request.Name : NewSecret;
    }

    private async Task Allow(SecretRequest request)
    {
        _busy = true;
        var (secret, value) = _choice == NewSecret ? (_newName, _value) : (_choice, (string?)null);
        if (_choice == NewSecret && Secrets.Exists(secret))
        {
            _error = $"There is already a secret called {secret}. Choose it above, or give the new one another name.";
            _busy = false;
            return;
        }

        // The OS store can take a moment, and on macOS may show its own prompt.
        _error = await Task.Run(() => Secrets.Allow(request, secret, value));
        _busy = false;
        if (_error is null)
        {
            _value = "";
        }
    }

    private void Refuse(SecretRequest request)
    {
        _error = null;
        _value = "";
        Secrets.Refuse(request);
    }

    private void Dismiss(SecretRequest request)
    {
        _error = null;
        _value = "";
        Secrets.Dismiss(request);
    }

    private void OnKey(KeyboardEventArgs e, SecretRequest request)
    {
        if (e.Key == "Escape")
        {
            Dismiss(request);
        }
    }

    public void Dispose() => Secrets.Changed -= OnChanged;
}
