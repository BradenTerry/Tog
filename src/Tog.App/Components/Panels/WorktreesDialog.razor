@inject Workbench Bench
@implements IDisposable

@* Worktrees, as a dialog over the window like Settings rather than a tab in
   the editor: it is every worktree of every repo, so it belongs to none of
   them, and closing it leaves the agent and its files as they were. Escape,
   the close button or a click outside close it. The confirmations inside it
   keep their own Escape from reaching it. *@

@if (Bench.WorktreesOpen)
{
    <div class="modal-backdrop" @onclick="Bench.CloseWorktrees">
        <div class="modal worktrees-dialog" role="dialog" aria-modal="true" aria-labelledby="worktrees-title" tabindex="-1"
             @onclick:stopPropagation @onkeydown="OnKey">
            <header class="modal-head">
                <h2 id="worktrees-title">Worktrees</h2>
                <button type="button" class="icon-btn spacer" @onclick="Bench.CloseWorktrees" title="Close" aria-label="Close">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </button>
            </header>
            <div class="worktrees-dialog-body">
                <WorktreesDocument />
            </div>
        </div>
    </div>
}

@code {
    private bool _wasOpen;

    protected override void OnInitialized() => Bench.Changed += OnChanged;

    /// <summary>
    /// Only redraws when it opens or closes: the view inside redraws itself
    /// with every snapshot, and the workbench changes far more often than that.
    /// </summary>
    private void OnChanged() => _ = InvokeAsync(() =>
    {
        if (Bench.WorktreesOpen != _wasOpen)
        {
            _wasOpen = Bench.WorktreesOpen;
            StateHasChanged();
        }
    });

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Bench.CloseWorktrees();
        }
    }

    public void Dispose() => Bench.Changed -= OnChanged;
}
