@using Tog.App.Extensions

@* One extension overlay. The error boundary keeps a throwing overlay from
   ending the circuit; its message is clickable so Retry can be pressed through
   the layer, which otherwise lets every click through. *@
<CascadingValue Value="Live.Context" IsFixed="true">
    <ErrorBoundary @ref="_boundary">
        <ChildContent>
            <DynamicComponent Type="Live.Overlay.Component" />
        </ChildContent>
        <ErrorContent Context="error">
            <div class="banner danger ext-overlay-error">
                <strong>@Live.Context.Info.Name's overlay failed.</strong>
                <p class="mono muted" style="margin: 5px 0 8px;">@error.Message</p>
                <button class="small" @onclick="() => _boundary?.Recover()">Retry</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public LiveOverlay Live { get; set; } = default!;

    private ErrorBoundary? _boundary;

    // The record is the same one until the extension reloads, and a reload
    // builds a new host, so the parent's renders never need to reach the overlay.
    protected override bool ShouldRender() => false;
}
