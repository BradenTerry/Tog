@* Text with the files it mentions as links into the agent's Files tab, and a
   small one into VS Code. The scan reads the disk, so it is done when the text
   changes rather than on every render. *@
@inject ITextLinker Linker

<span class="file-links">
    @foreach (var run in _runs)
    {
        if (run.Href is { } href)
        {
            <a class="file-link" href="@href" title="Open in the Files tab">@run.Text</a>
            if (run.EditorHref is { } editor)
            {
                <a class="file-link-vscode" href="@editor" title="Open in VS Code" aria-label="Open in VS Code">code</a>
            }
        }
        else
        {
            @run.Text
        }
    }
</span>

@code {
    /// <summary>The text to show.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    /// <summary>The agent whose worktree the paths are relative to.</summary>
    [Parameter, EditorRequired]
    public AgentContext Agent { get; set; } = default!;

    private IReadOnlyList<LinkedRun> _runs = [];
    private (string, string?, string)? _for;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var key = (Text, Agent.Worktree?.Path, Agent.AgentId);
        if (_for == key)
        {
            return;
        }

        _for = key;
        _runs = Agent.Worktree is { } worktree
            ? Linker.Link(Text, worktree.Path, Agent.AgentId)
            : [new LinkedRun(Text)];
    }
}
