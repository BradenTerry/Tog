@inject WorktreeFiles Files
@inject WorktreeViews Views
@inject Workbench Bench
@inject IJSRuntime Js
@implements IDisposable

@* Every file in the agent's worktree, in the left panel. A click opens the file
   in the editor as the preview tab; a double click opens it to stay. *@

<div class="panel-tools">
    <input type="text" placeholder="Filter by path" aria-label="Filter files by path"
           value="@_filter"
           @oninput="e => SetFilter(e.Value?.ToString() ?? string.Empty)" />
    <button class="icon-btn" @onclick="ToggleAll" disabled="@(_files.Count == 0)"
            title="@(AnyOpen ? "Collapse all folders" : "Expand all folders")"
            aria-label="@(AnyOpen ? "Collapse all folders" : "Expand all folders")">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            @if (AnyOpen)
            {
                <path d="M4 6.5 8 3l4 3.5M4 13 8 9.5l4 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            }
            else
            {
                <path d="M4 3 8 6.5 12 3M4 9.5 8 13l4-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            }
        </svg>
    </button>
    <button class="icon-btn" @onclick="Load" disabled="@_loading" title="Refresh" aria-label="Refresh the file list">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M13 8a5 5 0 1 1-1.5-3.55M13 2.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>
</div>

<div class="panel-scroll" @ref="_list">
    @if (_loading && _files.Count == 0)
    {
        <div class="panel-note faint">Listing the worktree...</div>
    }
    else if (_files.Count == 0)
    {
        <div class="panel-note faint">Git reports nothing tracked or untracked here.</div>
    }
    else if (Shown.Count == 0)
    {
        <div class="panel-note faint">Nothing matches that filter.</div>
    }
    else
    {
        <PathTreeView TValue="WorktreeFile"
                      Node="Tree"
                      Collapsed="@(_filter.Length == 0 ? _collapsed : NoneCollapsed)"
                      Selected="@_selected"
                      OnToggle="ToggleDirectory"
                      OnSelect="path => Open(path, keep: false)"
                      OnKeep="path => Open(path, keep: true)">
            <FileRow Context="node">
                <span class="label">@node.Name</span>
                @if (!node.Value!.Tracked)
                {
                    <span class="kind added end" title="Untracked">N</span>
                }
            </FileRow>
        </PathTreeView>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string WorktreePath { get; set; } = "";

    private IReadOnlyList<WorktreeFile> _files = [];

    /// <summary>
    /// Folded directories. The set is the remembered one for this worktree, so
    /// folding and unfolding here is what the next visit finds.
    /// </summary>
    private HashSet<string> _collapsed = new(StringComparer.Ordinal);

    /// <summary>
    /// A filtered tree is small enough to read whole, and folds left in place
    /// would hide the very matches searched for. It is shown unfolded without
    /// touching the remembered folds, so clearing the filter puts them back.
    /// </summary>
    private static readonly HashSet<string> NoneCollapsed = [];

    private RememberedView _view = new();
    private ElementReference _list;
    private string _filter = "";
    private string? _selected;
    private bool _loading;
    private CancellationTokenSource? _load;

    private PathTreeNode<WorktreeFile>? _treeCache;
    private IReadOnlyList<WorktreeFile>? _treeCacheFor;

    /// <summary>
    /// The panel sits in a layout that re-renders every second with the
    /// monitor's snapshot, and nothing here depends on it.
    /// </summary>
    private bool _render = true;

    protected override bool ShouldRender()
    {
        if (!_render)
        {
            return false;
        }

        _render = false;
        return true;
    }

    private void Touch() => _render = true;

    private IReadOnlyList<WorktreeFile> Shown => _filter.Length == 0
        ? _files
        : _files.Where(f => f.Path.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    private PathTreeNode<WorktreeFile> Tree
    {
        get
        {
            var shown = Shown;
            if (!ReferenceEquals(_treeCacheFor, shown))
            {
                _treeCacheFor = shown;
                _treeCache = WorktreeFiles.Tree(shown);
            }

            return _treeCache!;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Listing is a git call, and prerendering throws its result away.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        Bench.Changed += OnBenchChanged;
        Bench.FilesChanged += OnFilesChanged;
        _view = Views.For(WorktreePath);
        if (_view.Collapsed is { } remembered)
        {
            _collapsed = remembered;
        }

        _selected = ActivePath;
        await Load();
    }

    /// <summary>The file in front in the editor, which the tree marks and unfolds to.</summary>
    private string? ActivePath => Bench.Editors(WorktreePath).Active is { Kind: DocKind.File } doc ? doc.Path : null;

    private void OnBenchChanged() => _ = InvokeAsync(() =>
    {
        var active = ActivePath;
        if (active == _selected)
        {
            return;
        }

        _selected = active;
        if (active is not null)
        {
            Reveal(active);
        }

        Touch();
        StateHasChanged();
    });

    /// <summary>
    /// Lists the worktree again when a file appears or goes, which an edit to a
    /// file already listed does not do, so the agent's typing does not relist.
    /// </summary>
    private void OnFilesChanged(string worktreePath, IReadOnlySet<string> paths)
    {
        if (!string.Equals(worktreePath, WorktreePath, StringComparison.Ordinal))
        {
            return;
        }

        var known = _files.Select(f => f.Path).ToHashSet(StringComparer.Ordinal);
        var moved = paths.Any(p => p != ".git"
            && known.Contains(p) != File.Exists(System.IO.Path.Combine(WorktreePath, p)));

        if (moved)
        {
            _ = Load();
        }
    }

    private async Task Load()
    {
        if (_load is not null)
        {
            await _load.CancelAsync();
            _load.Dispose();
        }

        _load = new CancellationTokenSource();
        var token = _load.Token;

        _loading = true;
        Touch();
        StateHasChanged();

        try
        {
            var files = await Files.ListAsync(WorktreePath, token);
            if (!token.IsCancellationRequested)
            {
                _files = files;
                _treeCacheFor = null;

                // The first time the tree is drawn for this worktree, everything
                // starts folded: a repository opened all the way down is a wall.
                if (_view.Collapsed is null)
                {
                    _collapsed.UnionWith(AllDirectories(Tree));
                    _view.Collapsed = _collapsed;
                    if (_selected is not null)
                    {
                        Reveal(_selected);
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            // A relist started by the watcher is not an event handler, so nothing
            // else renders once it lands and the tree would stay stale until a click.
            if (!token.IsCancellationRequested)
            {
                _loading = false;
                Touch();
                StateHasChanged();
            }
        }
    }

    private void Open(string path, bool keep)
    {
        Touch();
        _selected = path;
        Bench.OpenFile(WorktreePath, path, keep: keep);
    }

    private void SetFilter(string value)
    {
        Touch();
        _filter = value;
    }

    /// <summary>Unfolds the directories a file sits in, so the tree shows what is open.</summary>
    private void Reveal(string path)
    {
        var at = path.LastIndexOf('/');
        while (at > 0)
        {
            _collapsed.Remove(path[..at]);
            at = path.LastIndexOf('/', at - 1);
        }
    }

    private void ToggleDirectory(string path)
    {
        Touch();
        if (!_collapsed.Add(path))
        {
            _collapsed.Remove(path);
        }
    }

    private bool AnyOpen => _files.Count > 0 && AllDirectories(Tree).Any(d => !_collapsed.Contains(d));

    private void ToggleAll()
    {
        Touch();
        if (AnyOpen)
        {
            _collapsed.UnionWith(AllDirectories(Tree));
        }
        else
        {
            _collapsed.Clear();
        }
    }

    private static IEnumerable<string> AllDirectories<T>(PathTreeNode<T> node) =>
        node.Children
            .Where(c => !c.IsFile)
            .SelectMany(c => new[] { c.Path }.Concat(AllDirectories(c)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The tree scrolls on its own, and where it was scrolled to is part of
        // where you were.
        if (_list.Id is null)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("togue.keepScroll", _list, "files:" + WorktreePath);
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        Bench.Changed -= OnBenchChanged;
        Bench.FilesChanged -= OnFilesChanged;
        _load?.Cancel();
        _load?.Dispose();
    }
}
