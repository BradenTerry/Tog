@inject SettingsStore Store

<!DOCTYPE html>
<html lang="en" data-theme-choice="@Themes.Resolve(Store.Load().Theme)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Togue</title>
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <script src="theme.js"></script>
    <HeadOutlet @rendermode="Interactive" />
</head>

<body>
    <Routes @rendermode="Interactive" />
    <!-- Shown by blazor.web.js when the circuit ends on an unhandled error. The
         page stays drawn but nothing on it answers any more, which without this
         looks exactly like a freeze. The reload class is Blazor's own hook. -->
    <div id="blazor-error-ui" role="alert">
        This window lost its connection to the app and will not respond until it reloads.
        <a href="" class="reload">Reload</a>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script src="app.js"></script>
    <!-- Register window.agentsTextmate and window.agentsEditor. Monaco itself is
         not fetched until a page creates an editor, so only an open file pays for
         it, and a grammar only when a file in its language is opened. -->
    <script src="textmate.js"></script>
    <script src="monaco.js"></script>
</body>

</html>

@code {
    // The whole app is interactive: every page reacts to the monitor's snapshot,
    // so there is no page that would be better off static. Prerendering stays on
    // so the first paint has content rather than an empty window while the
    // circuit connects; the one page with expensive work in OnInitializedAsync
    // checks RendererInfo.IsInteractive so it does not do it twice.
    private static readonly InteractiveServerRenderMode Interactive = new(prerender: true);
}
