@inject IJSRuntime Js

@* A dropdown in place of a native select. The native one opens the operating
   system's menu, which cannot be styled, cannot carry a second line, and looks
   different on every platform the window runs on.

   Focus stays on the trigger the whole time it is open, and the highlighted
   option is announced through aria-activedescendant, which is how the ARIA
   combobox pattern keeps a screen reader and the keyboard in step without
   moving focus into a list that is about to disappear. The list is fixed to
   the viewport and placed by app.js, so a dialog or a panel that scrolls does
   not clip it. *@

<div class="picker @(_open ? "open" : "") @Class">
    <button type="button" id="@Id" class="picker-trigger" @ref="_trigger"
            role="combobox" aria-haspopup="listbox" aria-controls="@_listId"
            aria-expanded="@(_open ? "true" : "false")"
            aria-label="@AriaLabel"
            aria-activedescendant="@(_open && _active >= 0 ? OptionId(_active) : null)"
            disabled="@Disabled"
            @onclick="OnTrigger"
            @onkeydown="OnKey" @onkeydown:stopPropagation="_open">
        @if (Selected is { } selected)
        {
            <span class="picker-value">
                <span class="picker-label">@selected.Label</span>
                @if (selected.Detail is { Length: > 0 } detail && ShowDetailInTrigger)
                {
                    <span class="picker-detail">@detail</span>
                }
            </span>
        }
        else
        {
            <span class="picker-value picker-placeholder">@Placeholder</span>
        }
        <svg class="picker-chevron" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>

    @if (_open)
    {
        @* Catches the click that closes it, so that click does nothing else. *@
        <div class="picker-scrim" @onclick="Close"></div>
        <div class="picker-list" id="@_listId" role="listbox" aria-label="@AriaLabel" @ref="_list">
            @{ string? group = null; }
            @for (var i = 0; i < Options.Count; i++)
            {
                var index = i;
                var option = Options[i];
                if (option.Group is { } header && header != group)
                {
                    <div class="picker-group" role="presentation">@header</div>
                }
                group = option.Group;
                var chosen = option.Value == Value;
                <div id="@OptionId(index)" role="option" aria-selected="@(chosen ? "true" : "false")"
                     class="picker-option @(index == _active ? "active" : "") @(chosen ? "chosen" : "")"
                     @onmousedown:preventDefault
                     @onclick="() => Choose(index)">
                    <span class="picker-check" aria-hidden="true">
                        @if (chosen)
                        {
                            <svg viewBox="0 0 16 16" width="12" height="12">
                                <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                    </span>
                    <span class="picker-text">
                        <span class="picker-label">@option.Label</span>
                        @if (option.Detail is { Length: > 0 } detail)
                        {
                            <span class="picker-detail">@detail</span>
                        }
                    </span>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<PickerOption> Options { get; set; } = [];

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>The trigger's id, for a label's <c>for</c>.</summary>
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Choose...";

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Whether the chosen option's second line shows in the closed trigger too.</summary>
    [Parameter]
    public bool ShowDetailInTrigger { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private readonly string _listId = "picker-" + Guid.NewGuid().ToString("N")[..10];
    private ElementReference _trigger;
    private ElementReference _list;
    private bool _open;
    private int _active = -1;
    private bool _place;
    private bool _reveal;

    private PickerOption? Selected => Options.FirstOrDefault(o => o.Value == Value);

    private string OptionId(int index) => $"{_listId}-{index}";

    private int SelectedIndex()
    {
        for (var i = 0; i < Options.Count; i++)
        {
            if (Options[i].Value == Value)
            {
                return i;
            }
        }

        return Options.Count > 0 ? 0 : -1;
    }

    private void Open()
    {
        if (Disabled || Options.Count == 0)
        {
            return;
        }

        _open = true;
        _active = SelectedIndex();
        _place = true;
    }

    private void Close()
    {
        _open = false;
        _active = -1;
    }

    /// <summary>
    /// A click on the trigger opens the list, and a second one takes the
    /// highlighted option. Enter and Space arrive here too, as the button's own
    /// click, so the keyboard needs no separate path to choose.
    /// </summary>
    private async Task OnTrigger()
    {
        if (!_open)
        {
            Open();
            return;
        }

        if (_active >= 0)
        {
            await Choose(_active);
        }
        else
        {
            Close();
        }
    }

    private async Task Choose(int index)
    {
        var value = Options[index].Value;
        Close();

        if (value != Value)
        {
            Value = value;
            await ValueChanged.InvokeAsync(value);
        }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (!_open)
        {
            if (e.Key is "ArrowDown" or "ArrowUp")
            {
                Open();
            }

            return;
        }

        switch (e.Key)
        {
            case "Escape":
            case "Tab":
                Close();
                return;
            case "ArrowDown":
                Move(Math.Min(_active + 1, Options.Count - 1));
                return;
            case "ArrowUp":
                Move(Math.Max(_active - 1, 0));
                return;
            case "Home":
            case "PageUp":
                Move(0);
                return;
            case "End":
            case "PageDown":
                Move(Options.Count - 1);
                return;
        }

        // Type-ahead on the first letter, cycling through the matches.
        if (e.Key.Length == 1 && char.IsLetterOrDigit(e.Key[0]))
        {
            for (var step = 1; step <= Options.Count; step++)
            {
                var i = (_active + step) % Options.Count;
                if (Options[i].Label.StartsWith(e.Key, StringComparison.OrdinalIgnoreCase))
                {
                    Move(i);
                    return;
                }
            }
        }
    }

    private void Move(int index)
    {
        _active = index;
        _reveal = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Js.InvokeVoidAsync("togue.bindPicker", _trigger);
            }
            catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
            {
            }
        }

        if (!_open || !(_place || _reveal))
        {
            return;
        }

        var place = _place;
        _place = _reveal = false;

        try
        {
            if (place)
            {
                await Js.InvokeVoidAsync("togue.openPicker", _trigger, _list, _active >= 0 ? OptionId(_active) : null);
            }
            else if (_active >= 0)
            {
                await Js.InvokeVoidAsync("togue.revealOption", OptionId(_active));
            }
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }
}
