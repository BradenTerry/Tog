@using Togue.Extensions
@using DiffSide = Togue.Extensions.DiffSide
@implements IAsyncDisposable
@inject IJSRuntime Js

@* An extension's DiffView: Monaco's diff editor, read-only and as tall as what
   it shows, so a page of them scrolls as one document the way a pull request
   does. Monaco owns everything under the host, so this renders once and only
   pushes changes after that, as CodeEditor does.

   The Monaco diff exists only while the view is near the screen. A review can
   hold hundreds of these, and building an editor for each, with both texts
   sent over the circuit, is what made a large one crawl. Until then the host
   is an empty box of a guessed height; torn down, it keeps the height it had. *@

<div class="diff-view" @ref="_host"></div>

@code {
    [Parameter, EditorRequired]
    public DiffView Source { get; set; } = default!;

    private ElementReference _host;
    private DotNetObjectReference<DiffViewEditor>? _self;
    private int? _handle;
    private int? _watch;
    private bool _rendered;
    private bool _near;
    private bool _failed;
    private bool _settling;
    private bool _disposed;

    private string? _shownOriginal;
    private string? _shownModified;
    private bool? _shownSideBySide;
    private bool? _shownCollapse;
    private IReadOnlyList<DiffMark>? _shownMarks;
    private bool? _shownCommentable;
    private DiffLines? _shownReveal;

    protected override bool ShouldRender() => !_rendered;

    protected override async Task OnParametersSetAsync()
    {
        if (_handle is not null)
        {
            await Sync();
        }
        else if (RevealPending)
        {
            await Settle();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _rendered = true;
        _self = DotNetObjectReference.Create(this);

        try
        {
            _watch = await Js.InvokeAsync<int>("agentsEditor.watchDiffView", _host, _self, new
            {
                sideBySide = Source.SideBySide,
                collapse = Source.CollapseUnchanged,
                estimate = Estimate(),
            });
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException)
        {
        }

        await Settle();
    }

    /// <summary>A Reveal not yet carried out builds the view wherever it is, since it is about to be scrolled to.</summary>
    private bool RevealPending => Source.Reveal is { } reveal && !ReferenceEquals(reveal, _shownReveal);

    private bool Wanted => !_disposed && !_failed && (_near || RevealPending);

    [JSInvokable]
    public Task Near(bool near)
    {
        _near = near;
        return Settle();
    }

    /// <summary>
    /// Builds or tears down the Monaco diff until it matches what is wanted.
    /// Nearness can flip while a build is awaited, so it loops rather than
    /// acting on each call, and only one caller at a time runs it.
    /// </summary>
    private async Task Settle()
    {
        if (_settling || !_rendered)
        {
            return;
        }

        _settling = true;
        try
        {
            while (Wanted != (_handle is not null))
            {
                if (_handle is null)
                {
                    await Mount();
                }
                else
                {
                    await Unmount();
                }
            }
        }
        finally
        {
            _settling = false;
        }
    }

    private async Task Mount()
    {
        try
        {
            var handle = await Js.InvokeAsync<int>("agentsEditor.createDiffView", _host, _self, Settings());
            if (_disposed)
            {
                await Js.InvokeVoidAsync("agentsEditor.disposeDiffView", handle);
                return;
            }

            _handle = handle;
            Shown();

            // The parameters can have moved on while Monaco was loading.
            await Sync();
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException)
        {
            // Monaco could not load, or the circuit went; the host stays empty.
            _failed = true;
        }
    }

    private async Task Unmount()
    {
        var handle = _handle!.Value;
        _handle = null;
        try
        {
            await Js.InvokeVoidAsync("agentsEditor.disposeDiffView", handle);
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException)
        {
            _failed = true;
        }
    }

    /// <summary>
    /// Line counts for the guessed height: each side's length, and roughly how
    /// many lines were added and removed, by matching lines as a bag rather
    /// than working out the diff. Only asked once, before the first build.
    /// </summary>
    private object Estimate()
    {
        var before = Lines(Source.Original);
        var after = Lines(Source.Modified);
        var unmatched = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var line in before)
        {
            unmatched[line] = unmatched.GetValueOrDefault(line) + 1;
        }

        var added = 0;
        foreach (var line in after)
        {
            if (unmatched.GetValueOrDefault(line) is > 0 and var n)
            {
                unmatched[line] = n - 1;
            }
            else
            {
                added++;
            }
        }

        return new { before = before.Length, after = after.Length, added, removed = before.Length - (after.Length - added) };
    }

    private static string[] Lines(string text)
    {
        if (text.Length == 0)
        {
            return [];
        }

        var lines = text.ReplaceLineEndings("\n").Split('\n');
        return text.EndsWith('\n') ? lines[..^1] : lines;
    }

    private object Settings() => new
    {
        path = Source.Path,
        original = Source.Original,
        modified = Source.Modified,
        sideBySide = Source.SideBySide,
        collapse = Source.CollapseUnchanged,
        commentable = Source.OnComment.HasDelegate,
        marks = Source.Marks.Select(m => new { side = Side(m.Lines.Side), start = m.Lines.Start, end = m.Lines.End, tooltip = m.Tooltip }),
    };

    private void Shown()
    {
        _shownOriginal = Source.Original;
        _shownModified = Source.Modified;
        _shownSideBySide = Source.SideBySide;
        _shownCollapse = Source.CollapseUnchanged;
        _shownMarks = Source.Marks;
        _shownCommentable = Source.OnComment.HasDelegate;
    }

    /// <summary>
    /// Only what moved is sent. The extension's view re-renders every second,
    /// and the texts can be large, so an unchanged diff costs nothing to pass
    /// through again.
    /// </summary>
    private async Task Sync()
    {
        if (_handle is not { } handle)
        {
            return;
        }

        try
        {
            if (Source.Original != _shownOriginal || Source.Modified != _shownModified
                || Source.SideBySide != _shownSideBySide || Source.CollapseUnchanged != _shownCollapse
                || Source.OnComment.HasDelegate != _shownCommentable
                || !Source.Marks.SequenceEqual(_shownMarks ?? []))
            {
                var texts = Source.Original != _shownOriginal || Source.Modified != _shownModified;
                var settings = Settings();
                Shown();
                await Js.InvokeVoidAsync("agentsEditor.updateDiffView", handle, settings, texts);
            }

            if (Source.Reveal is { } reveal && !ReferenceEquals(reveal, _shownReveal))
            {
                _shownReveal = reveal;
                await Js.InvokeVoidAsync("agentsEditor.revealDiffView", handle, Side(reveal.Side), reveal.Start, reveal.End);
            }
        }
        catch (Exception e) when (e is JSException or TaskCanceledException or JSDisconnectedException)
        {
        }
    }

    private static string Side(DiffSide side) => side == DiffSide.Original ? "original" : "modified";

    [JSInvokable]
    public Task Comment(string side, int start, int end) =>
        Source.OnComment.InvokeAsync(new DiffLines(side == "original" ? DiffSide.Original : DiffSide.Modified, Math.Min(start, end), Math.Max(start, end)));

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_watch is { } watch)
            {
                await Js.InvokeVoidAsync("agentsEditor.unwatchDiffView", watch);
            }

            if (_handle is { } handle)
            {
                _handle = null;
                await Js.InvokeVoidAsync("agentsEditor.disposeDiffView", handle);
            }
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
        }

        _self?.Dispose();
    }
}
