<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Writes the .deps.json the dashboard loads this extension's own
         dependencies from. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- One fixed folder, which extension.json points at. -->
    <OutputPath>bin/dashboard/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The dashboard copies its API here every time it starts. -->
    <AgentsDashboardSdk Condition="'$(AgentsDashboardSdk)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.agents-dashboard/sdk/1.0</AgentsDashboardSdk>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Compile against the API, never ship it: the dashboard's own copy is the
         one that runs. -->
    <Reference Include="AgentsDashboard.Extensions">
      <HintPath>$(AgentsDashboardSdk)/AgentsDashboard.Extensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Served at /_ext/<id>/ while the extension is loaded. extension.css is
         linked into the page automatically. -->
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
