<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Writes the .deps.json Togue loads this extension's own
         dependencies from. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- One fixed folder, which extension.json points at. -->
    <OutputPath>bin/togue/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Togue copies its API here every time it starts. -->
    <TogueSdk Condition="'$(TogueSdk)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.togue/sdk/1.0</TogueSdk>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Compile against the API, never ship it: Togue's own copy is the
         one that runs. -->
    <Reference Include="Togue.Extensions">
      <HintPath>$(TogueSdk)/Togue.Extensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Served at /_ext/<id>/ while the extension is loaded. extension.css is
         linked into the page automatically. -->
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
